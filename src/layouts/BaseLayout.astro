---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/ui';
import { t, altHref as getAltHref } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  currentPage?: string;
}

const { locale, title, description, currentPage = '' } = Astro.props;
const pageTitle = title || t(locale, 'site.title');
const pageDesc = description || t(locale, 'site.description');
const switchHref = getAltHref(locale, Astro.url.pathname);
const esPath = locale === 'es' ? Astro.url.pathname : switchHref;
const enPath = locale === 'en' ? Astro.url.pathname : switchHref;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FFFFFF">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={`${Astro.site}og-image.png`}>
  <link rel="canonical" href={canonicalUrl.href}>
  <link rel="alternate" hreflang="es" href={`${Astro.site}${esPath.replace(/^\//, '')}`}>
  <link rel="alternate" hreflang="en" href={`${Astro.site}${enPath.replace(/^\//, '')}`}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <slot name="head" />
</head>
<body>
  <Navbar locale={locale} currentPage={currentPage} />
  <main>
    <slot />
  </main>
  <Footer locale={locale} />
</body>
</html>
