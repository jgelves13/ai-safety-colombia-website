---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import type { Locale } from '../i18n/ui';
import { t, altHref as getAltHref } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  currentPage?: string;
  ogImage?: string;
}

const { locale, title, description, currentPage = '', ogImage } = Astro.props;
const pageTitle = title || t(locale, 'site.title');
const pageDesc = description || t(locale, 'site.description');
const switchHref = getAltHref(locale, Astro.url.pathname);
const esPath = locale === 'es' ? Astro.url.pathname : switchHref;
const enPath = locale === 'en' ? Astro.url.pathname : switchHref;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage || '/og/default.png', Astro.site).href;
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FBF6EC">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDesc}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={ogImageUrl}>
  <meta property="og:url" content={canonicalUrl.href}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={ogImageUrl}>
  <link rel="canonical" href={canonicalUrl.href}>
  <link rel="alternate" hreflang="es" href={`${Astro.site}${esPath.replace(/^\//, '')}`}>
  <link rel="alternate" hreflang="en" href={`${Astro.site}${enPath.replace(/^\//, '')}`}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <slot name="head" />
</head>
<body>
  <Navbar locale={locale} currentPage={currentPage} />
  <main>
    <slot />
  </main>
  <Footer locale={locale} />
  <Analytics />
  <SpeedInsights />
</body>
</html>
