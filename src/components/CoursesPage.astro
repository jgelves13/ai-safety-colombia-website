---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';
import PageHero from './PageHero.astro';
import data from '../data/courses.json';

interface Props {
  locale: Locale;
  // When embedded inside another page (e.g. Get Involved) we skip the
  // standalone PageHero and the closing CTA, rendering as a section instead.
  embedded?: boolean;
}

const { locale, embedded = false } = Astro.props;
const es = locale === 'es';

const formBase = localePath(locale, '/grupos/');
const interestHref = (slug?: string) =>
  slug ? `${formBase}?area=${slug}#form-grupos` : `${formBase}#form-grupos`;

// Original line-art glyphs per group (no third-party assets). Stroke is
// inherited via currentColor; each cover animates the glyph and an orbit.
const GLYPHS: Record<string, string> = {
  'future-of-ai':
    '<circle cx="24" cy="27" r="8"/><line x1="6" y1="40" x2="42" y2="40"/><line x1="24" y1="5" x2="24" y2="11"/><line x1="9" y1="12" x2="13" y2="16"/><line x1="39" y1="12" x2="35" y2="16"/>',
  alignment:
    '<circle cx="22" cy="26" r="13"/><circle cx="22" cy="26" r="5"/><line x1="22" y1="26" x2="44" y2="4"/><polyline points="35,5 44,4 43,13"/>',
  'technical-ai-safety':
    '<circle cx="11" cy="14" r="3"/><circle cx="37" cy="11" r="3"/><circle cx="22" cy="35" r="3"/><circle cx="40" cy="33" r="3"/><line x1="13" y1="16" x2="20" y2="32"/><line x1="35" y1="13" x2="24" y2="33"/><line x1="25" y1="35" x2="37" y2="34"/><line x1="14" y1="13" x2="34" y2="11"/>',
  'ai-governance':
    '<line x1="24" y1="7" x2="24" y2="40"/><line x1="11" y1="13" x2="37" y2="13"/><path d="M11 13 L5 27 a6 6 0 0 0 12 0 Z"/><path d="M37 13 L31 27 a6 6 0 0 0 12 0 Z"/><line x1="16" y1="41" x2="32" y2="41"/>',
  'agi-strategy':
    '<circle cx="24" cy="24" r="16"/><polygon points="24,7 28,24 24,41 20,24"/><polygon points="7,24 24,20 41,24 24,28"/>',
  'economics-of-tai':
    '<line x1="7" y1="6" x2="7" y2="42"/><line x1="7" y1="42" x2="44" y2="42"/><polyline points="9,37 19,27 27,32 42,11"/><polyline points="34,11 42,11 42,19"/>',
};
const glyph = (slug: string) => GLYPHS[slug] ?? GLYPHS['future-of-ai'];
---

{!embedded && (
  <PageHero title={t(locale, 'programs.hero.title')} desc={t(locale, 'programs.hero.subtitle')} />
)}

<section class:list={['section', { alt: embedded }]} id={embedded ? 'grupos' : undefined}>
  <div class="container">
    {!embedded && <p class="courses-note">{t(locale, 'programs.bluedotNote')}</p>}

    <div class="courses-grid">
      {data.courses.map((c) => {
        const title = es ? c.titleEs : c.titleEn;
        return (
          <article class="course-card">
            <a
              class="course-cover"
              href={c.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={title}
            >
              <span class="cover-orbit" aria-hidden="true"></span>
              <span class="cover-glow" aria-hidden="true"></span>
              <span class="cover-kicker">{t(locale, 'programs.coverKicker')}</span>
              <svg
                class="cover-glyph"
                viewBox="0 0 48 48"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={glyph(c.slug)}
              />
              <span class="cover-title">{title}</span>
            </a>
            <div class="course-body">
              <p class="course-aud">
                <span class="course-aud-label">{t(locale, 'programs.audienceLabel')}:</span>{' '}
                {es ? c.audienceEs : c.audienceEn}
              </p>
              <p class="course-desc">{es ? c.descEs : c.descEn}</p>
              <div class="course-actions">
                <a class="course-interest" href={interestHref(c.slug)}>
                  {t(locale, 'programs.interestOne')}
                </a>
                <a class="course-details" href={c.url} target="_blank" rel="noopener noreferrer">
                  {t(locale, 'programs.details')}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {!embedded && (
      <div class="courses-any">
        <h2 class="courses-any-title">{t(locale, 'programs.anyTitle')}</h2>
        <p class="courses-any-sub">{t(locale, 'programs.anySub')}</p>
        <a class="btn btn-primary courses-any-cta" href={interestHref()}>
          {t(locale, 'programs.interestAny')}
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .groups-head {
    margin-bottom: 2rem;
  }

  .courses-note {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.75rem;
  }

  .course-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 22px;
    overflow: hidden;
    background: var(--card-surface);
    transition: border-color 0.15s;
  }

  .course-card:hover {
    border-color: var(--text-primary);
  }

  /* ---- Animated cover ---- */
  .course-cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 16 / 9;
    padding: 1.25rem 1.375rem;
    overflow: hidden;
    color: var(--bg-elevated);
    isolation: isolate;
  }

  .course-cover { background: var(--accent-forest); }

  .course-card { --cover-accent: var(--accent-vermillion); }

  .cover-kicker {
    position: relative;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: var(--cover-accent);
  }

  .cover-title {
    position: relative;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--bg-elevated);
    max-width: 80%;
  }

  .cover-glyph {
    position: absolute;
    top: 50%;
    right: 1.25rem;
    width: 78px;
    height: 78px;
    transform: translateY(-50%);
    color: var(--cover-accent);
    z-index: 1;
    animation: cover-float 6s ease-in-out infinite;
  }

  .cover-glow {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    width: 150px;
    height: 150px;
    transform: translateY(-50%);
    background: radial-gradient(circle, var(--cover-accent) 0%, transparent 68%);
    opacity: 0.22;
    z-index: 0;
    animation: cover-pulse 5.5s ease-in-out infinite;
  }

  .cover-orbit {
    position: absolute;
    top: -52px;
    right: -52px;
    width: 168px;
    height: 168px;
    border-radius: 50%;
    border: 2px solid transparent;
    border-top-color: var(--cover-accent);
    border-right-color: var(--cover-accent);
    opacity: 0.4;
    z-index: 0;
    animation: cover-spin 26s linear infinite;
  }

  @keyframes cover-float {
    0%, 100% { transform: translateY(-50%); }
    50%      { transform: translateY(calc(-50% - 7px)); }
  }
  @keyframes cover-pulse {
    0%, 100% { opacity: 0.18; transform: translateY(-50%) scale(1); }
    50%      { opacity: 0.32; transform: translateY(-50%) scale(1.08); }
  }
  @keyframes cover-spin {
    to { transform: rotate(360deg); }
  }

  /* ---- Body ---- */
  .course-body {
    padding: 1.25rem 1.375rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .course-aud {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .course-aud-label {
    font-weight: 700;
    color: var(--text-primary);
  }

  .course-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 0.5rem;
  }

  .course-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  /* Action buttons — pills */
  .course-interest,
  .course-details {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: 999px;
    padding: 0.625rem 1.125rem;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }

  .course-interest {
    background: var(--accent-forest);
    color: var(--bg-elevated);
  }

  .course-interest:hover {
    background: var(--accent-forest-deep);
    color: var(--bg-elevated);
  }

  .course-details {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .course-details:hover {
    border-color: var(--text-primary);
    color: var(--text-primary);
  }

  .courses-any {
    margin-top: 3rem;
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 2.75rem 2rem;
    text-align: center;
    background: var(--bg-secondary);
  }

  .courses-any-title {
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .courses-any-sub {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0.625rem auto 1.5rem;
  }

  @media (max-width: 600px) {
    .courses-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-glyph,
    .cover-glow,
    .cover-orbit,
    .course-card,
    .course-interest,
    .course-details {
      animation: none;
      transition: none;
    }
    .course-card:hover,
    .course-interest:hover {
      transform: none;
    }
    .cover-glyph { transform: translateY(-50%); }
    .cover-glow { transform: translateY(-50%); }
  }
</style>
