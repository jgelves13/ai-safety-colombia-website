---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const hackathonDate = new Date('2026-06-19T00:00:00');
const now = new Date();
const daysLeft = Math.max(0, Math.ceil((hackathonDate.getTime() - now.getTime()) / (1000 * 60 * 60 * 24)));
---

<section class="hackathon-banner">
  <div class="container">
    <div class="banner-content">
      <div class="banner-badge">Apart Research</div>
      <h2 class="banner-title">{t(locale, 'hackathon.banner.title')}</h2>
      <p class="banner-subtitle">{t(locale, 'hackathon.banner.subtitle')}</p>
      <div class="banner-actions">
        <a href={locale === 'es' ? '/hackathon/' : '/en/hackathon/'} class="btn btn-primary">
          {t(locale, 'hackathon.banner.cta')}
        </a>
        <div class="countdown">
          <span class="countdown-number" data-hackathon-date="2026-06-19">{daysLeft}</span>
          <span class="countdown-label">{t(locale, 'hackathon.banner.countdown')}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hackathon-banner {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: none;
    border-right: none;
    padding: 2.5rem 0;
    position: relative;
    overflow: hidden;
  }

  .hackathon-banner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gradient);
  }

  .banner-content {
    text-align: center;
  }

  .banner-badge {
    display: inline-block;
    background: rgba(167, 139, 250, 0.15);
    color: var(--accent-purple);
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .banner-title {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .banner-subtitle {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    margin-bottom: 1.25rem;
  }

  .banner-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .countdown {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .countdown-number {
    font-size: 1.75rem;
    font-weight: 800;
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .countdown-label {
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }
</style>

<script>
  function updateCountdown() {
    const el = document.querySelector('[data-hackathon-date]');
    if (!el) return;
    const target = new Date(el.getAttribute('data-hackathon-date') + 'T00:00:00');
    const now = new Date();
    const days = Math.max(0, Math.ceil((target.getTime() - now.getTime()) / (1000 * 60 * 60 * 24)));
    el.textContent = String(days);
  }
  updateCountdown();
</script>
