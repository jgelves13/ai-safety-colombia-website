---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import data from '../data/hackathon.json';
import { daysUntil, deadlineState } from '../utils/countdown.js';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// The countdown sits next to the "Regístrate" CTA, so it must reflect the time
// left to APPLY (deadline), not the event start — otherwise it reads "7 días
// restantes" on the very day applications close. Once the deadline passes we
// fall back to counting down to the event itself.
const ds = deadlineState(data.deadlineDate);
const eventDays = daysUntil(data.date);

const labelOpen = t(locale, 'hackathon.banner.countdown');
const labelToday = t(locale, 'hackathon.banner.closesToday');
const labelEvent = t(locale, 'hackathon.banner.toEvent');

const countNumber = ds.state === 'open' ? ds.days : eventDays;
const countLabel = ds.state === 'open' ? labelOpen : labelEvent;
---

<section class="hackathon-banner">
  <div class="container">
    <div class="banner-card">
      <div class="banner-content">
        <div class="banner-badge">Apart Research</div>
        <h2 class="banner-title">{t(locale, 'hackathon.banner.title')}</h2>
        <p class="banner-subtitle">{t(locale, 'hackathon.banner.subtitle')}</p>
        <div class="banner-actions">
          <a href={locale === 'es' ? '/hackathon/' : '/en/hackathon/'} class="btn btn-vermillion">
            {t(locale, 'hackathon.banner.cta')}
          </a>
          <div
            class="countdown"
            aria-live="polite"
            data-deadline={data.deadlineDate}
            data-event={data.date}
            data-label-open={labelOpen}
            data-label-today={labelToday}
            data-label-event={labelEvent}
          >
            {ds.state === 'today' ? (
              <span class="countdown-today">{labelToday}</span>
            ) : (
              <>
                <span class="countdown-number">{countNumber}</span>
                <span class="countdown-label">{countLabel}</span>
              </>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hackathon-banner {
    /* The navbar is position: sticky, so it already reserves its own
       space in flow — no top offset is needed here. This is just a
       small breathing gap below the navbar. Kept compact so the
       welcoming Hero below it still clears the fold. */
    padding: 1.25rem 0 0;
    position: relative;
    z-index: 1;
  }

  .banner-card {
    background: var(--accent-forest);
    border: none;
    border-radius: 22px;
    padding: 2.25rem 2.75rem;
    color: var(--bg-elevated);
    position: relative;
    overflow: hidden;
  }

  .banner-card::before {
    content: "";
    position: absolute;
    width: 280px;
    height: 280px;
    background: var(--accent-sage);
    opacity: 0.45;
    border-radius: 50%;
    top: -120px;
    right: -80px;
    pointer-events: none;
    z-index: 0;
  }

  .banner-card :where(h2, h3, p, span, a:not(.btn)) {
    color: var(--bg-elevated);
  }

  .banner-content {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .banner-badge {
    display: inline-block;
    background: var(--accent-vermillion);
    color: var(--bg-elevated);
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .banner-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--bg-elevated);
    margin-bottom: 0.5rem;
  }

  .banner-subtitle {
    /* Lighter than --dark-muted: clears WCAG AA (4.5:1) on the forest
       card, where plain --dark-muted only reaches ~4.4:1. */
    color: #C2D0C6;
    font-size: 1rem;
    margin-bottom: 1.25rem;
  }

  .banner-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .countdown {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .countdown-number {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--accent-vermillion);
  }

  .countdown-label {
    font-family: var(--font-mono);
    color: var(--bg-elevated);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .countdown-today {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-vermillion);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>

<script>
  import { daysUntil, deadlineState } from '../utils/countdown.js';
  const box = document.querySelector('.countdown[data-deadline]');
  if (box) {
    const deadline = box.getAttribute('data-deadline');
    const event = box.getAttribute('data-event');
    const labelOpen = box.getAttribute('data-label-open') || '';
    const labelToday = box.getAttribute('data-label-today') || '';
    const labelEvent = box.getAttribute('data-label-event') || '';
    const ds = deadlineState(deadline);
    if (ds.state === 'today') {
      box.innerHTML = `<span class="countdown-today"></span>`;
      box.querySelector('.countdown-today').textContent = labelToday;
    } else {
      const n = ds.state === 'open' ? ds.days : daysUntil(event);
      const label = ds.state === 'open' ? labelOpen : labelEvent;
      box.innerHTML = `<span class="countdown-number"></span> <span class="countdown-label"></span>`;
      box.querySelector('.countdown-number').textContent = String(n);
      box.querySelector('.countdown-label').textContent = label;
    }
  }
</script>
