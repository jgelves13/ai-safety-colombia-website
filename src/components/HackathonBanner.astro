---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import data from '../data/hackathon.json';
import { daysUntil } from '../utils/countdown.js';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const daysLeft = daysUntil(data.date);
---

<section class="hackathon-banner">
  <div class="container">
    <div class="banner-card">
      <div class="banner-content">
        <div class="banner-badge">Apart Research</div>
        <h2 class="banner-title">{t(locale, 'hackathon.banner.title')}</h2>
        <p class="banner-subtitle">{t(locale, 'hackathon.banner.subtitle')}</p>
        <div class="banner-actions">
          <a href={locale === 'es' ? '/hackathon/' : '/en/hackathon/'} class="btn btn-vermillion">
            {t(locale, 'hackathon.banner.cta')} &rarr;
          </a>
          <div class="countdown">
            <span class="countdown-number" data-hackathon-date={data.date} aria-live="polite">{daysLeft}</span>
            <span class="countdown-label">{t(locale, 'hackathon.banner.countdown')}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hackathon-banner {
    padding: 1.5rem 0 0;
    margin-top: 5rem;
  }

  .banner-card {
    background: var(--accent-forest);
    border: none;
    border-radius: 0;
    padding: 2.75rem 2.75rem;
    color: #FFFFFF;
  }

  .banner-card :where(h2, h3, p, span, a:not(.btn)) {
    color: #FFFFFF;
  }

  .banner-content {
    text-align: center;
  }

  .banner-badge {
    display: inline-block;
    background: var(--accent-vermillion);
    color: #FFFFFF;
    padding: 0.375rem 0.875rem;
    border-radius: 0;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    margin-bottom: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .banner-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    margin-bottom: 0.5rem;
  }

  .banner-subtitle {
    color: rgba(255, 255, 255, 0.82);
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  .banner-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .countdown {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .countdown-number {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--accent-vermillion);
  }

  .countdown-label {
    font-family: var(--font-mono);
    color: #FFFFFF;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
</style>

<script>
  import { daysUntil } from '../utils/countdown.js';
  const el = document.querySelector('[data-hackathon-date]');
  const date = el && el.getAttribute('data-hackathon-date');
  if (el && date) {
    el.textContent = String(daysUntil(date));
  }
</script>
