---
import type { Locale } from '../i18n/ui';
import data from '../data/hackathon.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

const copy = {
  heroTitle: es ? 'Aplica al hub Bogotá' : 'Apply to the Bogotá hub',
  heroDesc: es
    ? 'Hackathon presencial en Bogotá del 19 al 21 de junio de 2026. Aplica antes del 12 de junio a las 23:59 (hora Colombia).'
    : 'In-person hackathon in Bogotá, June 19–21, 2026. Apply by June 12 at 23:59 (Colombia time).',
  onlineNote: es ? '¿Vas a participar en línea?' : 'Joining online?',
  onlineLink: es ? 'Aplica directamente con Apart Research →' : 'Apply directly with Apart Research →',
  sectionBasics: es ? 'Datos básicos' : 'Basic information',
  sectionTrajectory: es ? 'Tu trayectoria' : 'Your background',
  sectionHub: es ? 'Para la selección del hub' : 'For hub selection',
  fieldFirstName: es ? 'Nombre' : 'First name',
  fieldLastName: es ? 'Apellido' : 'Last name',
  fieldEmail: 'Email',
  fieldLocation: es ? 'Ubicación (ciudad, país)' : 'Location (city, country)',
  fieldLinkedIn: es ? 'LinkedIn (URL)' : 'LinkedIn (URL)',
  fieldLinkedInHelp: es ? 'Opcional' : 'Optional',
  fieldScholar: es ? 'Google Scholar (URL)' : 'Google Scholar (URL)',
  fieldScholarHelp: es ? 'Opcional, si tienes perfil de investigación' : 'Optional, if you have a research profile',
  fieldCareer: es ? 'Ocupación actual' : 'Current occupation',
  fieldCareerHelp: es ? 'Estudias, trabajas, investigas? Cuéntanos en una o dos frases.' : 'Are you studying, working, researching? Tell us in one or two sentences.',
  fieldReason: es ? '¿Por qué quieres participar?' : 'Why do you want to participate?',
  fieldReasonHelp: es ? 'Una o dos frases bastan.' : 'One or two sentences is enough.',
  fieldProblem: es ? '¿Qué problema específico de seguridad o gobernanza de IA te gustaría abordar en el hackathon, y cuál sería tu enfoque inicial?' : 'What specific AI safety or governance problem would you like to tackle at the hackathon, and what would be your initial approach?',
  fieldProblemHelp: es ? 'Hasta ~200 palabras. No buscamos una propuesta cerrada, sí ver si te imaginas algo concreto y abordable en un fin de semana.' : 'Up to ~200 words. We do not need a closed proposal, but we want to see if you can imagine something concrete and tractable for a weekend.',
  fieldTrack: es ? 'Track preferido' : 'Preferred track',
  trackTechnical: es ? 'Technical AI Safety (investigación técnica)' : 'Technical AI Safety (technical research)',
  trackSecurity: es ? 'AI Security (red-teaming, evaluaciones, ataques)' : 'AI Security (red-teaming, evals, attacks)',
  trackEither: es ? 'Sin preferencia' : 'No preference',
  fieldDays: es ? '¿Asistirás presencialmente los 3 días?' : 'Will you attend in person all 3 days?',
  daysAll: es ? 'Sí, los 3 días completos' : 'Yes, all 3 full days',
  daysSome: es ? 'Solo algunos bloques' : 'Only some blocks',
  daysUnsure: es ? 'No estoy seguro/a aún' : 'Not sure yet',
  fieldDiet: es ? 'Restricciones alimentarias o de accesibilidad' : 'Dietary or accessibility needs',
  fieldDietHelp: es ? 'Opcional. Nos ayuda a planear las comidas y el espacio.' : 'Optional. Helps us plan meals and the venue.',
  fieldExtra: es ? 'Algo más que quieras compartir' : 'Anything else you would like to share',
  fieldExtraHelp: es ? 'Opcional.' : 'Optional.',
  optional: es ? 'Opcional' : 'Optional',
  required: es ? 'Obligatorio' : 'Required',
  submit: es ? 'Enviar aplicación' : 'Submit application',
  submitting: es ? 'Enviando…' : 'Submitting…',
  successTitle: es ? '¡Recibimos tu aplicación!' : 'We received your application',
  successBody: es
    ? 'Te enviamos una copia de confirmación al email que registraste. La selección del hub se anuncia antes del 15 de junio. Mientras tanto, te invitamos a unirte al grupo de WhatsApp de la comunidad.'
    : 'We sent a confirmation copy to the email you provided. Hub selection is announced before June 15. Meanwhile, you are welcome to join the community WhatsApp group.',
  successCtaWhatsApp: es ? 'Unirme al WhatsApp' : 'Join the WhatsApp',
  successCtaHome: es ? 'Volver al hackathon' : 'Back to the hackathon',
  errorTitle: es ? 'Hubo un problema al enviar' : 'There was a problem submitting',
  errorBody: es
    ? 'Tu aplicación no se envió. Por favor, intenta de nuevo en unos minutos o escríbenos directamente.'
    : 'Your application did not go through. Please try again in a few minutes or write to us directly.',
  errorRetry: es ? 'Intentar de nuevo' : 'Try again',
  errorEmailCta: es ? 'Escribir a contacto' : 'Email us',
};
---

<section class="apply-section">
  <div class="apply-shell">
    <header class="apply-hero">
      <h1 class="apply-hero-title">{copy.heroTitle}</h1>
      <p class="apply-hero-desc">{copy.heroDesc}</p>
    </header>

    <p class="apply-online-note">
      {copy.onlineNote}{' '}
      <a href={data.registrationUrl} target="_blank" rel="noopener noreferrer">{copy.onlineLink}</a>
    </p>

    <form id="apply-form" class="apply-form" novalidate>
      <input type="hidden" name="locale" value={locale} />

      <section class="apply-block">
        <h2 class="apply-h2">{copy.sectionBasics}</h2>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldFirstName}<em>*</em></span>
          <input type="text" name="firstName" required autocomplete="given-name" />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldLastName}<em>*</em></span>
          <input type="text" name="lastName" required autocomplete="family-name" />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldEmail}<em>*</em></span>
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldLocation}<em>*</em></span>
          <input type="text" name="location" required autocomplete="address-level2" placeholder={es ? 'Ej: Bogotá, Colombia' : 'Eg: Bogotá, Colombia'} />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldLinkedIn} <small>· {copy.optional}</small></span>
          <input type="url" name="linkedin" inputmode="url" placeholder="https://linkedin.com/in/…" />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldScholar} <small>· {copy.fieldScholarHelp}</small></span>
          <input type="url" name="scholar" inputmode="url" placeholder="https://scholar.google.com/…" />
        </label>
      </section>

      <section class="apply-block">
        <h2 class="apply-h2">{copy.sectionTrajectory}</h2>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldCareer}<em>*</em></span>
          <small class="apply-help">{copy.fieldCareerHelp}</small>
          <textarea name="career" required rows="2" maxlength="500"></textarea>
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldReason}<em>*</em></span>
          <small class="apply-help">{copy.fieldReasonHelp}</small>
          <textarea name="reason" required rows="3" maxlength="800"></textarea>
        </label>
      </section>

      <section class="apply-block">
        <h2 class="apply-h2">{copy.sectionHub}</h2>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldProblem}<em>*</em></span>
          <small class="apply-help">{copy.fieldProblemHelp}</small>
          <textarea name="hubProblem" required rows="6" maxlength="1500"></textarea>
        </label>

        <div class="apply-field">
          <span class="apply-label">{copy.fieldTrack}<em>*</em></span>
          <div class="apply-radio-group">
            <label class="apply-radio">
              <input type="radio" name="hubTrack" value="technical" required />
              <span>{copy.trackTechnical}</span>
            </label>
            <label class="apply-radio">
              <input type="radio" name="hubTrack" value="security" />
              <span>{copy.trackSecurity}</span>
            </label>
            <label class="apply-radio">
              <input type="radio" name="hubTrack" value="either" />
              <span>{copy.trackEither}</span>
            </label>
          </div>
        </div>

        <div class="apply-field">
          <span class="apply-label">{copy.fieldDays}<em>*</em></span>
          <div class="apply-radio-group">
            <label class="apply-radio">
              <input type="radio" name="hubDays" value="all" required />
              <span>{copy.daysAll}</span>
            </label>
            <label class="apply-radio">
              <input type="radio" name="hubDays" value="some" />
              <span>{copy.daysSome}</span>
            </label>
            <label class="apply-radio">
              <input type="radio" name="hubDays" value="unsure" />
              <span>{copy.daysUnsure}</span>
            </label>
          </div>
        </div>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldDiet} <small>· {copy.optional}</small></span>
          <small class="apply-help">{copy.fieldDietHelp}</small>
          <textarea name="hubAccess" rows="2" maxlength="400"></textarea>
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldExtra} <small>· {copy.optional}</small></span>
          <small class="apply-help">{copy.fieldExtraHelp}</small>
          <textarea name="hubExtra" rows="2" maxlength="400"></textarea>
        </label>
      </section>

      <div class="apply-actions">
        <button type="submit" class="apply-submit">
          <span class="apply-submit-default">{copy.submit}</span>
          <span class="apply-submit-loading" aria-hidden="true">{copy.submitting}</span>
        </button>
      </div>

      <p class="apply-error" role="alert" hidden></p>
    </form>

    <div class="apply-success" id="apply-success" hidden>
      <h2>{copy.successTitle}</h2>
      <p>{copy.successBody}</p>
      <div class="apply-success-actions">
        <a class="btn btn-primary" href="https://chat.whatsapp.com/KwE8cciX48TAVhAOHnrLaZ" target="_blank" rel="noopener noreferrer">{copy.successCtaWhatsApp}</a>
        <a class="btn btn-outline" href={es ? '/hackathon/' : '/en/hackathon/'}>{copy.successCtaHome}</a>
      </div>
    </div>

    <div class="apply-error-box" id="apply-error-box" hidden>
      <h2>{copy.errorTitle}</h2>
      <p>{copy.errorBody}</p>
      <div class="apply-success-actions">
        <button type="button" class="btn btn-primary" id="apply-retry">{copy.errorRetry}</button>
        <a class="btn btn-outline" href="mailto:aisafetycolombia@gmail.com">{copy.errorEmailCta}</a>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ locale }}>
  (function () {
    const form = document.getElementById('apply-form');
    const successBox = document.getElementById('apply-success');
    const errorBox = document.getElementById('apply-error-box');
    const errorInline = form.querySelector('.apply-error');
    const submitBtn = form.querySelector('button[type="submit"]');
    const retryBtn = document.getElementById('apply-retry');

    function showError(msg) {
      errorInline.textContent = msg;
      errorInline.hidden = false;
    }
    function clearError() {
      errorInline.textContent = '';
      errorInline.hidden = true;
    }
    function setLoading(loading) {
      submitBtn.disabled = loading;
      submitBtn.classList.toggle('is-loading', loading);
    }
    function showSuccess() {
      form.hidden = true;
      errorBox.hidden = true;
      successBox.hidden = false;
      successBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function showErrorBox() {
      form.hidden = true;
      successBox.hidden = true;
      errorBox.hidden = false;
      errorBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    retryBtn.addEventListener('click', function () {
      errorBox.hidden = true;
      form.hidden = false;
      setLoading(false);
    });

    form.addEventListener('submit', async function (ev) {
      ev.preventDefault();
      clearError();
      if (!form.reportValidity()) return;
      setLoading(true);

      const fd = new FormData(form);
      const payload = Object.fromEntries(fd.entries());

      try {
        const res = await fetch('/api/aplicar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          let detail = '';
          try { detail = (await res.json()).error || ''; } catch (_) {}
          throw new Error(detail || 'Request failed with status ' + res.status);
        }
        showSuccess();
      } catch (err) {
        console.error('apply submit failed', err);
        showErrorBox();
      } finally {
        setLoading(false);
      }
    });
  })();
</script>

<style>
  .apply-section {
    padding: 4rem 1.25rem 6rem;
    background: var(--bg-cream, #FBF6EC);
  }

  .apply-shell {
    max-width: 640px;
    margin: 0 auto;
  }

  /* Inline editorial hero — proportional to the form */
  .apply-hero {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #E6DCC8;
  }

  .apply-hero-title {
    font-family: var(--font-display, 'Bricolage Grotesque', serif);
    font-weight: 700;
    font-size: clamp(2rem, 4.8vw, 2.75rem); /* 32–44px */
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--text-primary, #211A12);
    margin: 0 0 0.75rem;
  }

  .apply-hero-desc {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-secondary, #4A4030);
    margin: 0;
    max-width: 38ch;
  }

  /* Subtle inline note, not a boxed alert */
  .apply-online-note {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary, #4A4030);
    margin: 0 0 3.5rem;
    padding: 0;
    border: none;
    background: none;
  }

  .apply-online-note a {
    color: #E5604D;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .apply-online-note a:hover {
    color: #C84B38;
  }

  /* Form layout — single editorial column */
  .apply-form {
    display: flex;
    flex-direction: column;
    gap: 5rem; /* 80px between sections */
  }

  .apply-block {
    display: flex;
    flex-direction: column;
    gap: 2rem; /* 32px between fields */
  }

  /* Section header: H2 + hairline rule */
  .apply-h2 {
    font-family: var(--font-display, 'Bricolage Grotesque', serif);
    font-weight: 700;
    font-size: clamp(1.625rem, 3.2vw, 2rem); /* 26–32px */
    letter-spacing: -0.015em;
    line-height: 1.15;
    color: var(--text-primary, #211A12);
    margin: 0 0 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #E6DCC8;
  }

  /* Fields */
  .apply-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .apply-label {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-weight: 500;
    font-size: 0.875rem; /* 14px */
    color: var(--text-primary, #211A12);
    line-height: 1.4;
    letter-spacing: 0.005em;
  }

  .apply-label em {
    color: #E5604D;
    font-style: normal;
    font-weight: 500;
    margin-left: 0.2rem;
  }

  .apply-label small {
    color: #8A7F6E;
    font-weight: 400;
    font-size: 0.8125rem; /* 13px */
    letter-spacing: 0;
  }

  .apply-help {
    color: #6B6253;
    font-size: 0.8125rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Underline-only inputs */
  .apply-field input,
  .apply-field textarea {
    font-family: inherit;
    font-size: 1rem; /* 16px */
    color: var(--text-primary, #211A12);
    padding: 0.5rem 0;
    border: none;
    border-bottom: 1px solid #D8C9A8;
    border-radius: 0;
    background: transparent;
    width: 100%;
    line-height: 1.5;
    transition: border-bottom-color 0.15s ease, border-bottom-width 0.15s ease;
    -webkit-appearance: none;
    appearance: none;
  }

  .apply-field textarea {
    resize: vertical;
    min-height: 5rem;
    padding-top: 0.625rem;
  }

  .apply-field input::placeholder,
  .apply-field textarea::placeholder {
    color: #B5A88F;
    font-weight: 400;
  }

  .apply-field input:hover,
  .apply-field textarea:hover {
    border-bottom-color: #A8956F;
  }

  .apply-field input:focus,
  .apply-field textarea:focus {
    outline: none;
    border-bottom: 2px solid #E5604D;
    padding-bottom: calc(0.5rem - 1px);
  }

  .apply-field textarea:focus {
    padding-bottom: calc(0.5rem - 1px);
  }

  /* Minimal radio buttons — no cards */
  .apply-radio-group {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-top: 0.25rem;
  }

  .apply-radio {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    border-radius: 0;
  }

  .apply-radio input[type='radio'] {
    margin-top: 0.25rem;
    width: 1.05rem;
    height: 1.05rem;
    accent-color: #E5604D;
    cursor: pointer;
    flex-shrink: 0;
  }

  .apply-radio span {
    font-size: 0.9375rem; /* 15px */
    color: var(--text-primary, #211A12);
    line-height: 1.45;
  }

  .apply-radio:hover span {
    color: #1F4D32;
  }

  /* Submit button — forest green rectangle, left-aligned */
  .apply-actions {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin-top: 1.5rem; /* 24px above submit (within form gap) */
    padding-top: 0.5rem;
  }

  .apply-submit {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
    color: #FBF6EC;
    background: #1F4D32;
    border: none;
    border-radius: 4px;
    padding: 0.875rem 2rem;
    min-width: 180px;
    cursor: pointer;
    transition: background 0.18s ease, transform 0.18s ease;
    position: relative;
  }

  .apply-submit:hover {
    background: #163A26;
  }

  .apply-submit:active {
    transform: translateY(1px);
  }

  .apply-submit:focus-visible {
    outline: 2px solid #E5604D;
    outline-offset: 3px;
  }

  .apply-submit:disabled {
    opacity: 0.6;
    cursor: progress;
    transform: none;
  }

  .apply-submit-loading { display: none; }
  .apply-submit.is-loading .apply-submit-default { display: none; }
  .apply-submit.is-loading .apply-submit-loading { display: inline; }

  .apply-error {
    color: #C84B38;
    font-size: 0.9375rem;
    margin: 1rem 0 0;
  }

  /* Success / error states */
  .apply-success,
  .apply-error-box {
    text-align: left;
    padding: 0;
    border: none;
    background: none;
  }

  .apply-success h2,
  .apply-error-box h2 {
    font-family: var(--font-display, 'Bricolage Grotesque', serif);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-primary, #211A12);
    margin: 0 0 1.25rem;
  }

  .apply-error-box h2 {
    color: #C84B38;
  }

  .apply-success p,
  .apply-error-box p {
    color: var(--text-secondary, #4A4030);
    font-size: 1.0625rem;
    line-height: 1.55;
    margin: 0 0 2rem;
  }

  .apply-success-actions {
    display: flex;
    justify-content: flex-start;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 600px) {
    .apply-section {
      padding: 2.5rem 1.25rem 4rem;
    }
    .apply-hero {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
    }
    .apply-form {
      gap: 4rem;
    }
    .apply-block {
      gap: 1.75rem;
    }
    .apply-online-note {
      margin-bottom: 2.5rem;
    }
    .apply-submit {
      width: 100%;
      min-width: 0;
    }
  }
</style>
