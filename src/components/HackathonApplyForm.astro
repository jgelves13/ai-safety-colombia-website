---
import type { Locale } from '../i18n/ui';
import data from '../data/hackathon.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

const copy = {
  heroTitle: es ? 'Aplica al hub Bogotá' : 'Apply to the Bogotá hub',
  heroDesc: es
    ? 'Hackathon presencial en Bogotá del 19 al 21 de junio de 2026. Aplica antes del 12 de junio a las 23:59 (hora Colombia).'
    : 'In-person hackathon in Bogotá, June 19–21, 2026. Apply by June 12 at 23:59 (Colombia time).',
  introP1: es
    ? 'Durante los tres días tendrás espacio de trabajo, alimentación, conectividad y mentores en sede. A quienes viajen desde otras ciudades del país les ofrecemos hospedaje y apoyo limitado para viaje, según necesidad y disponibilidad.'
    : 'Across the three days you will have workspace, meals, connectivity, and mentors on site. For participants traveling from other cities in the country, we offer lodging and a limited travel stipend, based on need and availability.',
  introP2: es
    ? 'Solo hay una pregunta de selección: describir el problema que te gustaría abordar en el hackathon.'
    : 'There is only one selection question: describe the problem you would like to tackle at the hackathon.',
  introP3: es
    ? 'Buscamos evidencia de que has pensado de forma concreta sobre el tema, no credenciales. Responde con tu propio razonamiento: no aceptamos aplicaciones generadas por IA. Suele tomar 15–25 minutos. Anunciamos la selección el 15 de junio.'
    : 'We look for evidence that you have thought concretely about the topic, not credentials. Answer in your own voice: we do not accept AI-generated applications. It usually takes 15–25 minutes. We announce the selection on June 15.',
  onlineNote: es ? '¿Prefieres participar en línea?' : 'Prefer to join online?',
  onlineLink: es ? 'Aplica directamente con Apart Research.' : 'Apply directly with Apart Research.',
  sectionBasics: es ? 'Datos básicos' : 'Basic information',
  sectionTrajectory: es ? 'Tu trayectoria' : 'Your background',
  sectionHub: es ? 'Para la selección del hub' : 'For hub selection',
  fieldFirstName: es ? 'Nombre' : 'First name',
  fieldLastName: es ? 'Apellido' : 'Last name',
  fieldEmail: 'Email',
  fieldLocation: es ? 'Ubicación (ciudad, país)' : 'Location (city, country)',
  fieldLinkedIn: es ? 'LinkedIn (URL)' : 'LinkedIn (URL)',
  fieldLinkedInHelp: es ? 'Opcional' : 'Optional',
  fieldScholar: es ? 'Google Scholar (URL)' : 'Google Scholar (URL)',
  fieldScholarHelp: es ? 'Opcional, si tienes perfil de investigación' : 'Optional, if you have a research profile',
  fieldCareer: es ? 'Ocupación actual' : 'Current occupation',
  fieldCareerHelp: es ? '¿Estudias, trabajas, investigas? Cuéntanos en una o dos frases.' : 'Are you studying, working, researching? Tell us in one or two sentences.',
  fieldReason: es ? '¿Por qué quieres participar?' : 'Why do you want to participate?',
  fieldReasonHelp: es ? 'Una o dos frases bastan.' : 'One or two sentences is enough.',
  fieldProblem: es ? '¿Qué problema específico de seguridad o gobernanza de IA te gustaría abordar en el hackathon, y cuál sería tu enfoque inicial?' : 'What specific AI safety or governance problem would you like to tackle at the hackathon, and what would be your initial approach?',
  fieldProblemHelp: es ? 'Hasta ~200 palabras. No buscamos una propuesta cerrada, sí ver si te imaginas algo concreto y abordable en un fin de semana.' : 'Up to ~200 words. We do not need a closed proposal, but we want to see if you can imagine something concrete and tractable for a weekend.',
  fieldTrack: es ? 'Track preferido' : 'Preferred track',
  fieldTrackHelp: es
    ? 'Los retos completos se publican el viernes. Tu preferencia nos ayuda a armar equipos y asignar mentores.'
    : 'Full challenges are released on Friday. Your preference helps us build teams and assign mentors.',
  trackTechnical: es ? 'Technical AI Safety (investigación técnica)' : 'Technical AI Safety (technical research)',
  trackSecurity: es ? 'AI Security (red-teaming, evaluaciones, ataques)' : 'AI Security (red-teaming, evals, attacks)',
  trackResponsible: es ? 'IA Responsable (impactos sociales, sesgos, despliegues responsables)' : 'Responsible AI (social impact, bias, responsible deployment)',
  trackGovernance: es ? 'Gobernanza de IA (política, regulación, estándares)' : 'AI Governance (policy, regulation, standards)',
  trackEither: es ? 'Sin preferencia' : 'No preference',
  fieldTravel: es ? '¿Desde dónde vendrías al hub?' : 'Where would you travel from?',
  fieldTravelHelp: es
    ? 'Nos ayuda a planear hospedaje y apoyo de viaje para participantes de fuera de Bogotá.'
    : 'Helps us plan lodging and travel support for participants from outside Bogotá.',
  travelBogota: es ? 'Vivo en Bogotá o área metropolitana' : 'I live in Bogotá or the metropolitan area',
  travelColombiaSelf: es ? 'Vengo de otra ciudad en Colombia y puedo cubrir mi viaje' : 'Coming from another Colombian city — I can cover my travel',
  travelColombiaHelp: es ? 'Vengo de otra ciudad en Colombia y me sería útil hospedaje o apoyo para viaje' : 'Coming from another Colombian city — lodging or travel support would help',
  travelInternational: es ? 'Vengo de fuera de Colombia' : 'Coming from outside Colombia',
  fieldDiet: es ? 'Restricciones alimentarias o de accesibilidad' : 'Dietary or accessibility needs',
  fieldDietHelp: es ? 'Opcional. Nos ayuda a planear las comidas y el espacio.' : 'Optional. Helps us plan meals and the venue.',
  fieldExtra: es ? 'Algo más que quieras compartir' : 'Anything else you would like to share',
  fieldExtraHelp: es ? 'Opcional.' : 'Optional.',
  optional: es ? 'Opcional' : 'Optional',
  required: es ? 'Obligatorio' : 'Required',
  submit: es ? 'Enviar aplicación' : 'Submit application',
  submitting: es ? 'Enviando…' : 'Submitting…',
  successTitle: es ? '¡Recibimos tu aplicación!' : 'We received your application',
  successBody: es
    ? 'Te enviamos una copia de confirmación al email que registraste. La selección del hub se anuncia el 15 de junio. Mientras tanto, te invitamos a unirte al grupo de WhatsApp de la comunidad.'
    : 'We sent a confirmation copy to the email you provided. Hub selection is announced on June 15. Meanwhile, you are welcome to join the community WhatsApp group.',
  successCtaWhatsApp: es ? 'Unirme al WhatsApp' : 'Join the WhatsApp',
  successCtaHome: es ? 'Volver al hackathon' : 'Back to the hackathon',
  errorTitle: es ? 'Hubo un problema al enviar' : 'There was a problem submitting',
  errorBody: es
    ? 'Tu aplicación no se envió. Por favor, intenta de nuevo en unos minutos o escríbenos directamente.'
    : 'Your application did not go through. Please try again in a few minutes or write to us directly.',
  errorRetry: es ? 'Intentar de nuevo' : 'Try again',
  errorEmailCta: es ? 'Escribir a contacto' : 'Email us',
};
---

<section class="apply-section">
  <span class="apply-shape apply-shape-yellow" aria-hidden="true"></span>
  <span class="apply-shape apply-shape-ring" aria-hidden="true"></span>

  <div class="apply-shell">
    <header class="apply-hero">
      <h1 class="apply-hero-title">{copy.heroTitle}</h1>
      <p class="apply-hero-desc">{copy.heroDesc}</p>
    </header>

    <div class="apply-intro">
      <p>{copy.introP1}</p>
      <p>{copy.introP2}</p>
      <p>{copy.introP3}</p>
      <p class="apply-online-note">
        {copy.onlineNote}{' '}
        <a href={data.registrationUrl} target="_blank" rel="noopener noreferrer">{copy.onlineLink}</a>
      </p>
    </div>

    <form id="apply-form" class="apply-form" novalidate>
      <input type="hidden" name="locale" value={locale} />

      <section class="apply-block">
        <h2 class="apply-h2">{copy.sectionBasics}</h2>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldFirstName}<em>*</em></span>
          <input type="text" name="firstName" required autocomplete="given-name" maxlength="100" />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldLastName}<em>*</em></span>
          <input type="text" name="lastName" required autocomplete="family-name" maxlength="100" />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldEmail}<em>*</em></span>
          <input type="email" name="email" required autocomplete="email" maxlength="200" />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldLocation}<em>*</em></span>
          <input type="text" name="location" required autocomplete="address-level2" maxlength="200" placeholder={es ? 'Ej: Bogotá, Colombia' : 'Eg: Bogotá, Colombia'} />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldLinkedIn} <small>· {copy.optional}</small></span>
          <input type="url" name="linkedin" inputmode="url" maxlength="300" placeholder="https://linkedin.com/in/…" />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldScholar} <small>· {copy.fieldScholarHelp}</small></span>
          <input type="url" name="scholar" inputmode="url" maxlength="300" placeholder="https://scholar.google.com/…" />
        </label>
      </section>

      <section class="apply-block">
        <h2 class="apply-h2">{copy.sectionTrajectory}</h2>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldCareer}<em>*</em></span>
          <small class="apply-help">{copy.fieldCareerHelp}</small>
          <textarea name="career" required rows="2" maxlength="800"></textarea>
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldReason}<em>*</em></span>
          <small class="apply-help">{copy.fieldReasonHelp}</small>
          <textarea name="reason" required rows="3" maxlength="1500"></textarea>
        </label>
      </section>

      <section class="apply-block">
        <h2 class="apply-h2">{copy.sectionHub}</h2>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldProblem}<em>*</em></span>
          <small class="apply-help">{copy.fieldProblemHelp}</small>
          <textarea name="hubProblem" required rows="6" maxlength="1500"></textarea>
        </label>

        <div class="apply-field">
          <span class="apply-label">{copy.fieldTrack}<em>*</em></span>
          <small class="apply-help">{copy.fieldTrackHelp}</small>
          <div class="apply-radio-group">
            <label class="apply-radio">
              <input type="radio" name="hubTrack" value="technical" required />
              <span>{copy.trackTechnical}</span>
            </label>
            <label class="apply-radio">
              <input type="radio" name="hubTrack" value="security" />
              <span>{copy.trackSecurity}</span>
            </label>
            <label class="apply-radio">
              <input type="radio" name="hubTrack" value="responsible" />
              <span>{copy.trackResponsible}</span>
            </label>
            <label class="apply-radio">
              <input type="radio" name="hubTrack" value="governance" />
              <span>{copy.trackGovernance}</span>
            </label>
            <label class="apply-radio">
              <input type="radio" name="hubTrack" value="either" />
              <span>{copy.trackEither}</span>
            </label>
          </div>
        </div>

        <div class="apply-field">
          <span class="apply-label">{copy.fieldTravel}<em>*</em></span>
          <small class="apply-help">{copy.fieldTravelHelp}</small>
          <div class="apply-radio-group">
            <label class="apply-radio">
              <input type="radio" name="hubTravel" value="bogota" required />
              <span>{copy.travelBogota}</span>
            </label>
            <label class="apply-radio">
              <input type="radio" name="hubTravel" value="colombia_self" />
              <span>{copy.travelColombiaSelf}</span>
            </label>
            <label class="apply-radio">
              <input type="radio" name="hubTravel" value="colombia_help" />
              <span>{copy.travelColombiaHelp}</span>
            </label>
            <label class="apply-radio">
              <input type="radio" name="hubTravel" value="international" />
              <span>{copy.travelInternational}</span>
            </label>
          </div>
        </div>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldDiet} <small>· {copy.optional}</small></span>
          <small class="apply-help">{copy.fieldDietHelp}</small>
          <textarea name="hubAccess" rows="2" maxlength="800"></textarea>
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldExtra} <small>· {copy.optional}</small></span>
          <small class="apply-help">{copy.fieldExtraHelp}</small>
          <textarea name="hubExtra" rows="2" maxlength="800"></textarea>
        </label>
      </section>

      <div class="apply-actions">
        <button type="submit" class="btn btn-primary apply-submit">
          <span class="apply-submit-default">{copy.submit}</span>
          <span class="apply-submit-loading" aria-hidden="true">{copy.submitting}</span>
        </button>
      </div>

      <p class="apply-error" role="alert" hidden></p>
    </form>

    <div class="apply-success" id="apply-success" hidden>
      <h2>{copy.successTitle}</h2>
      <p>{copy.successBody}</p>
      <div class="apply-success-actions">
        <a class="btn btn-primary" href="https://chat.whatsapp.com/KwE8cciX48TAVhAOHnrLaZ" target="_blank" rel="noopener noreferrer">{copy.successCtaWhatsApp}</a>
        <a class="btn btn-secondary" href={es ? '/hackathon/' : '/en/hackathon/'}>{copy.successCtaHome}</a>
      </div>
    </div>

    <div class="apply-error-box" id="apply-error-box" hidden>
      <h2>{copy.errorTitle}</h2>
      <p>{copy.errorBody}</p>
      <div class="apply-success-actions">
        <button type="button" class="btn btn-primary" id="apply-retry">{copy.errorRetry}</button>
        <a class="btn btn-secondary" href="mailto:aisafetycolombia@gmail.com">{copy.errorEmailCta}</a>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ locale }}>
  (function () {
    const form = document.getElementById('apply-form');
    const successBox = document.getElementById('apply-success');
    const errorBox = document.getElementById('apply-error-box');
    const errorInline = form.querySelector('.apply-error');
    const submitBtn = form.querySelector('button[type="submit"]');
    const retryBtn = document.getElementById('apply-retry');

    function showError(msg) {
      errorInline.textContent = msg;
      errorInline.hidden = false;
    }
    function clearError() {
      errorInline.textContent = '';
      errorInline.hidden = true;
    }
    function setLoading(loading) {
      submitBtn.disabled = loading;
      submitBtn.classList.toggle('is-loading', loading);
    }
    function showSuccess() {
      form.hidden = true;
      errorBox.hidden = true;
      successBox.hidden = false;
      successBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function showErrorBox() {
      form.hidden = true;
      successBox.hidden = true;
      errorBox.hidden = false;
      errorBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function va(name, props) {
      try {
        if (typeof window !== 'undefined' && typeof window.va === 'function') {
          window.va('event', { name: name, ...(props || {}) });
        }
        if (typeof window !== 'undefined' && typeof window.gtag === 'function') {
          window.gtag('event', name, props || {});
        }
      } catch (_) {}
    }

    let startedTracked = false;
    form.addEventListener(
      'focusin',
      function () {
        if (startedTracked) return;
        startedTracked = true;
        va('apply_started', { locale: locale });
      },
      { once: false }
    );

    retryBtn.addEventListener('click', function () {
      errorBox.hidden = true;
      form.hidden = false;
      setLoading(false);
      va('apply_retry', { locale: locale });
    });

    form.querySelectorAll('textarea[maxlength]').forEach(function (ta) {
      const max = parseInt(ta.getAttribute('maxlength') || '0', 10);
      if (!max) return;
      const counter = document.createElement('small');
      counter.className = 'apply-counter';
      counter.setAttribute('aria-live', 'polite');
      ta.insertAdjacentElement('afterend', counter);
      const update = function () {
        const n = ta.value.length;
        counter.textContent = n + ' / ' + max;
        counter.classList.toggle('is-near', n / max >= 0.9 && n < max);
        counter.classList.toggle('is-at', n >= max);
      };
      ta.addEventListener('input', update);
      update();
    });

    (function setupDraftCapture() {
      const firstNameInput = form.querySelector('input[name="firstName"]');
      const lastNameInput = form.querySelector('input[name="lastName"]');
      const emailInput = form.querySelector('input[name="email"]');
      if (!firstNameInput || !lastNameInput || !emailInput) return;

      const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      const SESSION_KEY = 'aisc-draft-saved';

      function alreadySavedFor(email) {
        try { return sessionStorage.getItem(SESSION_KEY) === email; } catch (_) { return false; }
      }
      function markSaved(email) {
        try { sessionStorage.setItem(SESSION_KEY, email); } catch (_) {}
      }

      function tryCapture() {
        const firstName = (firstNameInput.value || '').trim();
        const lastName = (lastNameInput.value || '').trim();
        const email = (emailInput.value || '').trim().toLowerCase();
        if (!firstName || !lastName || !email) return;
        if (!EMAIL_RE.test(email)) return;
        if (alreadySavedFor(email)) return;
        markSaved(email);

        fetch('/api/aplicar/draft', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ locale: locale, firstName: firstName, lastName: lastName, email: email }),
          keepalive: true,
        }).catch(function () {});

        va('apply_draft_saved', { locale: locale });
      }

      emailInput.addEventListener('blur', tryCapture);
      form.addEventListener('submit', tryCapture, true);
      window.addEventListener('pagehide', tryCapture);
    })();

    form.addEventListener('submit', async function (ev) {
      ev.preventDefault();
      clearError();
      if (!form.reportValidity()) return;
      setLoading(true);

      const fd = new FormData(form);
      const payload = Object.fromEntries(fd.entries());

      try {
        const res = await fetch('/api/aplicar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          let detail = '';
          try { detail = (await res.json()).error || ''; } catch (_) {}
          throw new Error(detail || 'Request failed with status ' + res.status);
        }
        va('apply_submitted', {
          locale: locale,
          hub_track: String(payload.hubTrack || ''),
          hub_travel: String(payload.hubTravel || ''),
        });
        try {
          if (typeof window !== 'undefined' && typeof window.lintrk === 'function') {
            window.lintrk('track');
          }
        } catch (_) {}
        showSuccess();
      } catch (err) {
        console.error('apply submit failed', err);
        va('apply_failed', {
          locale: locale,
          message: String((err && err.message) || 'unknown').slice(0, 120),
        });
        showErrorBox();
      } finally {
        setLoading(false);
      }
    });
  })();
</script>

<style>
  /* Section uses site rhythm + decorative brand anchors */
  .apply-section {
    position: relative;
    overflow: hidden;
    padding: 5rem 1.5rem 7rem;
    background: var(--bg-primary);
  }

  .apply-shape {
    position: absolute;
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
  }

  .apply-shape-yellow {
    width: 280px;
    height: 280px;
    background: var(--accent-yellow);
    top: -110px;
    right: -90px;
  }

  .apply-shape-ring {
    width: 130px;
    height: 130px;
    background: transparent;
    border: 12px solid var(--accent-forest);
    bottom: 8rem;
    left: -55px;
  }

  .apply-shell {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
  }

  /* Editorial hero — proportional to PageHero but scoped to the form */
  .apply-hero {
    margin-bottom: 2.5rem;
  }

  .apply-hero-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 3.75rem); /* 40–60px */
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    margin: 0 0 1rem;
    max-width: 18ch;
  }

  .apply-hero-desc {
    font-family: var(--font-body);
    font-size: 1.0625rem; /* 17px — matches site .page-desc / .section-subtitle */
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Intro — ML4Good-style explanatory block before the fields */
  .apply-intro {
    border-top: 1px solid var(--hairline);
    padding-top: 2.5rem;
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .apply-intro p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  .apply-online-note {
    margin-top: 0.5rem !important;
    font-size: 1rem !important;
    color: var(--text-primary) !important;
  }

  .apply-online-note a {
    color: var(--accent-vermillion);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    font-weight: 500;
  }

  .apply-online-note a:hover {
    color: var(--accent-vermillion-dark);
  }

  /* Form layout — single editorial column */
  .apply-form {
    display: flex;
    flex-direction: column;
    gap: 4.5rem; /* 72px between sections */
  }

  /* [hidden] must beat the flex/grid display rules above */
  [hidden] { display: none !important; }

  .apply-block {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Section header — H2 with hairline rule */
  .apply-h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.875rem, 3.8vw, 2.5rem); /* 30–40px */
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  /* Fields */
  .apply-field {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .apply-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem; /* 16px — matches site body */
    color: var(--text-primary);
    line-height: 1.45;
    letter-spacing: 0;
  }

  .apply-label em {
    color: var(--accent-vermillion);
    font-style: normal;
    font-weight: 500;
    margin-left: 0.2rem;
  }

  .apply-label small {
    color: var(--text-secondary);
    font-weight: 400;
    font-size: 0.9375rem;
    letter-spacing: 0;
  }

  .apply-help {
    color: var(--text-secondary);
    font-size: 0.9375rem; /* 15px */
    line-height: 1.55;
    margin: 0;
  }

  /* Underline-only inputs — quieter than cards, but typographically substantive */
  .apply-field input,
  .apply-field textarea {
    font-family: var(--font-body);
    font-size: 1.0625rem; /* 17px — matches body */
    color: var(--text-primary);
    padding: 0.625rem 0;
    border: none;
    border-bottom: 1.5px solid var(--border);
    border-radius: 0;
    background: transparent;
    width: 100%;
    line-height: 1.5;
    transition: border-bottom-color 0.15s ease, border-bottom-width 0.15s ease;
    -webkit-appearance: none;
    appearance: none;
  }

  .apply-field textarea {
    resize: vertical;
    min-height: 5.5rem;
    padding-top: 0.75rem;
  }

  .apply-field input::placeholder,
  .apply-field textarea::placeholder {
    color: #B5A88F;
    font-weight: 400;
  }

  .apply-field input:hover,
  .apply-field textarea:hover {
    border-bottom-color: var(--text-secondary);
  }

  .apply-field input:focus,
  .apply-field textarea:focus {
    outline: none;
    border-bottom: 2px solid var(--accent-vermillion);
    padding-bottom: calc(0.625rem - 0.5px);
  }

  /* Minimal radios */
  .apply-radio-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.375rem;
