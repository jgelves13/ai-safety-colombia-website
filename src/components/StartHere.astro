---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';
import learnData from '../data/learn.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

type Key = Parameters<typeof t>[1];

const thumbs = import.meta.glob<ImageMetadata>('../assets/learn/*', {
  eager: true,
  import: 'default',
});

const items = learnData.map((i) => ({
  kind: i.kind,
  accent: i.accent,
  title: es ? i.titleEs : i.titleEn,
  source: es ? i.sourceEs : i.sourceEn,
  desc: es ? i.descEs : i.descEn,
  duration: es ? i.durationEs : i.durationEn,
  meta: es ? i.metaEs : i.metaEn,
  url: i.url,
  thumb: thumbs[`../assets/learn/${i.thumb}`],
  thumbFit: i.thumbFit,
  kindLabel: t(locale, `learn.kind.${i.kind}` as Key),
  cta: t(locale, `learn.cta.${i.kind}` as Key),
}));
---

<section class="section start-here" aria-labelledby="start-here-title">
  <div class="container">
    <h2 class="section-title" id="start-here-title">{t(locale, 'learn.title')}</h2>
    <p class="section-subtitle">{t(locale, 'learn.subtitle')}</p>

    <div class="learn-grid">
      {items.map((i) => (
        <article class:list={['learn-card', i.accent]}>
          <div
            class:list={['learn-thumb', i.thumbFit === 'cover' ? 'is-cover' : 'is-mark']}
            aria-hidden="true"
          >
            {i.thumbFit === 'cover' ? (
              <Image
                src={i.thumb}
                alt=""
                widths={[360, 540, 760]}
                sizes="(max-width: 560px) 100vw, 400px"
                format="webp"
                loading="lazy"
                class="learn-img"
              />
            ) : (
              <Image
                src={i.thumb}
                alt=""
                width={84}
                height={84}
                loading="lazy"
                class="learn-mark"
              />
            )}
            <span class="learn-duration">{i.duration}</span>
          </div>
          <div class="learn-body">
            <span class="learn-kind">{i.kindLabel}</span>
            <h3>{i.title}</h3>
            <p class="learn-source">{i.source}</p>
            <p class="learn-desc">{i.desc}</p>
            <p class="learn-meta">{i.meta}</p>
            <a href={i.url} target="_blank" rel="noopener noreferrer" class="learn-link">
              {i.cta}
            </a>
          </div>
        </article>
      ))}
    </div>

    <p class="learn-more">
      <a href={localePath(locale, '/recursos/')} class="learn-more-link">
        {t(locale, 'learn.viewMore')}
      </a>
    </p>
  </div>
</section>

<style>
  .start-here .section-subtitle {
    max-width: none;
    margin-bottom: 2.5rem;
  }

  .learn-more {
    margin-top: 2.5rem;
    text-align: right;
  }

  .learn-more-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-forest);
    padding-bottom: 0.25rem;
    transition: color 0.15s ease;
  }

  .learn-more-link:hover {
    color: var(--accent-forest);
  }

  @media (prefers-reduced-motion: reduce) {
    .learn-more-link { transition: none; }
  }

  .learn-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .learn-card {
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s;
  }

  .learn-card:hover { border-color: var(--text-primary); }

  .learn-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
  }

  /* Cover treatment: the source's own link-preview miniatura fills the
     tile edge to edge. */
  .learn-thumb.is-cover {
    background: #0E0E0E;
  }

  .learn-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Mark treatment: where the source's own miniatura is a portrait
     (e.g. the video's YouTube thumbnail), show the genuine YouTube
     brand mark centred on an accent-tinted field instead. */
  .is-coral .learn-thumb.is-mark { background: rgba(229, 96, 77, 0.12); }
  .is-blue  .learn-thumb.is-mark { background: rgba(74, 132, 102, 0.12); }
  .is-green .learn-thumb.is-mark { background: rgba(31, 77, 50, 0.10); }

  .learn-mark {
    width: 84px;
    height: auto;
  }

  .learn-duration {
    position: absolute;
    left: 0.875rem;
    bottom: 0.875rem;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    color: var(--bg-elevated);
    background: var(--text-primary);
  }

  .learn-body {
    padding: 1.5rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .learn-kind {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
    margin-bottom: 0.625rem;
    font-family: var(--font-mono);
  }

  .learn-card h3 {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    line-height: 1.25;
  }

  .learn-source {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.875rem;
  }

  .learn-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
  }

  .learn-meta {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-top: 1rem;
  }

  .learn-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-forest);
    transition: gap 0.2s;
  }

  .learn-link:hover {
    gap: 0.625rem;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .learn-link { transition: none; }
  }
</style>
