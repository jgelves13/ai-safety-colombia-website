---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';
import { splitEvents } from '../utils/events.js';
import { typeColor } from '../utils/eventTypes.js';
import eventsData from '../data/events.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Curated teaser: the three most recent gatherings (an upcoming event,
// if one exists, surfaces first). The full archive lives on /eventos/.
const { upcoming, past } = splitEvents(eventsData);
const featured = [...upcoming, ...past].slice(0, 3);

const flyers = import.meta.glob<ImageMetadata>('../assets/events/*', {
  eager: true,
  import: 'default',
});

const dateFmt = new Intl.DateTimeFormat(locale === 'es' ? 'es-CO' : 'en-US', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const cards = featured.map((ev) => ({
  typeLabel:
    t(locale, `events.type.${ev.type}` as Parameters<typeof t>[1]) || ev.type,
  color: typeColor(ev.type),
  title: locale === 'es' ? ev.titleEs : ev.titleEn,
  why: locale === 'es' ? ev.whyEs : ev.whyEn,
  date: dateFmt.format(new Date(ev.date + 'T00:00:00-05:00')),
  datetime: ev.date,
  href: ev.instagramUrl,
  flyer: flyers[`../assets/events/${ev.flyer}`],
}));
---

<section class="section alt home-events" aria-labelledby="home-events-title">
  <div class="container">
    <h2 class="section-title" id="home-events-title">{t(locale, 'home.events.title')}</h2>
    <p class="section-subtitle">{t(locale, 'home.events.lead')}</p>

    <div class="he-grid">
      {cards.map((c) => (
        <a class="he-card" href={c.href} target="_blank" rel="noopener noreferrer">
          <div class="he-flyer">
            {c.flyer && (
              <Image
                src={c.flyer}
                alt={c.title}
                widths={[360, 720]}
                sizes="(max-width: 860px) 92vw, 360px"
                format="webp"
                quality={85}
                loading="lazy"
              />
            )}
          </div>
          <div class="he-body">
            <span class="he-meta">
              <span class="he-type" style={`color:${c.color}`}>{c.typeLabel}</span>
              <span class="he-sep" aria-hidden="true">·</span>
              <time class="he-date" datetime={c.datetime}>{c.date}</time>
            </span>
            <h3 class="he-title">{c.title}</h3>
            <p class="he-why">{c.why}</p>
            <span class="he-foot">{t(locale, 'events.viewInstagram')} &rarr;</span>
          </div>
        </a>
      ))}
    </div>

    <a class="btn btn-secondary he-cta" href={localePath(locale, '/eventos/')}>
      {t(locale, 'home.events.cta')}
    </a>
  </div>
</section>

<style>
  .home-events .section-subtitle {
    margin-bottom: 2.5rem;
  }

  .he-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .he-card {
    display: flex;
    flex-direction: column;
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .he-card:hover {
    border-color: var(--accent-forest);
    transform: translateY(-3px);
  }

  /* 1:1 frame: square flyers fill it exactly, the rare portrait flyer
     gets a slim pillarbox (contain) rather than a title-clipping crop */
  .he-flyer {
    aspect-ratio: 1 / 1;
    background: var(--card-surface);
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
  }

  .he-flyer :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .he-card:hover .he-flyer :global(img) {
    transform: scale(1.03);
  }

  .he-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.4rem 1.4rem 1.3rem;
  }

  .he-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    margin-bottom: 0.7rem;
  }

  .he-type {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .he-sep {
    color: var(--border);
  }

  .he-date {
    color: var(--text-secondary);
  }

  .he-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: 0.55rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .he-why {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .he-foot {
    margin-top: auto;
    padding-top: 1.15rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-forest);
  }

  .he-cta {
    margin-top: 2rem;
  }

  @media (max-width: 860px) {
    .he-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .he-card {
      transition: border-color 0.15s;
    }
    .he-card:hover {
      transform: none;
    }
    .he-flyer :global(img),
    .he-card:hover .he-flyer :global(img) {
      transition: none;
      transform: none;
    }
  }
</style>
