---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const claims = [
  {
    accent: 'is-coral',
    title: t(locale, 'aboutai.c1.title'),
    desc: t(locale, 'aboutai.c1.desc'),
    linkText: t(locale, 'aboutai.c1.linkText'),
    href: 'https://epoch.ai/trends',
  },
  {
    accent: 'is-blue',
    title: t(locale, 'aboutai.c2.title'),
    desc: t(locale, 'aboutai.c2.desc'),
    linkText: t(locale, 'aboutai.c2.linkText'),
    href: 'https://internationalaisafetyreport.org/',
  },
  {
    accent: 'is-green',
    title: t(locale, 'aboutai.c3.title'),
    desc: t(locale, 'aboutai.c3.desc'),
    linkText: t(locale, 'aboutai.c3.linkText'),
    href: 'https://80000hours.org/problem-profiles/artificial-intelligence/',
  },
];
---

<section class="section about-ai" aria-labelledby="about-ai-title">
  <div class="container">
    <p class="about-ai-kicker">{t(locale, 'aboutai.kicker')}</p>
    <h2 class="section-title" id="about-ai-title">{t(locale, 'aboutai.title')}</h2>
    <p class="about-ai-lead">{t(locale, 'aboutai.lead')}</p>

    <div class="claims-grid">
      {claims.map((c) => (
        <article class:list={['claim-card', c.accent]}>
          <span class="claim-accent" aria-hidden="true"></span>
          <h3>{c.title}</h3>
          <p>{c.desc}</p>
          <a class="claim-link" href={c.href} target="_blank" rel="noopener noreferrer">
            {c.linkText}
          </a>
        </article>
      ))}
    </div>

    <a href={localePath(locale, '/recursos/')} class="btn btn-secondary about-ai-cta">
      {t(locale, 'aboutai.cta')}
    </a>
  </div>
</section>

<style>
  .about-ai-kicker {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent-vermillion);
    margin-bottom: 0.875rem;
  }

  .about-ai-lead {
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.6;
    margin-top: 0.5rem;
  }

  .claims-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0;
  }

  .claim-card {
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 1.875rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s;
  }

  .claim-card:hover { border-color: var(--text-primary); }

  .claim-accent {
    width: 40px;
    height: 4px;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .is-coral .claim-accent { background: var(--accent-vermillion); }
  .is-blue  .claim-accent { background: var(--accent-sage); }
  .is-green .claim-accent { background: var(--accent-forest); }

  .claim-card h3 {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .claim-card p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  /* "Read more" sits pinned to the card bottom so links align across cards */
  .claim-link {
    margin-top: auto;
    padding-top: 1.25rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-forest);
    letter-spacing: 0.005em;
  }

  .claim-link:hover {
    color: var(--accent-vermillion);
  }

  .about-ai-cta {
    display: inline-flex;
  }
</style>
