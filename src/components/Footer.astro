---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/logo-footer.png" alt="AI Safety Colombia" class="footer-logo" width="750" height="607">
        <p>{t(locale, 'footer.tagline')}</p>
        <a
          href="https://chat.whatsapp.com/KwE8cciX48TAVhAOHnrLaZ"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary footer-cta"
        >{t(locale, 'footer.communityCta')}</a>
      </div>
      <div class="footer-links">
        <h4>{t(locale, 'footer.nav')}</h4>
        <a href={localePath(locale, '/sobre/')}>{t(locale, 'nav.about')}</a>
        <a href={localePath(locale, '/hackathon/')}>{t(locale, 'nav.hackathon')}</a>
        <a href={localePath(locale, '/eventos/')}>{t(locale, 'nav.events')}</a>
        <a href={localePath(locale, '/recursos/')}>{t(locale, 'nav.resources')}</a>
      </div>
      <div class="footer-links">
        <h4>{t(locale, 'footer.community')}</h4>
        <a href={localePath(locale, '/involucrate/')}>{t(locale, 'nav.get-involved')}</a>
        <a href={localePath(locale, '/contacto/')}>{t(locale, 'nav.contact')}</a>
        <a href="https://www.instagram.com/aisafetycolombia/" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="https://chat.whatsapp.com/KwE8cciX48TAVhAOHnrLaZ" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a href="https://www.linkedin.com/company/ai-safety-colombia" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} AI Safety Colombia. {t(locale, 'footer.legal')}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark-bg);
    border-top: 2px solid var(--text-primary);
    padding: 4.5rem 0 2rem;
    margin-top: 4rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
  }

  .footer-brand p {
    color: var(--dark-muted);
    margin-top: 1rem;
    max-width: 320px;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .footer-logo {
    height: 38px;
    width: auto;
  }

  .footer-cta {
    margin-top: 1.75rem;
  }

  .footer-cta {
    background: var(--accent-vermillion);
    color: var(--bg-elevated);
  }

  .footer-cta:hover {
    background: var(--accent-vermillion-dark);
    color: var(--bg-elevated);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-links h4 {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--bg-elevated);
    margin-bottom: 0.75rem;
  }

  .footer-links a {
    font-family: var(--font-display);
    color: var(--dark-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.15s;
  }

  .footer-links a:hover {
    color: var(--accent-vermillion);
    opacity: 1;
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--dark-line);
  }

  .footer-bottom p {
    font-family: var(--font-mono);
    color: var(--dark-muted);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
