---
interface Props {
  title: string;
  desc?: string;
}

const { title, desc } = Astro.props;
---

<header class="page-hero">
  <span class="ph-shape ph-s1" aria-hidden="true"></span>
  <span class="ph-shape ph-s2" aria-hidden="true"></span>
  <div class="container">
    <h1 class="page-title">{title}</h1>
    {desc && <p class="page-desc">{desc}</p>}
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding: 4rem 1.5rem 3.5rem;
    text-align: left;
    border-bottom: 1px solid var(--hairline);
  }

  .page-hero .container {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
  }

  .ph-shape {
    position: absolute;
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
  }

  .ph-s1 {
    width: 240px;
    height: 240px;
    background: var(--accent-yellow);
    top: -80px;
    right: -60px;
  }

  .ph-s2 {
    width: 110px;
    height: 110px;
    background: transparent;
    border: 11px solid var(--accent-forest);
    bottom: -45px;
    right: 150px;
  }

  .page-hero .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.94;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
    max-width: 18ch;
  }

  .page-hero .page-desc {
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .page-hero { padding: 2.5rem 1rem 2.5rem; }
    .ph-s1 { width: 160px; height: 160px; }
    .ph-s2 { display: none; }
  }
</style>
