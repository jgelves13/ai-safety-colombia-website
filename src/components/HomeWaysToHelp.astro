---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';
import data from '../data/getInvolved.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

type Action = { labelEs: string; labelEn: string; ext?: string; path?: string; anchor?: string };

const resolve = (a: Action) => {
  if (a.ext) return { href: a.ext, external: true };
  if (a.anchor) return { href: a.anchor, external: false };
  return { href: localePath(locale, a.path ?? '/'), external: false };
};

const accents = ['is-coral', 'is-blue', 'is-green', 'is-yellow', 'is-coral', 'is-blue'];
---

<section class="section ways-section" aria-labelledby="ways-title">
  <div class="container">
    <p class="ways-kicker">{es ? 'Cómo participar' : 'Get involved'}</p>
    <h2 class="section-title" id="ways-title">{t(locale, 'home.ways.title')}</h2>
    <p class="section-subtitle">{t(locale, 'home.ways.subtitle')}</p>

    <ul class="ways-grid">
      {(data.actions as Action[]).map((a, i) => {
        const { href, external } = resolve(a);
        return (
          <li>
            <a
              class:list={['way-card', accents[i % accents.length]]}
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              <span class="way-accent" aria-hidden="true"></span>
              <h3 class="way-label">{es ? a.labelEs : a.labelEn}</h3>
              <span class="way-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .ways-kicker {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent-vermillion);
    margin-bottom: 0.875rem;
  }

  .ways-section .section-subtitle {
    margin-bottom: 2.5rem;
  }

  .ways-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .way-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 1.875rem 1.875rem 1.625rem;
    min-height: 9rem;
    color: var(--text-primary);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .way-card:hover {
    border-color: var(--text-primary);
    transform: translateY(-2px);
  }

  .way-accent {
    width: 40px;
    height: 4px;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .is-coral .way-accent  { background: var(--accent-vermillion); }
  .is-blue  .way-accent  { background: var(--accent-sage); }
  .is-green .way-accent  { background: var(--accent-forest); }
  .is-yellow .way-accent { background: var(--accent-yellow); }

  .way-label {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text-primary);
    margin: 0;
  }

  .way-arrow {
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: 1.25rem;
    color: var(--accent-forest);
    transition: transform 0.15s ease;
  }

  .way-card:hover .way-arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .way-card,
    .way-card:hover,
    .way-arrow,
    .way-card:hover .way-arrow {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .ways-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .ways-grid { grid-template-columns: 1fr; }
  }
</style>
