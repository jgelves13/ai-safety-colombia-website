---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';
import data from '../data/getInvolved.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

type Action = {
  labelEs: string;
  labelEn: string;
  descEs: string;
  descEn: string;
  metaEs: string;
  metaEn: string;
  accent: string;
  ext?: string;
  path?: string;
  anchor?: string;
};

const resolve = (a: Action) => {
  if (a.ext) return { href: a.ext, external: true };
  if (a.anchor) return { href: a.anchor, external: false };
  return { href: localePath(locale, a.path ?? '/'), external: false };
};
---

<section class="section ways-section" aria-labelledby="ways-title">
  <div class="container">
    <p class="ways-kicker">{es ? 'Cómo participar' : 'Get involved'}</p>
    <h2 class="section-title" id="ways-title">{t(locale, 'home.ways.title')}</h2>
    <p class="section-subtitle">{t(locale, 'home.ways.subtitle')}</p>

    <ol class="ways-list">
      {(data.actions as Action[]).map((a, i) => {
        const { href, external } = resolve(a);
        const num = String(i + 1).padStart(2, '0');
        return (
          <li class:list={['way-row', a.accent]}>
            <span class="way-bar" aria-hidden="true"></span>
            <span class="way-num">{num}</span>
            <div class="way-body">
              <h3 class="way-label">
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  {es ? a.labelEs : a.labelEn}
                </a>
              </h3>
              <p class="way-desc">{es ? a.descEs : a.descEn}</p>
              <span class="way-meta">{es ? a.metaEs : a.metaEn}</span>
            </div>
            <a
              class="way-arrow"
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              aria-label={es ? a.labelEs : a.labelEn}
            >
              &rarr;
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .ways-kicker {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent-vermillion);
    margin-bottom: 0.875rem;
  }

  .ways-section .section-subtitle {
    margin-bottom: 2.75rem;
  }

  .ways-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .way-row {
    display: grid;
    grid-template-columns: 4px 4rem 1fr auto;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .way-row:first-child {
    padding-top: 0.25rem;
  }

  .way-row:last-child {
    border-bottom: 0;
  }

  .way-bar {
    align-self: stretch;
    border-radius: 999px;
  }

  .is-coral .way-bar  { background: var(--accent-vermillion); }
  .is-blue  .way-bar  { background: var(--accent-sage); }
  .is-green .way-bar  { background: var(--accent-forest); }
  .is-yellow .way-bar { background: var(--accent-yellow); }

  .way-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--accent-forest);
    padding-top: 0.55rem;
  }

  .way-body {
    min-width: 0;
  }

  .way-label {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }

  .way-label a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .way-row:hover .way-label a {
    color: var(--accent-forest);
  }

  .way-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
    max-width: 60ch;
    margin: 0 0 0.625rem;
  }

  .way-meta {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .way-arrow {
    align-self: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-forest);
    font-size: 1.25rem;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  .way-row:hover .way-arrow {
    background: var(--accent-forest);
    border-color: var(--accent-forest);
    color: var(--bg-elevated);
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .way-label a,
    .way-arrow,
    .way-row:hover .way-arrow {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .way-row {
      grid-template-columns: 4px 1fr auto;
      gap: 1.125rem;
      padding: 1.5rem 0;
    }

    .way-num {
      display: none;
    }

    .way-label {
      font-size: 1.25rem;
    }

    .way-arrow {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
