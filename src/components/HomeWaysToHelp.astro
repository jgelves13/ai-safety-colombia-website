---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';
import data from '../data/getInvolved.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

type Action = { labelEs: string; labelEn: string; ext?: string; path?: string; anchor?: string };

const resolve = (a: Action) => {
  if (a.ext) return { href: a.ext, external: true };
  if (a.anchor) return { href: a.anchor, external: false };
  return { href: localePath(locale, a.path ?? '/'), external: false };
};
---

<section class="section ways-section" aria-labelledby="ways-title">
  <div class="container">
    <h2 class="section-title" id="ways-title">{t(locale, 'home.ways.title')}</h2>
    <p class="section-subtitle">{t(locale, 'home.ways.subtitle')}</p>

    <div class="ways-grid">
      {data.audiences.map((aud) => (
        <article class={`way-card ${aud.accent}`}>
          <div class="way-bar"></div>
          <div class="way-tx">
            <h3 class="way-title">{es ? aud.titleEs : aud.titleEn}</h3>
            <p class="way-desc">{es ? aud.descEs : aud.descEn}</p>
            <ul class="way-actions">
              {aud.actions.map((a) => {
                const { href, external } = resolve(a as Action);
                return (
                  <li>
                    <a
                      class="way-action"
                      href={href}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                    >
                      <span>{es ? a.labelEs : a.labelEn}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ways-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .way-card {
    display: flex;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 1.75rem;
    background: var(--card-surface);
    transition: border-color 0.15s;
  }

  .way-card:hover {
    border-color: var(--text-primary);
  }

  .way-bar {
    width: 5px;
    flex: none;
    border-radius: 999px;
    background: var(--accent-forest);
  }

  .way-card.is-coral .way-bar { background: var(--accent-vermillion); }
  .way-card.is-blue .way-bar { background: var(--accent-sage); }
  .way-card.is-yellow .way-bar { background: var(--accent-yellow); }

  .way-tx {
    min-width: 0;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .way-title {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .way-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 0.375rem;
  }

  .way-actions {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1rem;
  }

  .way-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: color 0.15s ease, padding-left 0.15s ease;
  }

  .way-action:hover {
    color: var(--accent-forest);
    padding-left: 0.25rem;
  }

  .way-card.is-coral .way-action:hover { color: var(--accent-vermillion); }
  .way-card.is-blue .way-action:hover { color: var(--accent-sage); }
  .way-card.is-yellow .way-action:hover { color: var(--accent-forest-deep); }

  @media (prefers-reduced-motion: reduce) {
    .way-card,
    .way-card:hover,
    .way-action {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .ways-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
