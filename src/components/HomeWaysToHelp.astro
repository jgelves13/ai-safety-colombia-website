---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';
import data from '../data/getInvolved.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

type Action = { labelEs: string; labelEn: string; ext?: string; path?: string; anchor?: string };

const resolve = (a: Action) => {
  if (a.ext) return { href: a.ext, external: true };
  if (a.anchor) return { href: a.anchor, external: false };
  return { href: localePath(locale, a.path ?? '/'), external: false };
};
---

<section class="section ways-section" aria-labelledby="ways-title">
  <div class="container">
    <h2 class="section-title" id="ways-title">{t(locale, 'home.ways.title')}</h2>
    <p class="section-subtitle">{t(locale, 'home.ways.subtitle')}</p>

    <article class="way-card">
      <aside class="way-side" aria-hidden="true">
        <span class="way-side-num">{String(data.actions.length).padStart(2, '0')}</span>
        <span class="way-side-label">{es ? 'Vías' : 'Ways'}</span>
      </aside>

      <ul class="way-actions">
        {(data.actions as Action[]).map((a, i) => {
          const { href, external } = resolve(a);
          const num = String(i + 1).padStart(2, '0');
          return (
            <li>
              <a
                class="way-action"
                href={href}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                <span class="way-num">{num}</span>
                <span class="way-label">{es ? a.labelEs : a.labelEn}</span>
                <span class="way-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          );
        })}
      </ul>
    </article>
  </div>
</section>

<style>
  .ways-section .section-subtitle {
    margin-bottom: 2.5rem;
  }

  .way-card {
    display: grid;
    grid-template-columns: 230px 1fr;
    border-radius: 28px;
    background: var(--card-surface);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  /* Left identity panel — solid forest green */
  .way-side {
    background: var(--accent-forest);
    color: var(--bg-elevated);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
  }

  .way-side-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 5.5rem;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }

  .way-side-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-yellow);
  }

  /* Right action grid */
  .way-actions {
    list-style: none;
    margin: 0;
    padding: 1rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.625rem;
  }

  .way-action {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border-radius: 14px;
    background: transparent;
    color: var(--text-primary);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .way-action:hover {
    background: var(--bg-secondary);
    color: var(--accent-forest);
  }

  .way-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--accent-forest);
    opacity: 0.7;
  }

  .way-label {
    min-width: 0;
  }

  .way-arrow {
    color: var(--accent-forest);
    font-size: 1.1rem;
    transition: transform 0.15s ease;
  }

  .way-action:hover .way-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .way-action,
    .way-action:hover,
    .way-arrow,
    .way-action:hover .way-arrow {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 860px) {
    .way-card {
      grid-template-columns: 1fr;
    }

    .way-side {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem 1.75rem;
      min-height: 0;
    }

    .way-side-num {
      font-size: 3rem;
    }
  }

  @media (max-width: 560px) {
    .way-actions {
      grid-template-columns: 1fr;
      padding: 0.75rem;
    }
  }
</style>
