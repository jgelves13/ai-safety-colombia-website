---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';
import data from '../data/getInvolved.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

type Action = { labelEs: string; labelEn: string; ext?: string; path?: string; anchor?: string };

const resolve = (a: Action) => {
  if (a.ext) return { href: a.ext, external: true };
  if (a.anchor) return { href: a.anchor, external: false };
  return { href: localePath(locale, a.path ?? '/'), external: false };
};
---

<section class="section ways-section" aria-labelledby="ways-title">
  <div class="container">
    <h2 class="section-title" id="ways-title">{t(locale, 'home.ways.title')}</h2>
    <p class="section-subtitle">{t(locale, 'home.ways.subtitle')}</p>

    <ul class="ways-grid">
      {(data.actions as Action[]).map((a, i) => {
        const { href, external } = resolve(a);
        const num = String(i + 1).padStart(2, '0');
        return (
          <li>
            <a
              class="way-tile"
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              <span class="way-num">{num}</span>
              <span class="way-label">{es ? a.labelEs : a.labelEn}</span>
              <span class="way-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .ways-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .way-tile {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 1.75rem;
    min-height: 5.5rem;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--card-surface);
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    transition: border-color 0.15s ease, transform 0.15s ease, color 0.15s ease;
  }

  .way-tile:hover {
    border-color: var(--text-primary);
    color: var(--accent-forest);
    transform: translateY(-2px);
  }

  .way-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--accent-forest);
  }

  .way-label {
    min-width: 0;
  }

  .way-arrow {
    font-size: 1.125rem;
    color: var(--accent-forest);
    transition: transform 0.15s ease;
  }

  .way-tile:hover .way-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .ways-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .ways-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .way-tile,
    .way-tile:hover,
    .way-arrow,
    .way-tile:hover .way-arrow {
      transition: none;
      transform: none;
    }
  }
</style>
