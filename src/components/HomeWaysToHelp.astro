---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';
import data from '../data/getInvolved.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

type Action = {
  labelEs: string;
  labelEn: string;
  descEs: string;
  descEn: string;
  metaEs: string;
  metaEn: string;
  accent: string;
  ext?: string;
  path?: string;
  anchor?: string;
};

const resolve = (a: Action) => {
  if (a.ext) return { href: a.ext, external: true };
  if (a.anchor) return { href: a.anchor, external: false };
  return { href: localePath(locale, a.path ?? '/'), external: false };
};
---

<section class="section ways-section" aria-labelledby="ways-title">
  <div class="container">
    <h2 class="section-title" id="ways-title">{t(locale, 'home.ways.title')}</h2>
    <p class="section-subtitle">{t(locale, 'home.ways.subtitle')}</p>

    <ul class="ways-grid">
      {(data.actions as Action[]).map((a, i) => {
        const { href, external } = resolve(a);
        const num = String(i + 1).padStart(2, '0');
        return (
          <li>
            <a
              class:list={['way-card', a.accent]}
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              <span class="way-num" aria-hidden="true">{num}</span>
              <h3 class="way-label">{es ? a.labelEs : a.labelEn}</h3>
              <p class="way-desc">{es ? a.descEs : a.descEn}</p>
              <div class="way-foot">
                <span class="way-meta">{es ? a.metaEs : a.metaEn}</span>
                <span class="way-arrow" aria-hidden="true">&rarr;</span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .ways-section .section-subtitle {
    margin-bottom: 2.75rem;
  }

  .ways-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .way-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 2rem 2rem 1.75rem;
    color: var(--text-primary);
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .way-card:hover {
    border-color: var(--text-primary);
    transform: translateY(-3px);
    box-shadow: 0 18px 32px -22px rgba(31, 26, 18, 0.22);
  }

  /* Big accent numeral — the WhatWeDo signature move, recoloured per card */
  .way-num {
    font-family: var(--font-display);
    font-size: 3.4rem;
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
    color: var(--accent-forest);
  }

  .is-coral  .way-num { color: var(--accent-vermillion); }
  .is-blue   .way-num { color: var(--accent-sage); }
  .is-green  .way-num { color: var(--accent-forest); }
  .is-yellow .way-num { color: var(--accent-yellow); }

  .way-label {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.18;
    color: var(--text-primary);
    margin: 0 0 0.625rem;
  }

  .way-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0 0 1.5rem;
    flex: 1;
  }

  .way-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
  }

  .way-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .way-arrow {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-forest);
    font-size: 1.05rem;
    flex: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .way-card:hover .way-arrow {
    background: var(--accent-forest);
    border-color: var(--accent-forest);
    color: var(--bg-elevated);
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .way-card,
    .way-card:hover,
    .way-arrow,
    .way-card:hover .way-arrow {
      transition: none;
      transform: none;
      box-shadow: none;
    }
  }

  @media (max-width: 900px) {
    .ways-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .ways-grid { grid-template-columns: 1fr; }

    .way-num { font-size: 2.75rem; }
  }
</style>
