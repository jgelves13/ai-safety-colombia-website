---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';
import data from '../data/getInvolved.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

type Action = { labelEs: string; labelEn: string; ext?: string; path?: string; anchor?: string };

const resolve = (a: Action) => {
  if (a.ext) return { href: a.ext, external: true };
  if (a.anchor) return { href: a.anchor, external: false };
  return { href: localePath(locale, a.path ?? '/'), external: false };
};
---

<section class="section ways-section" aria-labelledby="ways-title">
  <div class="container">
    <h2 class="section-title" id="ways-title">{t(locale, 'home.ways.title')}</h2>
    <p class="section-subtitle">{t(locale, 'home.ways.subtitle')}</p>

    <article class="way-card is-green">
      <div class="way-bar"></div>
      <div class="way-tx">
        <ul class="way-actions">
          {(data.actions as Action[]).map((a) => {
            const { href, external } = resolve(a);
            return (
              <li>
                <a
                  class="way-action"
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <span>{es ? a.labelEs : a.labelEn}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </article>
  </div>
</section>

<style>
  .way-card {
    display: flex;
    gap: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 2rem 2.25rem;
    background: var(--card-surface);
    transition: border-color 0.15s;
  }

  .way-card:hover {
    border-color: var(--text-primary);
  }

  .way-bar {
    width: 5px;
    flex: none;
    border-radius: 999px;
    background: var(--accent-forest);
  }

  .way-tx {
    min-width: 0;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .way-title {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .way-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 0.5rem;
  }

  .way-actions {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 2rem;
    margin-top: 1.5rem;
  }

  .way-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: color 0.15s ease, padding-left 0.15s ease;
  }

  .way-action:hover {
    color: var(--accent-forest);
    padding-left: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .way-card,
    .way-card:hover,
    .way-action {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .way-card {
      padding: 1.75rem;
    }

    .way-actions {
      grid-template-columns: 1fr;
    }
  }
</style>
