---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';
import data from '../data/getInvolved.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

type Action = {
  slug: string;
  labelEs: string;
  labelEn: string;
  descEs: string;
  descEn: string;
  metaEs: string;
  metaEn: string;
  accent: string;
  ext?: string;
  path?: string;
  anchor?: string;
};

const resolve = (a: Action) => {
  if (a.ext) return { href: a.ext, external: true };
  if (a.anchor) return { href: a.anchor, external: false };
  return { href: localePath(locale, a.path ?? '/'), external: false };
};

// Line-art glyphs per action — 48×48 viewBox, stroke only
const GLYPHS: Record<string, string> = {
  community:
    '<path d="M10 16 Q10 8 24 8 Q38 8 38 16 Q38 24 24 24 L13 34 L15 24 Q10 24 10 16 Z"/><circle cx="17" cy="16" r="2" fill="currentColor" stroke="none"/><circle cx="24" cy="16" r="2" fill="currentColor" stroke="none"/><circle cx="31" cy="16" r="2" fill="currentColor" stroke="none"/>',
  hackathon:
    '<polygon points="30,5 17,26 26,26 18,43 37,20 28,20"/>',
  resources:
    '<rect x="9" y="6" width="15" height="36" rx="2"/><rect x="26" y="10" width="13" height="32" rx="2"/><line x1="9" y1="14" x2="24" y2="14"/><line x1="9" y1="20" x2="24" y2="20"/><line x1="9" y1="26" x2="24" y2="26"/><line x1="26" y1="18" x2="39" y2="18"/><line x1="26" y1="24" x2="39" y2="24"/>',
  events:
    '<rect x="6" y="13" width="36" height="28" rx="3"/><line x1="6" y1="21" x2="42" y2="21"/><line x1="16" y1="8" x2="16" y2="17"/><line x1="32" y1="8" x2="32" y2="17"/><circle cx="16" cy="29" r="2.5" fill="currentColor" stroke="none"/><circle cx="24" cy="29" r="2.5" fill="currentColor" stroke="none"/><circle cx="32" cy="29" r="2.5" fill="currentColor" stroke="none"/><circle cx="16" cy="36" r="2.5" fill="currentColor" stroke="none"/><circle cx="24" cy="36" r="2.5" fill="currentColor" stroke="none"/>',
  discussion:
    '<circle cx="24" cy="9" r="4"/><circle cx="9" cy="34" r="4"/><circle cx="39" cy="34" r="4"/><circle cx="24" cy="26" r="5"/><line x1="24" y1="13" x2="24" y2="21"/><line x1="12" y1="32" x2="20" y2="28"/><line x1="36" y1="32" x2="28" y2="28"/>',
  contact:
    '<rect x="5" y="13" width="38" height="26" rx="3"/><polyline points="5,13 24,27 43,13"/>',
};

const glyph = (slug: string) => GLYPHS[slug] ?? GLYPHS['contact'];
---

<section class="section ways-section" aria-labelledby="ways-title">
  <div class="container">
    <h2 class="section-title" id="ways-title">{t(locale, 'home.ways.title')}</h2>
    <p class="section-subtitle">{t(locale, 'home.ways.subtitle')}</p>

    <ul class="ways-grid">
      {(data.actions as Action[]).map((a) => {
        const { href, external } = resolve(a);
        return (
          <li>
            <a
              class:list={['way-card', a.accent]}
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              <div class="way-cover" aria-hidden="true">
                <span class="way-cover-orbit"></span>
                <span class="way-cover-glow"></span>
                <svg
                  class="way-glyph"
                  viewBox="0 0 48 48"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={glyph(a.slug)}
                />
              </div>

              <div class="way-body">
                <h3 class="way-label">{es ? a.labelEs : a.labelEn}</h3>
                <p class="way-desc">{es ? a.descEs : a.descEn}</p>
                <div class="way-foot">
                  <span class="way-meta">{es ? a.metaEs : a.metaEn}</span>
                  <span class="way-arrow" aria-hidden="true">&rarr;</span>
                </div>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .ways-section .section-subtitle {
    margin-bottom: 2.75rem;
  }

  .ways-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .way-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    color: var(--text-primary);
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .way-card:hover {
    border-color: var(--text-primary);
    transform: translateY(-3px);
    box-shadow: 0 18px 32px -22px rgba(31, 26, 18, 0.22);
  }

  /* ---- Colored cover band ---- */
  .way-cover {
    position: relative;
    height: 108px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }

  .is-coral  .way-cover { background: var(--accent-vermillion); }
  .is-yellow .way-cover { background: var(--accent-yellow); }
  .is-green  .way-cover { background: var(--accent-forest); }
  .is-blue   .way-cover { background: var(--accent-sage); }

  .way-cover-orbit {
    position: absolute;
    top: -44px;
    right: -44px;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.25);
    z-index: 0;
    animation: way-spin 28s linear infinite;
  }

  .way-cover-glow {
    position: absolute;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    z-index: 0;
    animation: way-pulse 5s ease-in-out infinite;
  }

  .way-glyph {
    position: relative;
    z-index: 1;
    width: 52px;
    height: 52px;
    color: rgba(255,255,255,0.92);
    animation: way-float 7s ease-in-out infinite;
  }

  /* Yellow cover needs darker icon for contrast */
  .is-yellow .way-glyph { color: var(--accent-forest); }
  .is-yellow .way-cover-glow { background: rgba(0,0,0,0.06); }

  @keyframes way-float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-5px); }
  }
  @keyframes way-spin {
    to { transform: rotate(360deg); }
  }
  @keyframes way-pulse {
    0%, 100% { transform: scale(1);    opacity: 0.8; }
    50%       { transform: scale(1.1); opacity: 1;   }
  }

  /* ---- Card body ---- */
  .way-body {
    padding: 1.375rem 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .way-label {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text-primary);
    margin: 0 0 0.625rem;
  }

  .way-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0 0 1.25rem;
    flex: 1;
  }

  .way-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
  }

  .way-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .way-arrow {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-forest);
    font-size: 1.05rem;
    flex: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .way-card:hover .way-arrow {
    background: var(--accent-forest);
    border-color: var(--accent-forest);
    color: var(--bg-elevated);
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .way-card, .way-card:hover,
    .way-arrow, .way-card:hover .way-arrow,
    .way-glyph, .way-cover-orbit, .way-cover-glow {
      transition: none;
      transform: none;
      animation: none;
      box-shadow: none;
    }
  }

  @media (max-width: 900px) {
    .ways-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .ways-grid { grid-template-columns: 1fr; }
    .way-cover { height: 88px; }
  }
</style>
