---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import EventCard from './EventCard.astro';
import PageHero from './PageHero.astro';
import { splitEvents } from '../utils/events.js';
import eventsData from '../data/events.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { upcoming, past } = splitEvents(eventsData);
const hasAny = upcoming.length + past.length > 0;

// Follow channels for the "stay in the loop" callout.
const WHATSAPP = 'https://chat.whatsapp.com/KwE8cciX48TAVhAOHnrLaZ';
const INSTAGRAM = 'https://www.instagram.com/aisafetycolombia/';
const LINKEDIN = 'https://www.linkedin.com/company/ai-safety-col/';

// Distinct event types present in the past grid, in first-appearance order.
// A single type needs no filter. Labels are resolved here (not in the
// template) so the `Parameters<typeof t>` generic isn't parsed as JSX.
const pastTypes = [...new Set(past.map((e) => e.type))];
const showFilter = pastTypes.length > 1;
const filterOptions = pastTypes.map((type) => ({
  type,
  label: t(locale, `events.type.${type}` as Parameters<typeof t>[1]) || type,
}));
---

<PageHero title={t(locale, 'events.hero.title')} desc={t(locale, 'events.hero.subtitle')} />

{upcoming.length > 0 && (
  <section class="section featured-block" aria-labelledby="events-upcoming">
    <div class="container">
      <h2 class="section-label" id="events-upcoming">{t(locale, 'events.upcoming')}</h2>
      <div class="events-list">
        {upcoming.map(ev => <EventCard event={ev} locale={locale} />)}
      </div>
    </div>
  </section>
)}

<section class="section" aria-labelledby="events-past">
  <div class="container">
    {hasAny ? (
      <>
        <h2 class="section-label" id="events-past">{t(locale, 'events.past')}</h2>
        {showFilter && (
          <div class="event-filters" data-event-filters hidden>
            <button class="filter-pill is-active" type="button" data-filter="all" aria-pressed="true">
              {t(locale, 'events.filterAll')}
            </button>
            {filterOptions.map(opt => (
              <button class="filter-pill" type="button" data-filter={opt.type} aria-pressed="false">
                {opt.label}
              </button>
            ))}
          </div>
        )}
        <div class="events-grid">
          {past.map(ev => <EventCard event={ev} locale={locale} />)}
        </div>
      </>
    ) : (
      <p class="events-empty">
        {t(locale, 'events.empty')}{' '}
        <a href="https://www.instagram.com/aisafetycolombia/" target="_blank" rel="noopener noreferrer">@aisafetycolombia</a>
      </p>
    )}
  </div>
</section>

<section class="events-notify">
  <div class="container">
    <div class="notify-card">
      <span class="notify-disc" aria-hidden="true"></span>
      <span class="notify-ring" aria-hidden="true"></span>
      <span class="notify-kicker">{t(locale, 'events.notifyKicker')}</span>
      <h2 class="section-title notify-title">{t(locale, 'events.notifyTitle')}</h2>
      <p class="notify-lead">{t(locale, 'events.notifyText')}</p>
      <div class="notify-channels">
        <a class="notify-btn" href={WHATSAPP} target="_blank" rel="noopener noreferrer">
          <span class="nb-icon nb-whatsapp" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.359.101 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.582 0 11.941-5.359 11.944-11.893a11.821 11.821 0 00-3.487-8.4z" />
            </svg>
          </span>
          <span class="nb-label">WhatsApp</span>
        </a>

        <a class="notify-btn" href={INSTAGRAM} target="_blank" rel="noopener noreferrer">
          <span class="nb-icon nb-instagram" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227a3.81 3.81 0 01-.899 1.382 3.744 3.744 0 01-1.38.896c-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421a3.716 3.716 0 01-1.379-.899 3.644 3.644 0 01-.9-1.38c-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm7.846-10.405a1.441 1.441 0 01-2.88 0 1.44 1.44 0 012.88 0z" />
            </svg>
          </span>
          <span class="nb-label">Instagram</span>
        </a>

        <a class="notify-btn" href={LINKEDIN} target="_blank" rel="noopener noreferrer">
          <span class="nb-icon nb-linkedin" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
            </svg>
          </span>
          <span class="nb-label">LinkedIn</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .featured-block :global(.event-card) {
    background: var(--bg-elevated);
  }

  /* ---- "Stay in the loop" callout — coral closing CTA ---- */
  .events-notify {
    padding: 1rem 0 2rem;
  }

  .notify-card {
    position: relative;
    overflow: hidden;
    background: var(--accent-vermillion);
    border-radius: 28px;
    padding: 3.25rem 2rem;
    text-align: center;
  }

  /* keep the real content above the decorative shapes */
  .notify-card > :not(.notify-disc):not(.notify-ring) {
    position: relative;
    z-index: 1;
  }

  /* decorative shape — darker-coral disc bleeding off the upper-left */
  .notify-disc {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: var(--accent-vermillion-dark);
    top: -140px;
    left: -100px;
    opacity: 0.55;
    z-index: 0;
    pointer-events: none;
  }

  /* decorative shape — yellow ring bleeding off the lower-right */
  .notify-ring {
    position: absolute;
    width: 180px;
    height: 180px;
    border: 22px solid var(--accent-yellow);
    border-radius: 50%;
    bottom: -80px;
    right: -55px;
    opacity: 0.5;
    z-index: 0;
    pointer-events: none;
  }

  /* cream kicker pill — coral text on a coral block would vanish */
  .notify-kicker {
    display: inline-flex;
    align-items: center;
    background: var(--bg-elevated);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .notify-title {
    font-size: clamp(1.5rem, 3.5vw, 2.125rem);
    line-height: 1.1;
    max-width: 20ch;
    margin: 0 auto 0.75rem;
    color: var(--text-primary);
  }

  .notify-lead {
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 32rem;
    margin: 0 auto 1.875rem;
    color: var(--text-primary);
  }

  .notify-channels {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }

  .notify-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-elevated);
    border: 1.5px solid var(--bg-elevated);
    border-radius: 999px;
    padding: 0.375rem 1rem 0.375rem 0.375rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .notify-btn:hover {
    border-color: var(--text-primary);
    color: var(--text-primary);
    transform: translateY(-2px);
  }

  .nb-icon {
    flex: none;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #fff;
  }

  .nb-icon svg {
    width: 16px;
    height: 16px;
  }

  .nb-whatsapp { background: #25D366; }
  .nb-instagram {
    background: radial-gradient(circle at 30% 107%,
      #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285aeb 90%);
  }
  .nb-linkedin { background: #0a66c2; }

  .event-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .event-filters[hidden] {
    display: none;
  }

  .filter-pill {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    color: var(--text-primary);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .filter-pill:hover {
    border-color: var(--text-primary);
  }

  .filter-pill.is-active {
    background: var(--accent-forest);
    border-color: var(--accent-forest);
    color: var(--bg-elevated);
  }

  .events-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .events-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .events-empty {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .events-grid {
      grid-template-columns: 1fr;
    }

    .notify-card {
      padding: 2.5rem 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notify-btn,
    .notify-btn:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-event-filters]');
  if (bar) {
    bar.hidden = false;
    const pills = Array.from(
      bar.querySelectorAll<HTMLButtonElement>('button[data-filter]')
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('.events-grid [data-event-type]')
    );
    bar.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const btn = target.closest<HTMLButtonElement>('button[data-filter]');
      if (!btn) return;
      const filter = btn.dataset.filter;
      for (const p of pills) {
        const active = p === btn;
        p.classList.toggle('is-active', active);
        p.setAttribute('aria-pressed', String(active));
      }
      for (const card of cards) {
        const show = filter === 'all' || card.dataset.eventType === filter;
        card.style.display = show ? '' : 'none';
      }
    });
  }
</script>
