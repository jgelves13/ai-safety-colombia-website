---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import EventCard from './EventCard.astro';
import PageHero from './PageHero.astro';
import { splitEvents } from '../utils/events.js';
import { typeColor } from '../utils/eventTypes.js';
import eventsData from '../data/events.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { upcoming, past } = splitEvents(eventsData);
const hasAny = upcoming.length + past.length > 0;

// Distinct event types present in the past grid, in first-appearance order.
// A single type needs no filter. Labels are resolved here (not in the
// template) so the `Parameters<typeof t>` generic isn't parsed as JSX.
const pastTypes = [...new Set(past.map((e) => e.type))];
const showFilter = pastTypes.length > 1;
const filterOptions = pastTypes.map((type) => ({
  type,
  label: t(locale, `events.type.${type}` as Parameters<typeof t>[1]) || type,
}));

// Format legend: distinct types across all events, so "Charla / Panel /
// Conversatorio / Cena" are spelled out (Jose: the difference wasn't clear).
const allTypes = [
  ...new Set([...upcoming, ...past].map((e) => e.type)),
];
const legendItems = allTypes.map((type) => ({
  type,
  color: typeColor(type),
  label: t(locale, `events.type.${type}` as Parameters<typeof t>[1]) || type,
  desc: t(locale, `events.type.${type}Desc` as Parameters<typeof t>[1]),
}));
const showLegend = legendItems.length > 1;
---

<PageHero title={t(locale, 'events.hero.title')} desc={t(locale, 'events.hero.subtitle')} />

{upcoming.length > 0 && (
  <section class="section" aria-labelledby="events-upcoming">
    <div class="container">
      <h2 class="section-label" id="events-upcoming">{t(locale, 'events.upcoming')}</h2>
      <div class="events-list">
        {upcoming.map(ev => <EventCard event={ev} locale={locale} />)}
      </div>
    </div>
  </section>
)}

<section class="section" aria-labelledby="events-past">
  <div class="container">
    {hasAny ? (
      <>
        <h2 class="section-label" id="events-past">{t(locale, 'events.past')}</h2>
        {showLegend && (
          <div class="events-legend">
            <p class="events-legend-title">{t(locale, 'events.legendTitle')}</p>
            <dl class="events-legend-list">
              {legendItems.map(it => (
                <div class="legend-row">
                  <dt class="legend-tag" style={`color:${it.color}`}>{it.label}</dt>
                  <dd class="legend-desc">{it.desc}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
        {showFilter && (
          <div class="event-filters" data-event-filters hidden>
            <button class="filter-pill is-active" type="button" data-filter="all" aria-pressed="true">
              {t(locale, 'events.filterAll')}
            </button>
            {filterOptions.map(opt => (
              <button class="filter-pill" type="button" data-filter={opt.type} aria-pressed="false">
                {opt.label}
              </button>
            ))}
          </div>
        )}
        <div class="events-grid">
          {past.map(ev => <EventCard event={ev} locale={locale} />)}
        </div>
      </>
    ) : (
      <p class="events-empty">
        {t(locale, 'events.empty')}{' '}
        <a href="https://www.instagram.com/aisafetycolombia/" target="_blank" rel="noopener noreferrer">@aisafetycolombia</a>
      </p>
    )}
  </div>
</section>

<style>
  .section-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--green-text);
    margin-bottom: 1.25rem;
  }

  .events-legend {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    background: #FAFAF7;
    max-width: 720px;
  }

  .events-legend-title {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    margin-bottom: 0.625rem;
  }

  .events-legend-list {
    display: grid;
    gap: 0.5rem 1.5rem;
    margin: 0;
  }

  .legend-row {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }

  .legend-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .legend-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  @media (min-width: 640px) {
    .events-legend-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .event-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  /* Keep the bar hidden until JS enhances it (no non-functional control
     for no-JS visitors; all cards remain visible). */
  .event-filters[hidden] {
    display: none;
  }

  .filter-pill {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.375rem 0.875rem;
    color: var(--text-secondary);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .filter-pill:hover {
    border-color: var(--green-text);
    color: var(--text-primary);
  }

  .filter-pill.is-active {
    background: var(--accent-green);
    border-color: var(--accent-green);
    color: #101010;
  }

  .events-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .events-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .events-empty {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .events-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-event-filters]');
  if (bar) {
    bar.hidden = false;
    const pills = Array.from(
      bar.querySelectorAll<HTMLButtonElement>('button[data-filter]')
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('.events-grid [data-event-type]')
    );
    bar.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const btn = target.closest<HTMLButtonElement>('button[data-filter]');
      if (!btn) return;
      const filter = btn.dataset.filter;
      for (const p of pills) {
        const active = p === btn;
        p.classList.toggle('is-active', active);
        p.setAttribute('aria-pressed', String(active));
      }
      for (const card of cards) {
        const show = filter === 'all' || card.dataset.eventType === filter;
        card.style.display = show ? '' : 'none';
      }
    });
  }
</script>
