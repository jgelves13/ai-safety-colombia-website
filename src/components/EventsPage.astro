---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import EventCard from './EventCard.astro';
import PageHero from './PageHero.astro';
import { splitEvents } from '../utils/events.js';
import eventsData from '../data/events.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { upcoming, past } = splitEvents(eventsData);
const hasAny = upcoming.length + past.length > 0;

// Follow channels for the "stay in the loop" callout.
const WHATSAPP = 'https://chat.whatsapp.com/KwE8cciX48TAVhAOHnrLaZ';
const INSTAGRAM = 'https://www.instagram.com/aisafetycolombia/';
const LINKEDIN = 'https://www.linkedin.com/company/ai-safety-col/';

// Distinct event types present in the past grid, in first-appearance order.
// A single type needs no filter. Labels are resolved here (not in the
// template) so the `Parameters<typeof t>` generic isn't parsed as JSX.
const pastTypes = [...new Set(past.map((e) => e.type))];
const showFilter = pastTypes.length > 1;
const filterOptions = pastTypes.map((type) => ({
  type,
  label: t(locale, `events.type.${type}` as Parameters<typeof t>[1]) || type,
}));
---

<PageHero title={t(locale, 'events.hero.title')} desc={t(locale, 'events.hero.subtitle')} />

<div class="events-notify">
  <div class="container">
    <div class="notify-card featured-block">
      <span class="notify-ring" aria-hidden="true"></span>
      <span class="section-label">{t(locale, 'events.notifyKicker')}</span>
      <h2 class="section-title notify-title">{t(locale, 'events.notifyTitle')}</h2>
      <p class="notify-lead">{t(locale, 'events.notifyText')}</p>
      <div class="notify-channels">
        <a class="notify-btn" href={WHATSAPP} target="_blank" rel="noopener noreferrer">
          <span class="nb-icon nb-whatsapp" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5c0 4.1-4 7.5-9 7.5-1.3 0-2.6-.2-3.7-.7L3 20l1.4-3.9C3.5 14.8 3 13.2 3 11.5 3 7.4 7 4 12 4s9 3.4 9 7.5Z" />
              <circle cx="8.5" cy="11.7" r="1.05" fill="currentColor" stroke="none" />
              <circle cx="12" cy="11.7" r="1.05" fill="currentColor" stroke="none" />
              <circle cx="15.5" cy="11.7" r="1.05" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <span class="nb-label">WhatsApp</span>
        </a>

        <a class="notify-btn" href={INSTAGRAM} target="_blank" rel="noopener noreferrer">
          <span class="nb-icon nb-instagram" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.1" cy="6.9" r="1.2" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <span class="nb-label">Instagram</span>
        </a>

        <a class="notify-btn" href={LINKEDIN} target="_blank" rel="noopener noreferrer">
          <span class="nb-icon nb-linkedin" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.5" y="7.5" width="19" height="12.5" rx="2.5" />
              <path d="M8.5 7.5V6A2.5 2.5 0 0 1 11 3.5h2A2.5 2.5 0 0 1 15.5 6v1.5" />
              <path d="M2.5 12.5h19" />
            </svg>
          </span>
          <span class="nb-label">LinkedIn</span>
        </a>
      </div>
    </div>
  </div>
</div>

{upcoming.length > 0 && (
  <section class="section featured-block" aria-labelledby="events-upcoming">
    <div class="container">
      <h2 class="section-label" id="events-upcoming">{t(locale, 'events.upcoming')}</h2>
      <div class="events-list">
        {upcoming.map(ev => <EventCard event={ev} locale={locale} />)}
      </div>
    </div>
  </section>
)}

<section class="section" aria-labelledby="events-past">
  <div class="container">
    {hasAny ? (
      <>
        <h2 class="section-label" id="events-past">{t(locale, 'events.past')}</h2>
        {showFilter && (
          <div class="event-filters" data-event-filters hidden>
            <button class="filter-pill is-active" type="button" data-filter="all" aria-pressed="true">
              {t(locale, 'events.filterAll')}
            </button>
            {filterOptions.map(opt => (
              <button class="filter-pill" type="button" data-filter={opt.type} aria-pressed="false">
                {opt.label}
              </button>
            ))}
          </div>
        )}
        <div class="events-grid">
          {past.map(ev => <EventCard event={ev} locale={locale} />)}
        </div>
      </>
    ) : (
      <p class="events-empty">
        {t(locale, 'events.empty')}{' '}
        <a href="https://www.instagram.com/aisafetycolombia/" target="_blank" rel="noopener noreferrer">@aisafetycolombia</a>
      </p>
    )}
  </div>
</section>

<style>
  .featured-block :global(.event-card) {
    background: var(--bg-elevated);
  }

  /* ---- "Stay in the loop" callout — green Trópico featured block ---- */
  .events-notify {
    padding: 2.25rem 0 0.5rem;
  }

  .notify-card {
    border-radius: 28px;
    padding: 3.25rem 2rem;
    text-align: center;
  }

  /* second decorative shape — a yellow ring bleeding off the lower-right
     (the .featured-block ::before already supplies the sage circle) */
  .notify-ring {
    position: absolute;
    width: 180px;
    height: 180px;
    border: 22px solid var(--accent-yellow);
    border-radius: 50%;
    bottom: -80px;
    right: -55px;
    opacity: 0.45;
    z-index: 0;
    pointer-events: none;
  }

  .notify-card .section-label {
    margin-bottom: 1.25rem;
  }

  .notify-title {
    max-width: 20ch;
    margin: 0 auto 0.75rem;
  }

  .notify-lead {
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 32rem;
    margin: 0 auto 1.875rem;
  }

  .notify-channels {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
  }

  .notify-card .notify-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--card-surface);
    border: 1.5px solid var(--card-surface);
    border-radius: 999px;
    padding: 0.375rem 1rem 0.375rem 0.375rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .notify-card .notify-btn:hover {
    border-color: var(--accent-yellow);
    color: var(--text-primary);
    transform: translateY(-2px);
  }

  .nb-icon {
    flex: none;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--bg-elevated);
  }

  .nb-icon svg {
    width: 17px;
    height: 17px;
  }

  .nb-whatsapp { background: var(--accent-sage); }
  .nb-instagram { background: var(--accent-vermillion); }
  .nb-linkedin {
    background: var(--accent-yellow);
    color: var(--text-primary);
  }

  .event-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .event-filters[hidden] {
    display: none;
  }

  .filter-pill {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    color: var(--text-primary);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .filter-pill:hover {
    border-color: var(--text-primary);
  }

  .filter-pill.is-active {
    background: var(--accent-forest);
    border-color: var(--accent-forest);
    color: var(--bg-elevated);
  }

  .events-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .events-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .events-empty {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .events-grid {
      grid-template-columns: 1fr;
    }

    .notify-card {
      padding: 2.5rem 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notify-card .notify-btn,
    .notify-card .notify-btn:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-event-filters]');
  if (bar) {
    bar.hidden = false;
    const pills = Array.from(
      bar.querySelectorAll<HTMLButtonElement>('button[data-filter]')
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('.events-grid [data-event-type]')
    );
    bar.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const btn = target.closest<HTMLButtonElement>('button[data-filter]');
      if (!btn) return;
      const filter = btn.dataset.filter;
      for (const p of pills) {
        const active = p === btn;
        p.classList.toggle('is-active', active);
        p.setAttribute('aria-pressed', String(active));
      }
      for (const card of cards) {
        const show = filter === 'all' || card.dataset.eventType === filter;
        card.style.display = show ? '' : 'none';
      }
    });
  }
</script>
