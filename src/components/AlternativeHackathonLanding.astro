---
import { alternativeHackathonLanding as landing } from "../data/alternativeHackathonLanding";
---

<div class="alternative-landing">
  <section class="alt-hero">
    <div class="container alt-hero-grid">
      <div class="alt-copy">
        <p class="alt-eyebrow">{landing.eyebrow}</p>
        <h1>
          <span>{landing.hubTitle}</span>
          {landing.headline}
        </h1>
        <p class="alt-meta">{landing.meta}</p>
        <p class="alt-lead">{landing.lead}</p>
        <div class="alt-actions">
          <a
            class="btn btn-primary"
            href={landing.primaryCtaHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            {landing.primaryCta}
          </a>
          <a class="btn btn-secondary" href="#details">{landing.secondaryCta}</a>
        </div>
      </div>

      <aside class="alt-panel" aria-label="Datos clave del hackathon">
        <h2>{landing.panelTitle}</h2>
        <ul>
          {landing.panelFacts.map((fact) => <li>{fact}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="alt-details" id="details">
    <div class="container">
      <div class="alt-card-grid">
        {landing.cards.map((card) => (
          <article class="alt-card">
            <span>{card.label}</span>
            <h2>{card.title}</h2>
            <p>{card.body}</p>
            {card.links && (
              <div class="alt-card-links">
                {card.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="alt-cta">
    <div class="container alt-cta-grid">
      <div>
        <p class="alt-eyebrow">{landing.finalCtaKicker}</p>
        <h2>{landing.finalCtaTitle}</h2>
      </div>
      <a
        class="btn btn-vermillion"
        href={landing.primaryCtaHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        {landing.primaryCta}
      </a>
    </div>
  </section>
</div>

<style>
  .alternative-landing {
    background: var(--bg-primary);
  }

  .alt-hero {
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
    padding: clamp(3rem, 7vw, 5rem) 0 clamp(2.75rem, 5vw, 4rem);
    position: relative;
  }

  .alt-hero::before {
    aspect-ratio: 1;
    background: var(--accent-yellow);
    border-radius: 50%;
    content: "";
    min-width: 0;
    opacity: 0.2;
    position: absolute;
    right: -4.5rem;
    top: 2rem;
    width: clamp(140px, 20vw, 260px);
  }

  .alt-hero-grid {
    align-items: center;
    display: grid;
    gap: clamp(2rem, 6vw, 4.5rem);
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.44fr);
    position: relative;
    z-index: 1;
  }

  .alt-eyebrow {
    color: var(--accent-forest);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .alt-copy h1 {
    font-size: clamp(3rem, 7vw, 6.2rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin: 0.75rem 0;
    max-width: 10.5ch;
  }

  .alt-copy h1 span {
    color: var(--accent-vermillion);
    display: block;
    font-size: 0.62em;
    line-height: 0.95;
    margin-bottom: 0.12em;
  }

  .alt-meta {
    color: var(--text-primary);
    font-weight: 800;
    line-height: 1.45;
    margin: 0 0 0.95rem;
    max-width: 720px;
  }

  .alt-lead {
    color: var(--text-secondary);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.5;
    max-width: 650px;
  }

  .alt-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.35rem;
  }

  .alt-panel {
    aspect-ratio: 1;
    background: var(--accent-forest);
    border-radius: 8px;
    box-shadow: 0 28px 65px -48px rgba(33, 26, 18, 0.7);
    color: var(--bg-elevated);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-height: 330px;
    padding: clamp(1.35rem, 3vw, 2rem);
  }

  .alt-panel h2 {
    color: var(--bg-elevated);
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 0.95;
    margin-bottom: 0.75rem;
  }

  .alt-panel ul {
    display: grid;
    gap: 0.7rem;
    list-style: none;
    margin-top: 1.2rem;
  }

  .alt-panel li {
    border-top: 1px solid rgba(255, 251, 242, 0.22);
    color: var(--bg-elevated);
    font-size: 0.92rem;
    font-weight: 800;
    line-height: 1.28;
    padding-top: 0.65rem;
  }

  .alt-details {
    background: var(--bg-primary);
    padding: clamp(2.5rem, 5vw, 3.75rem) 0 clamp(3.75rem, 6vw, 5rem);
  }

  .alt-card-grid {
    display: grid;
    gap: clamp(0.85rem, 2vw, 1.15rem);
    grid-template-columns: repeat(3, 1fr);
  }

  .alt-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    min-height: 100%;
    padding: clamp(1.25rem, 2.4vw, 1.65rem);
  }

  .alt-card span {
    color: var(--accent-forest);
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .alt-card h2 {
    font-size: 1.4rem;
    line-height: 1.1;
    margin-bottom: 0.65rem;
  }

  .alt-card p {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.58;
  }

  .alt-card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .alt-card-links a {
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--accent-forest);
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1;
    padding: 0.55rem 0.7rem;
  }

  .alt-card-links a:hover {
    background: rgba(242, 183, 5, 0.2);
    border-color: var(--accent-forest);
  }

  .alt-cta {
    background: var(--accent-forest);
    color: var(--bg-elevated);
    overflow: hidden;
    padding: clamp(3rem, 6vw, 4.25rem) 0;
    position: relative;
  }

  .alt-cta::before {
    background: var(--accent-sage);
    border-radius: 50%;
    content: "";
    height: 280px;
    opacity: 0.5;
    position: absolute;
    right: -70px;
    top: -110px;
    width: 280px;
  }

  .alt-cta-grid {
    align-items: center;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    position: relative;
    z-index: 1;
  }

  .alt-cta h2,
  .alt-cta .alt-eyebrow {
    color: var(--bg-elevated);
  }

  .alt-cta h2 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1;
    max-width: 780px;
  }

  @media (max-width: 900px) {
    .alt-hero-grid,
    .alt-card-grid {
      grid-template-columns: 1fr;
    }

    .alt-hero-grid {
      gap: 2rem;
    }

    .alt-copy h1 {
      font-size: clamp(3rem, 13vw, 4.5rem);
      max-width: 11ch;
    }

    .alt-panel {
      aspect-ratio: auto;
      min-height: auto;
      padding: 1.5rem;
    }

    .alt-cta-grid {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 520px) {
    .alt-actions .btn {
      justify-content: center;
      width: 100%;
    }
  }
</style>
