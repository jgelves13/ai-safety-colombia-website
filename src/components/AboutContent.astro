---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';
import Roadmap from './Roadmap.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const icons = {
  community:
    '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20v-1.2A4.3 4.3 0 0 1 7.8 14.5h2.4a4.3 4.3 0 0 1 4.3 4.3V20"/><path d="M16 5.2a3.2 3.2 0 0 1 0 6.1"/><path d="M17.4 14.7A4.3 4.3 0 0 1 20.5 18.8V20"/>',
  learning:
    '<path d="M12 6.5C10.5 5 7.5 4.5 4 5v13c3.5-.5 6.5 0 8 1.5 1.5-1.5 4.5-2 8-1.5V5c-3.5-.5-6.5 0-8 1.5Z"/><path d="M12 6.5v13"/>',
  events:
    '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/>',
};

// Theory-of-change levers mirror the homepage "Qué hacemos" pillars
// (community / learning / events) so both pages tell one story.
const levers = [
  { cls: 'is-green', icon: icons.community, title: t(locale, 'about.toc.community.title'), desc: t(locale, 'about.toc.community.desc') },
  { cls: 'is-coral', icon: icons.learning, title: t(locale, 'about.toc.learning.title'), desc: t(locale, 'about.toc.learning.desc') },
  { cls: 'is-blue', icon: icons.events, title: t(locale, 'about.toc.events.title'), desc: t(locale, 'about.toc.events.desc') },
];

// "Why now" beliefs: the case for the work, before the mission/history.
// Numbered editorial blocks, each with its own Trópico accent.
const beliefs = [
  { num: '01', title: t(locale, 'about.why.b1.title'), body: t(locale, 'about.why.b1.body') },
  { num: '02', title: t(locale, 'about.why.b2.title'), body: t(locale, 'about.why.b2.body') },
  { num: '03', title: t(locale, 'about.why.b3.title'), body: t(locale, 'about.why.b3.body') },
];

const milestones = [
  { year: '2024', label: t(locale, 'about.origin.m1') },
  { year: '2024', label: t(locale, 'about.origin.m2') },
  { year: '2025', label: t(locale, 'about.origin.m3') },
  { year: '2025', label: t(locale, 'about.origin.m4') },
  { year: '2026', label: t(locale, 'about.origin.m5') },
];
---

<section class="section about-mission" aria-labelledby="mission-title">
  <span class="am-shape" aria-hidden="true"></span>
  <div class="container">
    <h2 class="section-label" id="mission-title">{t(locale, 'about.mission.title')}</h2>
    <p class="mission-statement">{t(locale, 'about.mission.body')}</p>
    <p class="mission-support">{t(locale, 'about.mission.support')}</p>

    <div class="why-block">
      <p class="section-label">{t(locale, 'about.why.kicker')}</p>
      <h3 class="section-title why-title" id="why-title">{t(locale, 'about.why.title')}</h3>
      <p class="section-subtitle why-intro">{t(locale, 'about.why.intro')}</p>

      <ol class="beliefs">
        {beliefs.map((b) => (
          <li class="belief">
            <span class="belief-num" aria-hidden="true">{b.num}</span>
            <h4>{b.title}</h4>
            <p>{b.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section class="section alt about-origin" aria-labelledby="origin-title">
  <div class="container">
    <p class="section-label">{t(locale, 'about.origin.kicker')}</p>
    <h2 class="section-title" id="origin-title">{t(locale, 'about.origin.title')}</h2>

    <div class="origin-layout">
      <div class="origin-body">
        <p>{t(locale, 'about.origin.body1')}</p>
        <p set:html={t(locale, 'about.origin.body2')}></p>
        <p>{t(locale, 'about.origin.body3')}</p>
      </div>
      <ol class="timeline">
        {milestones.map((m) => (
          <li class="timeline-item">
            <span class="timeline-year">{m.year}</span>
            <p class="timeline-label">{m.label}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="toc-title">
  <div class="container">
    <h2 class="section-title" id="toc-title">{t(locale, 'about.toc.title')}</h2>
    <p class="section-subtitle">{t(locale, 'about.toc.subtitle')}</p>

    <div class="toc-grid">
      {levers.map((l) => (
        <article class:list={['toc-card', l.cls]}>
          <span class="toc-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={l.icon} />
          </span>
          <h3>{l.title}</h3>
          <p>{l.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<Roadmap locale={locale} />

<section class="section" aria-labelledby="team-title">
  <div class="container">
    <h2 class="section-title" id="team-title">{t(locale, 'about.team.title')}</h2>
    <p class="section-subtitle">{t(locale, 'about.team.subtitle')}</p>

    <div class="people">
      <article class="person-card is-memoriam">
        <div class="person-head">
          <img class="person-photo" src="/people/fernando.jpg" alt={t(locale, 'about.memoriam.name')} width="120" height="150" loading="lazy" />
          <div class="person-id">
            <p class="memoriam-kicker">{t(locale, 'about.memoriam.kicker')}</p>
            <h3 class="person-name">{t(locale, 'about.memoriam.name')}</h3>
            <p class="person-role">{t(locale, 'about.memoriam.role')}</p>
            <p class="person-affil">{t(locale, 'about.memoriam.affiliation')}</p>
          </div>
        </div>
        <p class="person-bio">{t(locale, 'about.memoriam.bio')}</p>
        <p class="memoriam-tribute">{t(locale, 'about.memoriam.tribute')}</p>
      </article>
      <article class="person-card">
        <div class="person-head">
          <img class="person-photo" src="/people/jose.jpg" alt={t(locale, 'about.team.name')} width="120" height="150" loading="lazy" />
          <div class="person-id">
            <h3 class="person-name">{t(locale, 'about.team.name')}</h3>
            <p class="person-role">{t(locale, 'about.team.role')}</p>
            <p class="person-affil">{t(locale, 'about.team.affiliation')}</p>
          </div>
        </div>
        <p class="person-bio">{t(locale, 'about.team.bio')}</p>
        <div class="person-contact">
          <a class="person-link" href="https://www.linkedin.com/in/josegelves/" target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn — ${t(locale, 'about.team.name')}`}>
            <svg class="linkedin-mark" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="4" fill="#0A66C2"/><path fill="#fff" d="M7.119 20.452H3.555V9h3.564v11.452zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286z"/></svg>
            <span>LinkedIn</span>
          </a>
          <a class="person-link" href="mailto:jose@aisafetycolombia.org" aria-label={`Email — ${t(locale, 'about.team.name')}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <span>jose@aisafetycolombia.org</span>
          </a>
        </div>
      </article>
      <article class="person-card">
        <div class="person-head">
          <img class="person-photo" src="/people/leonardo.jpg" alt={t(locale, 'about.team2.name')} width="120" height="150" loading="lazy" />
          <div class="person-id">
            <h3 class="person-name">{t(locale, 'about.team2.name')}</h3>
            <p class="person-role">{t(locale, 'about.team2.role')}</p>
            <p class="person-affil">{t(locale, 'about.team2.affiliation')}</p>
          </div>
        </div>
        <p class="person-bio" set:html={t(locale, 'about.team2.bio')}></p>
        <div class="person-contact">
          <a class="person-link" href="https://www.linkedin.com/in/leonardoparraga/" target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn — ${t(locale, 'about.team2.name')}`}>
            <svg class="linkedin-mark" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="4" fill="#0A66C2"/><path fill="#fff" d="M7.119 20.452H3.555V9h3.564v11.452zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286z"/></svg>
            <span>LinkedIn</span>
          </a>
          <a class="person-link" href="mailto:leo@aisafetycolombia.org" aria-label={`Email — ${t(locale, 'about.team2.name')}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <span>leo@aisafetycolombia.org</span>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="section alt about-cta" aria-labelledby="about-cta-title">
  <div class="container">
    <h2 class="section-title" id="about-cta-title">{t(locale, 'about.cta.title')}</h2>
    <p class="section-subtitle">{t(locale, 'about.cta.sub')}</p>
    <div class="about-cta-actions">
      <a class="btn btn-primary" href={localePath(locale, '/grupos/')}>{t(locale, 'about.cta.involve')}</a>
      <a class="btn btn-secondary" href={localePath(locale, '/recursos/')}>{t(locale, 'about.cta.resources')}</a>
    </div>
  </div>
</section>

<style>
  /* The mission opens the page as a bold statement: a coral kicker,
     one large display-type sentence, a quieter support line, and a
     yellow ring bleeding off the right edge for a Trópico accent. */
  .about-mission {
    position: relative;
    overflow: hidden;
  }

  .about-mission .container {
    position: relative;
    z-index: 1;
  }

  .about-mission .section-label {
    margin-bottom: 1.25rem;
  }

  .am-shape {
    position: absolute;
    width: 240px;
    height: 240px;
    top: 3.5rem;
    right: -80px;
    border: 22px solid var(--accent-yellow);
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
  }

  .mission-statement {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--text-primary);
    max-width: 20ch;
    margin-bottom: 1.4rem;
  }

  .mission-support {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* "Why now" lives inside the mission section, separated by a hairline.
     The three beliefs read left to right across one row, each a vertical
     stack: an accent numeral, the claim, and a supporting line. */
  .why-block {
    margin-top: 3.25rem;
    padding-top: 2.75rem;
    border-top: 1px solid var(--border);
  }

  .why-block .section-label {
    margin-bottom: 0.7rem;
  }

  .why-title {
    margin-bottom: 0.9rem;
  }

  .why-intro {
    max-width: none;
  }

  .beliefs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .belief {
    text-align: left;
  }

  .belief-num {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent-vermillion);
    margin-bottom: 0.7rem;
  }

  .belief:nth-child(2) .belief-num { color: var(--accent-forest); }
  .belief:nth-child(3) .belief-num { color: var(--accent-sage); }

  .belief h4 {
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .belief p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* The origin story pairs a narrative column with a compact
     vertical timeline of milestones. */
  .about-origin .section-label {
    margin-bottom: 0.9rem;
  }

  .about-origin .section-title {
    margin-bottom: 2.5rem;
  }

  .origin-layout {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  .origin-body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .origin-body p {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .origin-body a {
    color: var(--text-primary);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent-forest);
    transition: text-decoration-color 0.15s ease, color 0.15s ease;
  }

  .origin-body a:hover {
    color: var(--accent-forest);
    text-decoration-color: currentColor;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline-item {
    position: relative;
    padding: 0 0 1.6rem 1.6rem;
    border-left: 2px solid var(--border);
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 0.1rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent-vermillion);
    border: 2px solid var(--bg-secondary);
  }

  .timeline-year {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent-forest);
    margin-bottom: 0.25rem;
  }

  .timeline-label {
    font-size: 0.9375rem;
    color: var(--text-primary);
    line-height: 1.5;
  }

  /* Theory of change as three reinforcing levers, mirroring the
     homepage "Qué hacemos" card grid: accent-tinted icon chip,
     heading, description, subtle hover lift. */
  .toc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .section-subtitle {
    margin-bottom: 2.5rem;
  }

  .toc-card {
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s;
  }

  .toc-card:hover {
    border-color: var(--text-primary);
  }

  .toc-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid currentColor;
    margin-bottom: 1.25rem;
  }

  .toc-icon svg {
    width: 26px;
    height: 26px;
  }

  .is-green .toc-icon { color: var(--accent-forest); }
  .is-coral .toc-icon { color: var(--accent-vermillion); }
  .is-blue  .toc-icon { color: var(--accent-sage); }

  .toc-card h3 {
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .toc-card p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Fernando and Jose are peers, side by side: a two-column grid,
     top-aligned, each card a clean profile header (photo + identity)
     then bio, then remembrance. */
  .people {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
    max-width: 1120px;
  }

  .person-card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 1.75rem 2rem;
  }

  /* The memorial card carries a forest-tinted surface and a forest
     accent bar at the top — set apart from Jose's elevated card while
     staying inside the Trópico vocabulary. */
  .person-card.is-memoriam {
    background: color-mix(in srgb, var(--accent-forest) 8%, var(--bg-primary));
    border-color: color-mix(in srgb, var(--accent-forest) 35%, var(--border));
    border-top: 4px solid var(--accent-forest);
  }

  .person-head {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .person-photo {
    width: 96px;
    height: 120px;
    flex: none;
    object-fit: cover;
    border-radius: 14px;
    background: var(--bg-secondary);
    display: block;
  }

  .person-id {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .memoriam-kicker {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-forest);
    margin-bottom: 0.15rem;
  }

  .person-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .person-role {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .person-affil {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .person-bio {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .person-bio a {
    color: var(--accent-vermillion);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  .person-bio a:hover,
  .person-bio a:focus-visible {
    text-decoration-thickness: 2px;
  }

  /* Contact row pinned to the bottom of each card so the three cards
     keep their LinkedIn/email aligned despite uneven bio lengths. */
  .person-contact {
    margin-top: auto;
    padding-top: 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .person-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
    word-break: break-word;
  }

  .person-link svg {
    width: 16px;
    height: 16px;
    flex: none;
    color: var(--accent-vermillion);
  }

  .person-link:hover,
  .person-link:focus-visible {
    color: var(--accent-vermillion);
  }

  /* The tribute is a remembrance set apart from the factual bio:
     a forest hairline divides it from the rest of the card. */
  .memoriam-tribute {
    font-size: 0.9375rem;
    color: var(--text-primary);
    line-height: 1.65;
    padding-top: 1rem;
    border-top: 1px solid var(--accent-forest);
  }

  .about-cta .container {
    text-align: center;
  }

  .about-cta .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .about-cta-actions {
    display: flex;
    gap: 0.875rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .origin-layout {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .beliefs {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  @media (max-width: 768px) {
    .people {
      grid-template-columns: 1fr;
      max-width: 680px;
    }
    .person-card {
      padding: 1.5rem;
    }
    .am-shape {
      width: 170px;
      height: 170px;
      right: -70px;
      border-width: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-card,
    .toc-card:hover { transition: none; }
  }
</style>
