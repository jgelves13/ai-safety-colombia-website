---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const rows = [
  { cls: 'is-green', title: t(locale, 'what-we-do.research.title'), desc: t(locale, 'what-we-do.research.desc') },
  { cls: 'is-coral', title: t(locale, 'what-we-do.education.title'), desc: t(locale, 'what-we-do.education.desc') },
  { cls: 'is-blue', title: t(locale, 'what-we-do.community.title'), desc: t(locale, 'what-we-do.community.desc') },
];
---

<section class="section alt" aria-labelledby="wwd-title">
  <div class="container">
    <h2 class="section-title" id="wwd-title">{t(locale, 'sections.what-we-do')}</h2>
    <p class="section-subtitle">{t(locale, 'what-we-do.subtitle')}</p>

    <div class="wwd-grid">
      {rows.map((row, i) => (
        <article class:list={['wwd-card', row.cls]}>
          <span class="wwd-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{row.title}</h3>
          <p>{row.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-subtitle {
    margin-bottom: 2.5rem;
  }

  .wwd-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .wwd-card {
    border-radius: 22px;
    padding: 2.3rem 2.1rem 2.4rem;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: transform 0.15s;
  }

  .wwd-card:hover {
    transform: translateY(-3px);
  }

  /* solid color blocks */
  .wwd-card.is-green { background: var(--accent-forest); color: var(--bg-elevated); }
  .wwd-card.is-coral { background: var(--accent-vermillion); color: var(--text-primary); }
  .wwd-card.is-blue  { background: var(--accent-yellow); color: var(--text-primary); }

  .wwd-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 3.4rem;
    line-height: 1;
    letter-spacing: -0.04em;
    opacity: 0.32;
    margin-bottom: 0.5rem;
  }

  .wwd-card h3 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: currentColor;
    margin-bottom: 0.5rem;
  }

  .wwd-card p {
    font-size: 0.9375rem;
    color: currentColor;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .wwd-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wwd-card { transition: none; }
    .wwd-card:hover { transform: none; }
  }
</style>
