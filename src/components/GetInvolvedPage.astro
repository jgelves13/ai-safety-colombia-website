---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';
import PageHero from './PageHero.astro';
import CoursesPage from './CoursesPage.astro';
import data from '../data/getInvolved.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

const WHATSAPP_URL = 'https://chat.whatsapp.com/KwE8cciX48TAVhAOHnrLaZ';

type Action = {
  accent: string;
  titleEs: string;
  titleEn: string;
  descEs: string;
  descEn: string;
  ext?: string;
  path?: string;
  anchor?: string;
};

const resolve = (a: Action) => {
  if (a.ext) return { href: a.ext, external: true };
  if (a.anchor) return { href: a.anchor, external: false };
  return { href: localePath(locale, a.path ?? '/'), external: false };
};
---

<PageHero
  title={t(locale, 'getInvolved.hero.title')}
  desc={t(locale, 'getInvolved.hero.subtitle')}
/>

<section class="section">
  <div class="container">
    <div class="ways-grid">
      {(data.actions as Action[]).map((a) => {
        const { href, external } = resolve(a);
        return (
          <a
            class={`way-card ${a.accent}`}
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
          >
            <div class="way-bar"></div>
            <div class="way-tx">
              <h3 class="way-title">{es ? a.titleEs : a.titleEn}</h3>
              <p class="way-desc">{es ? a.descEs : a.descEn}</p>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<CoursesPage locale={locale} embedded />

<section class="section">
  <div class="container">
    <div class="ways-cta featured-block">
      <span class="ways-cta-ring" aria-hidden="true"></span>
      <span class="section-label">{t(locale, 'getInvolved.ctaKicker')}</span>
      <h2 class="section-title">{t(locale, 'getInvolved.ctaTitle')}</h2>
      <p class="ways-cta-sub">{t(locale, 'getInvolved.ctaSub')}</p>
      <div class="ways-cta-buttons">
        <a
          class="btn ways-cta-solid"
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
        >{t(locale, 'getInvolved.ctaPrimary')}</a>
        <a class="btn ways-cta-ghost" href={localePath(locale, '/contacto/')}>
          {t(locale, 'getInvolved.ctaContact')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ways-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .way-card {
    display: flex;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 1.75rem;
    background: var(--card-surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .way-card:hover {
    border-color: var(--text-primary);
    transform: translateY(-2px);
  }

  .way-bar {
    width: 5px;
    flex: none;
    border-radius: 999px;
    background: var(--accent-forest);
  }

  .way-card.is-coral .way-bar { background: var(--accent-vermillion); }
  .way-card.is-blue .way-bar { background: var(--accent-sage); }
  .way-card.is-yellow .way-bar { background: var(--accent-yellow); }

  .way-tx {
    min-width: 0;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .way-title {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .way-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 0.375rem;
  }

  /* Closing CTA — solid-green Trópico featured block */
  .ways-cta {
    border-radius: 28px;
    padding: 3.75rem 2rem;
    text-align: center;
  }

  /* second decorative shape — a green ring bleeding off the lower-right */
  .ways-cta-ring {
    position: absolute;
    width: 190px;
    height: 190px;
    border: 22px solid var(--accent-sage);
    border-radius: 50%;
    bottom: -85px;
    right: -55px;
    opacity: 0.5;
    z-index: 0;
    pointer-events: none;
  }

  .ways-cta .section-label {
    margin-bottom: 1.25rem;
  }

  .ways-cta .section-title {
    max-width: 20ch;
    margin: 0 auto 0.75rem;
  }

  .ways-cta-sub {
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 460px;
    margin: 0 auto 1.875rem;
  }

  .ways-cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Buttons that read on the green block */
  .ways-cta-solid {
    background: var(--bg-elevated);
    color: var(--accent-forest);
    border-color: var(--bg-elevated);
  }

  .ways-cta-solid:hover {
    background: var(--accent-yellow);
    border-color: var(--accent-yellow);
    color: var(--text-primary);
  }

  .ways-cta-ghost {
    background: transparent;
    color: var(--bg-elevated);
    border-color: var(--bg-elevated);
  }

  .ways-cta-ghost:hover {
    background: var(--bg-elevated);
    color: var(--accent-forest);
  }

  @media (prefers-reduced-motion: reduce) {
    .way-card,
    .way-card:hover {
      transition: none;
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .ways-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
