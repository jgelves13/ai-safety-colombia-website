---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const logos = import.meta.glob<ImageMetadata>('../assets/resources/*', {
  eager: true,
  import: 'default',
});

const icons = {
  fundamentals:
    '<path d="M12 6.5C10.5 5 7.5 4.5 4 5v13c3.5-.5 6.5 0 8 1.5 1.5-1.5 4.5-2 8-1.5V5c-3.5-.5-6.5 0-8 1.5Z"/><path d="M12 6.5v13"/>',
  research:
    '<path d="M9 2h6M10 2v6.6L4.8 18a2 2 0 0 0 1.7 3h11a2 2 0 0 0 1.7-3L14 8.6V2"/><path d="M7.5 14.5h9"/>',
  governance:
    '<path d="M12 3v17M7 20h10M5 7h14"/><path d="M8 7 5 14h6L8 7ZM16 7l-3 7h6l-3-7Z"/>',
};

interface ResLink {
  name: string;
  source: string;
  url: string;
  img?: string;
  mono?: string;
}

const paths: {
  cls: string;
  icon: string;
  title: string;
  desc: string;
  links: ResLink[];
}[] = [
  {
    cls: 'is-green',
    icon: icons.fundamentals,
    title: t(locale, 'resources.fundamentals.title'),
    desc: t(locale, 'resources.fundamentals.desc'),
    links: [
      {
        name: 'AGI Safety Fundamentals',
        source: 'BlueDot Impact',
        url: 'https://aisafetyfundamentals.com/',
        img: 'bluedot.png',
      },
      {
        name: 'Intro to AI Safety',
        source: 'Robert Miles · YouTube',
        url: 'https://www.youtube.com/@RobertMilesAI',
        img: 'robert-miles.png',
      },
      {
        name: 'The Alignment Problem',
        source: 'Brian Christian',
        url: 'https://brianchristian.org/the-alignment-problem/',
        img: 'alignment-problem.png',
      },
    ],
  },
  {
    cls: 'is-coral',
    icon: icons.research,
    title: t(locale, 'resources.research.title'),
    desc: t(locale, 'resources.research.desc'),
    links: [
      {
        name: 'Alignment Forum',
        source: 'alignmentforum.org',
        url: 'https://www.alignmentforum.org/',
        mono: 'AF',
      },
      {
        name: 'AI Safety Papers',
        source: 'Apart Research',
        url: 'https://apartresearch.com',
        img: 'apart.png',
      },
      {
        name: 'MIRI Research',
        source: 'Machine Intelligence Research Institute',
        url: 'https://intelligence.org/research/',
        img: 'miri.png',
      },
    ],
  },
  {
    cls: 'is-blue',
    icon: icons.governance,
    title: t(locale, 'resources.governance.title'),
    desc: t(locale, 'resources.governance.desc'),
    links: [
      {
        name: 'AI Governance Research',
        source: 'GovAI',
        url: 'https://www.governance.ai/',
        img: 'govai.png',
      },
      {
        name: 'Statement on AI Risk',
        source: 'Center for AI Safety',
        url: 'https://www.safe.ai/statement-on-ai-risk',
        img: 'cais.png',
      },
      {
        name: 'Colombia AI Framework',
        source: 'CONPES 4144 · DNP',
        url: 'https://colaboracion.dnp.gov.co/CDT/Conpes/Econ%C3%B3micos/4144.pdf',
        img: 'conpes.png',
      },
    ],
  },
];
---

<section class="section" aria-labelledby="resources-title">
  <div class="container">
    <h2 class="section-title" id="resources-title">{t(locale, 'resources.title')}</h2>
    <p class="section-subtitle">{t(locale, 'resources.subtitle')}</p>

    <div class="res-grid">
      {paths.map((path) => (
        <article class:list={['res-card', path.cls]}>
          <span class="res-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={path.icon} />
          </span>
          <h3>{path.title}</h3>
          <p class="res-desc">{path.desc}</p>
          <ul class="res-items">
            {path.links.map((item) => (
              <li>
                <a class="res-item" href={item.url} target="_blank" rel="noopener noreferrer">
                  <span class="res-thumb" aria-hidden="true">
                    {item.img && logos[`../assets/resources/${item.img}`] ? (
                      <Image
                        src={logos[`../assets/resources/${item.img}`]}
                        alt=""
                        width={128}
                        height={128}
                        loading="lazy"
                      />
                    ) : (
                      <span class="res-mono">{item.mono}</span>
                    )}
                  </span>
                  <span class="res-item-body">
                    <span class="res-item-name">{item.name}</span>
                    <span class="res-item-src">{item.source}</span>
                  </span>
                  <span class="res-item-go" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section alt res-cta" aria-labelledby="res-cta-title">
  <div class="container">
    <h2 class="section-title" id="res-cta-title">{t(locale, 'resources.cta.title')}</h2>
    <p class="section-subtitle">{t(locale, 'resources.cta.sub')}</p>
    <div class="res-cta-actions">
      <a class="btn btn-primary" href={`${localePath(locale, '/involucrate/')}#grupos`}>{t(locale, 'resources.cta.cta')}</a>
    </div>
  </div>
</section>

<style>
  .section-subtitle {
    margin-bottom: 2.5rem;
  }

  /* Learning paths as accent-tinted cards, mirroring the homepage
     "Qué hacemos" and About "Teoría de cambio" grid: icon chip,
     heading, one-line description, then the curated resources as
     image-led rows (logo tile + name + source). */
  .res-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .res-card {
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s;
  }

  .res-card:hover {
    border-color: var(--text-primary);
  }

  .res-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid currentColor;
    margin-bottom: 1.25rem;
  }

  .res-icon svg {
    width: 26px;
    height: 26px;
  }

  .is-green .res-icon { color: var(--accent-forest); }
  .is-coral .res-icon { color: var(--accent-vermillion); }
  .is-blue  .res-icon { color: var(--accent-sage); }

  .res-card h3 {
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .res-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .res-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  /* Image-led resource row, adapted from the AE Bogotá resources
     org-card: logo tile on the left, name + source, hover arrow. */
  .res-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-primary);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .res-item:hover {
    border-color: var(--text-primary);
    transform: translateX(2px);
  }

  .res-thumb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 10px;
    padding: 6px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .res-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .res-mono {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
  }

  .is-coral .res-mono { color: var(--accent-vermillion-dark); }

  .res-item-body {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
    flex: 1;
  }

  .res-item-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .res-item-src {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.3;
  }

  .res-item-go {
    color: var(--accent-forest);
    font-weight: 600;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s, transform 0.2s;
  }

  .res-item:hover .res-item-go {
    opacity: 1;
    transform: translateX(0);
  }

  .res-cta .container {
    text-align: center;
  }

  .res-cta .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .res-cta-actions {
    display: flex;
    gap: 0.875rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .res-card,
    .res-item,
    .res-item-go { transition: none; }
    .res-card:hover,
    .res-item:hover { transform: none; }
    .res-item:hover .res-item-go { transform: none; }
  }
</style>
