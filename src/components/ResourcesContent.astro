---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, localePath, type Locale } from '../i18n/ui';
import learnData from '../data/learn.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

type Key = Parameters<typeof t>[1];

const logos = import.meta.glob<ImageMetadata>('../assets/resources/*', {
  eager: true,
  import: 'default',
});

const learnThumbs = import.meta.glob<ImageMetadata>('../assets/learn/*', {
  eager: true,
  import: 'default',
});

// Featured cards: grouped by format (videos, courses, readings, podcasts,
// books). Each card reuses the homepage "Empieza aquí" learn-card UI so
// visitors hitting "See all resources" land on a continuous experience.
// One unified thumbnail treatment: image with object-fit: contain over an
// accent-tinted 16:9 tile, so wide hero screenshots, square brand marks,
// and tall book covers all sit consistently inside the same canvas.
type Kind = 'video' | 'course' | 'read' | 'podcast' | 'book';
type Accent = 'is-coral' | 'is-blue' | 'is-green' | 'is-yellow';

interface FeatItem {
  kind: Kind;
  accent: Accent;
  title: string;
  source: string;
  desc: string;
  duration: string;
  meta: string;
  url: string;
  thumb: ImageMetadata;
}

const fromLearn: FeatItem[] = learnData.map((i) => ({
  kind: i.kind as Kind,
  accent: i.accent as Accent,
  title: es ? i.titleEs : i.titleEn,
  source: es ? i.sourceEs : i.sourceEn,
  desc: es ? i.descEs : i.descEn,
  duration: es ? i.durationEs : i.durationEn,
  meta: es ? i.metaEs : i.metaEn,
  url: i.url,
  thumb: learnThumbs[`../assets/learn/${i.thumb}`],
}));

const introCourse = fromLearn.find((i) => i.kind === 'course')!;
const introRead = fromLearn.find((i) => i.kind === 'read')!;

const videos: FeatItem[] = [
  {
    kind: 'video',
    accent: 'is-coral',
    title: es ? 'Canal de Robert Miles' : 'Robert Miles channel',
    source: 'Robert Miles AI Safety',
    desc: es
      ? 'La biblioteca de referencia en video sobre alineación, control y los retos abiertos en seguridad de IA, presentada con rigor y sin requisitos técnicos.'
      : 'The reference video library on alignment, control, and the open problems in AI safety, presented rigorously and with no technical prerequisites.',
    duration: es ? 'Canal · gratis' : 'Channel · free',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://www.youtube.com/@RobertMilesAI/videos',
    thumb: logos['../assets/resources/robert-miles.png'],
  },
  {
    kind: 'video',
    accent: 'is-coral',
    title: 'Rational Animations',
    source: 'YouTube',
    desc: es
      ? 'Un canal de animaciones que adapta ensayos clásicos sobre IA, racionalidad y riesgo existencial a un formato visual cuidado.'
      : 'An animation channel adapting classic essays on AI, rationality, and existential risk into a polished visual format.',
    duration: es ? 'Canal · gratis' : 'Channel · free',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://www.youtube.com/@RationalAnimations',
    thumb: logos['../assets/resources/rational-animations.png'],
  },
];

const courses: FeatItem[] = [
  introCourse,
  {
    kind: 'course',
    accent: 'is-blue',
    title: 'AGI Safety Course',
    source: 'Google DeepMind',
    desc: es
      ? 'Un curso corto del equipo de seguridad de DeepMind sobre los riesgos de la IA de nivel humano y cómo se está abordando la alineación.'
      : "A short course from DeepMind's safety team on the risks from human-level AI and how alignment is being approached today.",
    duration: es ? 'Curso corto · gratis' : 'Short course · free',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://deepmindsafetyresearch.medium.com/introducing-our-short-course-on-agi-safety-1072adb7912c',
    thumb: logos['../assets/resources/deepmind.png'],
  },
  {
    kind: 'course',
    accent: 'is-blue',
    title: 'ARENA',
    source: es ? 'Acelerador para Ingenieros de Investigación' : 'Research Engineer Accelerator',
    desc: es
      ? 'Currículo intensivo de cinco semanas sobre interpretabilidad, evaluaciones y RL para personas que ya programan en PyTorch.'
      : 'A five-week intensive curriculum on interpretability, evaluations, and RL for people already comfortable with PyTorch.',
    duration: es ? '5 semanas · gratis' : '5 weeks · free',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://www.arena.education/curriculum',
    thumb: logos['../assets/resources/arena.png'],
  },
  {
    kind: 'course',
    accent: 'is-blue',
    title: 'AI Safety, Ethics & Society',
    source: 'Center for AI Safety',
    desc: es
      ? 'Libro de texto y curso abierto del CAIS que cubre los riesgos catastróficos de la IA y los marcos éticos para enfrentarlos.'
      : "CAIS's open textbook and course covering the catastrophic risks from AI and the ethical frameworks for addressing them.",
    duration: es ? 'Libro · curso · gratis' : 'Textbook · course · free',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://www.aisafetybook.com/',
    thumb: logos['../assets/resources/cais.png'],
  },
];

const readings: FeatItem[] = [
  introRead,
  {
    kind: 'read',
    accent: 'is-green',
    title: 'AGI Safety from First Principles',
    source: 'Richard Ngo',
    desc: es
      ? 'Una secuencia fundacional que reconstruye el caso por el riesgo de la IA general desde cero, sin presuponer literatura previa.'
      : 'A foundational sequence rebuilding the case for AGI risk from scratch, without assuming any prior literature.',
    duration: es ? 'Secuencia' : 'Sequence',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://www.alignmentforum.org/s/mzgtmmTKKn5MuCzFJ',
    thumb: logos['../assets/resources/alignment-forum.png'],
  },
  {
    kind: 'read',
    accent: 'is-green',
    title: 'Concrete Problems in AI Safety',
    source: 'Amodei et al. · 2016',
    desc: es
      ? 'El artículo seminal que catalogó los problemas técnicos abiertos en seguridad de IA y definió la agenda de investigación de la década.'
      : "The seminal paper that catalogued the open technical problems in AI safety and set the field's research agenda for a decade.",
    duration: es ? 'Artículo' : 'Paper',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://arxiv.org/abs/1606.06565',
    thumb: logos['../assets/resources/arxiv.jpg'],
  },
  {
    kind: 'read',
    accent: 'is-green',
    title: 'Frontier AI Regulation',
    source: 'Anderljung et al. · 2023',
    desc: es
      ? 'La propuesta de referencia sobre cómo regular los modelos de IA de frontera: evaluaciones previas, licencias y obligaciones de seguridad para los desarrolladores.'
      : 'The reference proposal for regulating frontier AI models: pre-deployment evaluations, licensing, and safety obligations for developers.',
    duration: es ? 'Artículo' : 'Paper',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://arxiv.org/abs/2307.03718',
    thumb: logos['../assets/resources/arxiv.jpg'],
  },
  {
    kind: 'read',
    accent: 'is-green',
    title: 'Core Views on AI Safety',
    source: 'Anthropic',
    desc: es
      ? 'La declaración de Anthropic sobre por qué la seguridad de la IA es urgente y cómo el laboratorio piensa abordarla en la práctica.'
      : "Anthropic's statement on why AI safety is urgent and how the lab plans to address it in practice.",
    duration: es ? 'Ensayo' : 'Essay',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://www.anthropic.com/news/core-views-on-ai-safety',
    thumb: logos['../assets/resources/anthropic-core-views.png'],
  },
];

const podcasts: FeatItem[] = [
  {
    kind: 'podcast',
    accent: 'is-yellow',
    title: 'AXRP',
    source: 'Daniel Filan',
    desc: es
      ? 'El podcast de referencia en investigación técnica de alineación: entrevistas extensas con investigadores activos sobre sus artículos.'
      : 'The reference podcast for technical alignment research: long-form interviews with active researchers about their papers.',
    duration: es ? 'Podcast · gratis' : 'Podcast · free',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://axrp.net/',
    thumb: logos['../assets/resources/axrp.jpg'],
  },
  {
    kind: 'podcast',
    accent: 'is-yellow',
    title: 'The 80,000 Hours Podcast',
    source: '80,000 Hours',
    desc: es
      ? 'Conversaciones largas con investigadores, fundadores y formuladores de política de IA sobre cómo orientar una carrera al impacto.'
      : 'Long-form conversations with AI researchers, founders, and policy-makers on how to orient a career toward impact.',
    duration: es ? 'Podcast · gratis' : 'Podcast · free',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://80000hours.org/podcast/',
    thumb: logos['../assets/resources/80k-podcast.jpg'],
  },
  {
    kind: 'podcast',
    accent: 'is-yellow',
    title: 'The Inside View',
    source: 'Michaël Trazzi',
    desc: es
      ? 'Entrevistas a profundidad con investigadores y formuladores de política sobre los riesgos, la gobernanza y el futuro cercano de la IA.'
      : 'In-depth interviews with researchers and policy-makers on the risks, governance, and near-term future of AI.',
    duration: es ? 'Podcast · gratis' : 'Podcast · free',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://theinsideview.ai/',
    thumb: logos['../assets/resources/inside-view.png'],
  },
];

const books: FeatItem[] = [
  {
    kind: 'book',
    accent: 'is-green',
    title: 'The Alignment Problem',
    source: 'Brian Christian',
    desc: es
      ? 'Una narración accesible de los problemas centrales para alinear la IA con valores humanos, contada a través de los investigadores que los enfrentan.'
      : 'An accessible narrative of the core problems in aligning AI with human values, told through the researchers facing them.',
    duration: es ? 'Libro' : 'Book',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://brianchristian.org/the-alignment-problem/',
    thumb: logos['../assets/resources/alignment-problem.png'],
  },
  {
    kind: 'book',
    accent: 'is-green',
    title: 'Human Compatible',
    source: 'Stuart Russell',
    desc: es
      ? 'El argumento de uno de los pioneros del campo para redefinir la inteligencia artificial alrededor de la incertidumbre sobre los valores humanos.'
      : "The argument from one of the field's pioneers for redefining AI around uncertainty about human values.",
    duration: es ? 'Libro' : 'Book',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://people.eecs.berkeley.edu/~russell/hc.html',
    thumb: logos['../assets/resources/human-compatible.jpg'],
  },
  {
    kind: 'book',
    accent: 'is-green',
    title: 'Superintelligence',
    source: 'Nick Bostrom',
    desc: es
      ? 'El libro que llevó el debate sobre los riesgos de la IA general al debate público y definió buena parte del vocabulario que usamos hoy.'
      : 'The book that brought the debate about AGI risk into the public sphere and shaped much of the vocabulary the field uses today.',
    duration: es ? 'Libro' : 'Book',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://www.nickbostrom.com/superintelligence',
    thumb: logos['../assets/resources/superintelligence.jpg'],
  },
  {
    kind: 'book',
    accent: 'is-green',
    title: 'If Anyone Builds It, Everyone Dies',
    source: 'Yudkowsky & Soares · 2025',
    desc: es
      ? 'El caso más directo publicado hasta ahora sobre por qué construir una IA superinteligente, con las técnicas actuales, terminaría mal para todos.'
      : 'The most direct case yet published for why building superintelligent AI with current techniques would end badly for everyone.',
    duration: es ? 'Libro' : 'Book',
    meta: es ? 'En inglés' : 'In English',
    url: 'https://ifanyonebuildsit.com/',
    thumb: logos['../assets/resources/if-anyone-builds-it.png'],
  },
];

const featuredGroups: {
  label: string;
  items: (FeatItem & { kindLabel: string; cta: string })[];
}[] = [
  { label: t(locale, 'resources.featured.videos'), items: videos },
  { label: t(locale, 'resources.featured.courses'), items: courses },
  { label: t(locale, 'resources.featured.readings'), items: readings },
  { label: t(locale, 'resources.featured.podcasts'), items: podcasts },
  { label: t(locale, 'resources.featured.books'), items: books },
].map((g) => ({
  label: g.label,
  items: g.items.map((i) => ({
    ...i,
    kindLabel: t(locale, `learn.kind.${i.kind}` as Key),
    cta: t(locale, `learn.cta.${i.kind}` as Key),
  })),
}));

// "Explore the whole ecosystem" panel — links into aisafety.com, the
// community-maintained directory (the curated cards above are our
// hand-picked starting points; this is the full field).
const hubIcons = {
  communities:
    '<circle cx="9" cy="8.5" r="3.1"/><path d="M3.6 19.4c0-3 2.4-5.2 5.4-5.2s5.4 2.2 5.4 5.2"/><path d="M16.2 5.6a3.1 3.1 0 0 1 0 6"/><path d="M17.6 14.5c2.3.5 4 2.5 4 4.9"/>',
  selfStudy:
    '<path d="M12 4 2 9l10 5 10-5-10-5Z"/><path d="M6 11.4V16c0 1.6 2.7 3 6 3s6-1.4 6-3v-4.6"/>',
  jobs:
    '<rect x="3" y="7.5" width="18" height="12" rx="2.2"/><path d="M8.5 7.5V6A2.5 2.5 0 0 1 11 3.5h2A2.5 2.5 0 0 1 15.5 6v1.5"/><path d="M3 12.6h18"/>',
  advisors:
    '<path d="M21 11.4a8.4 8.4 0 0 1-12.1 7.6L3 20.8l1.8-5.8A8.4 8.4 0 1 1 21 11.4Z"/><path d="M8.6 11.4h.01M12 11.4h.01M15.4 11.4h.01"/>',
};

const hubLinks: { name: string; desc: string; url: string; icon: string }[] = [
  {
    name: t(locale, 'resources.hub.communities'),
    desc: t(locale, 'resources.hub.communitiesDesc'),
    url: 'https://aisafety.com/communities',
    icon: hubIcons.communities,
  },
  {
    name: t(locale, 'resources.hub.selfStudy'),
    desc: t(locale, 'resources.hub.selfStudyDesc'),
    url: 'https://aisafety.com/self-study',
    icon: hubIcons.selfStudy,
  },
  {
    name: t(locale, 'resources.hub.jobs'),
    desc: t(locale, 'resources.hub.jobsDesc'),
    url: 'https://aisafety.com/jobs',
    icon: hubIcons.jobs,
  },
  {
    name: t(locale, 'resources.hub.advisors'),
    desc: t(locale, 'resources.hub.advisorsDesc'),
    url: 'https://aisafety.com/advisors',
    icon: hubIcons.advisors,
  },
];
---

<section class="section res-featured" aria-labelledby="res-featured-title">
  <div class="container">
    <h2 class="section-title" id="res-featured-title">{t(locale, 'resources.featured.title')}</h2>
    <p class="section-subtitle">{t(locale, 'resources.featured.subtitle')}</p>

    {featuredGroups.map((group) => (
      <div class="kind-block">
        <h3 class="kind-label">{group.label}</h3>
        <div class="learn-grid">
          {group.items.map((i) => (
            <article class:list={['learn-card', i.accent]}>
              <div class="learn-thumb" aria-hidden="true">
                <Image
                  src={i.thumb}
                  alt=""
                  widths={[220, 360, 540]}
                  sizes="(max-width: 560px) 100vw, 360px"
                  format="webp"
                  loading="lazy"
                  class="learn-img"
                />
                <span class="learn-duration">{i.duration}</span>
              </div>
              <div class="learn-body">
                <span class="learn-kind">{i.kindLabel}</span>
                <h3>{i.title}</h3>
                <p class="learn-source">{i.source}</p>
                <p class="learn-desc">{i.desc}</p>
                <p class="learn-meta">{i.meta}</p>
                <a href={i.url} target="_blank" rel="noopener noreferrer" class="learn-link">
                  {i.cta}
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<section class="section" aria-labelledby="res-hub-title">
  <div class="container">
    <div class="res-hub">
      <span class="res-hub-glow" aria-hidden="true"></span>
      <div class="res-hub-intro">
        <span class="section-label">{t(locale, 'resources.hub.kicker')}</span>
        <h2 class="section-title" id="res-hub-title">{t(locale, 'resources.hub.title')}</h2>
        <p class="res-hub-desc">{t(locale, 'resources.hub.desc')}</p>
        <a class="btn btn-primary" href="https://aisafety.com/map" target="_blank" rel="noopener noreferrer">
          {t(locale, 'resources.hub.mapCta')}
        </a>
      </div>
      <ul class="res-hub-links">
        {hubLinks.map((link) => (
          <li>
            <a class="res-item" href={link.url} target="_blank" rel="noopener noreferrer">
              <span class="res-thumb res-thumb-ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={link.icon} />
              </span>
              <span class="res-item-body">
                <span class="res-item-name">{link.name}</span>
                <span class="res-item-src">{link.desc}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="section alt res-cta" aria-labelledby="res-cta-title">
  <div class="container">
    <h2 class="section-title" id="res-cta-title">{t(locale, 'resources.cta.title')}</h2>
    <p class="section-subtitle">{t(locale, 'resources.cta.sub')}</p>
    <div class="res-cta-actions">
      <a class="btn btn-primary" href={`${localePath(locale, '/involucrate/')}#grupos`}>{t(locale, 'resources.cta.cta')}</a>
    </div>
  </div>
</section>

<style>
  .section-subtitle {
    margin-bottom: 2.5rem;
  }

  .res-featured .section-subtitle {
    max-width: none;
  }

  /* Featured cards reuse the homepage "Empieza aquí" treatment so visitors
     hitting "See all resources" land on a continuous experience. They
     are grouped by format (videos, courses, readings, podcasts, books)
     so each strip reads as its own row. */
  .kind-block {
    margin-top: 2.75rem;
  }

  .kind-block:first-of-type {
    margin-top: 0;
  }

  .kind-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 1.25rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--border);
  }

  .learn-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .learn-card {
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s;
  }

  .learn-card:hover { border-color: var(--text-primary); }

  /* Unified thumbnail: every image fills the 16:9 tile with
     object-fit: contain so wide hero screenshots go edge-to-edge,
     square brand marks scale up to full tile height, and tall book
     covers fill the height. Every card carries the same visual
     weight; only the natural aspect ratio of each source varies. */
  .learn-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .is-coral  .learn-thumb { background: rgba(229, 96, 77, 0.10); }
  .is-blue   .learn-thumb { background: rgba(74, 132, 102, 0.10); }
  .is-green  .learn-thumb { background: rgba(31, 77, 50, 0.08); }
  .is-yellow .learn-thumb { background: rgba(212, 169, 56, 0.12); }

  .learn-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .learn-duration {
    position: absolute;
    left: 0.875rem;
    bottom: 0.875rem;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    color: var(--bg-elevated);
    background: var(--text-primary);
  }

  .learn-body {
    padding: 1.5rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .learn-kind {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
    margin-bottom: 0.625rem;
    font-family: var(--font-mono);
  }

  .learn-card h3 {
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    line-height: 1.25;
  }

  .learn-source {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.875rem;
  }

  .learn-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
    flex: 1;
  }

  .learn-meta {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-top: 1rem;
  }

  .learn-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-forest);
    transition: gap 0.2s;
  }

  .learn-link:hover {
    gap: 0.625rem;
    opacity: 1;
  }

  /* aisafety.com ecosystem hub — a calm paper band bridging the
     curated cards above and the closing CTA below. The .res-item rows
     here use the same shape as the homepage org cards. */
  .res-hub {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 2.5rem;
    align-items: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 2.75rem;
  }

  .res-hub > :not(.res-hub-glow) {
    position: relative;
    z-index: 1;
  }

  .res-hub-glow {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: var(--accent-sage);
    opacity: 0.13;
    top: -130px;
    right: -90px;
    z-index: 0;
    pointer-events: none;
  }

  .res-hub-intro .section-label {
    margin-bottom: 0.875rem;
  }

  .res-hub-intro .section-title {
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    line-height: 1.08;
    margin-bottom: 0.75rem;
  }

  .res-hub-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .res-hub-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .res-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.625rem 0.75rem;
