---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const logos = import.meta.glob<ImageMetadata>('../assets/resources/*', {
  eager: true,
  import: 'default',
});

const icons = {
  fundamentals:
    '<path d="M12 6.5C10.5 5 7.5 4.5 4 5v13c3.5-.5 6.5 0 8 1.5 1.5-1.5 4.5-2 8-1.5V5c-3.5-.5-6.5 0-8 1.5Z"/><path d="M12 6.5v13"/>',
  research:
    '<path d="M9 2h6M10 2v6.6L4.8 18a2 2 0 0 0 1.7 3h11a2 2 0 0 0 1.7-3L14 8.6V2"/><path d="M7.5 14.5h9"/>',
  governance:
    '<path d="M12 3v17M7 20h10M5 7h14"/><path d="M8 7 5 14h6L8 7ZM16 7l-3 7h6l-3-7Z"/>',
};

interface ResLink {
  name: string;
  source: string;
  url: string;
  img?: string;
  mono?: string;
}

const paths: {
  cls: string;
  icon: string;
  title: string;
  desc: string;
  links: ResLink[];
}[] = [
  {
    cls: 'is-green',
    icon: icons.fundamentals,
    title: t(locale, 'resources.fundamentals.title'),
    desc: t(locale, 'resources.fundamentals.desc'),
    links: [
      {
        name: 'Future of AI',
        source: 'BlueDot Impact',
        url: 'https://bluedot.org/courses/future-of-ai',
        img: 'bluedot.png',
      },
      {
        name: 'AGI Safety Course',
        source: 'Google DeepMind',
        url: 'https://deepmindsafetyresearch.medium.com/introducing-our-short-course-on-agi-safety-1072adb7912c',
        img: 'deepmind.png',
      },
      {
        name: 'AI Safety, Ethics & Society',
        source: 'Center for AI Safety',
        url: 'https://www.aisafetybook.com/',
        img: 'cais.png',
      },
    ],
  },
  {
    cls: 'is-coral',
    icon: icons.research,
    title: t(locale, 'resources.research.title'),
    desc: t(locale, 'resources.research.desc'),
    links: [
      {
        name: 'AI Alignment Forum',
        source: 'Curated Sequences',
        url: 'https://www.alignmentforum.org/library',
        img: 'alignment-forum.png',
      },
      {
        name: 'AI Safety Atlas',
        source: 'CeSIA',
        url: 'https://ai-safety-atlas.com/read/',
        img: 'ai-safety-atlas.png',
      },
      {
        name: 'ARENA',
        source: 'Research Engineer Accelerator',
        url: 'https://www.arena.education/curriculum',
        img: 'arena.png',
      },
    ],
  },
  {
    cls: 'is-blue',
    icon: icons.governance,
    title: t(locale, 'resources.governance.title'),
    desc: t(locale, 'resources.governance.desc'),
    links: [
      {
        name: 'AI Governance Research',
        source: 'GovAI',
        url: 'https://www.governance.ai/',
        img: 'govai.png',
      },
      {
        name: 'Frontier AI Governance',
        source: 'BlueDot Impact',
        url: 'https://bluedot.org/courses/ai-governance',
        img: 'bluedot.png',
      },
      {
        name: 'Colombia AI Framework',
        source: 'CONPES 4144 · DNP',
        url: 'https://colaboracion.dnp.gov.co/CDT/Conpes/Econ%C3%B3micos/4144.pdf',
        img: 'conpes.png',
      },
    ],
  },
];

// "Explore the whole ecosystem" panel — links into aisafety.com, the
// community-maintained directory (the curated cards above are our
// hand-picked starting points; this is the full field).
const hubIcons = {
  communities:
    '<circle cx="9" cy="8.5" r="3.1"/><path d="M3.6 19.4c0-3 2.4-5.2 5.4-5.2s5.4 2.2 5.4 5.2"/><path d="M16.2 5.6a3.1 3.1 0 0 1 0 6"/><path d="M17.6 14.5c2.3.5 4 2.5 4 4.9"/>',
  selfStudy:
    '<path d="M12 4 2 9l10 5 10-5-10-5Z"/><path d="M6 11.4V16c0 1.6 2.7 3 6 3s6-1.4 6-3v-4.6"/>',
  jobs:
    '<rect x="3" y="7.5" width="18" height="12" rx="2.2"/><path d="M8.5 7.5V6A2.5 2.5 0 0 1 11 3.5h2A2.5 2.5 0 0 1 15.5 6v1.5"/><path d="M3 12.6h18"/>',
  advisors:
    '<path d="M21 11.4a8.4 8.4 0 0 1-12.1 7.6L3 20.8l1.8-5.8A8.4 8.4 0 1 1 21 11.4Z"/><path d="M8.6 11.4h.01M12 11.4h.01M15.4 11.4h.01"/>',
};

const hubLinks: { name: string; desc: string; url: string; icon: string }[] = [
  {
    name: t(locale, 'resources.hub.communities'),
    desc: t(locale, 'resources.hub.communitiesDesc'),
    url: 'https://aisafety.com/communities',
    icon: hubIcons.communities,
  },
  {
    name: t(locale, 'resources.hub.selfStudy'),
    desc: t(locale, 'resources.hub.selfStudyDesc'),
    url: 'https://aisafety.com/self-study',
    icon: hubIcons.selfStudy,
  },
  {
    name: t(locale, 'resources.hub.jobs'),
    desc: t(locale, 'resources.hub.jobsDesc'),
    url: 'https://aisafety.com/jobs',
    icon: hubIcons.jobs,
  },
  {
    name: t(locale, 'resources.hub.advisors'),
    desc: t(locale, 'resources.hub.advisorsDesc'),
    url: 'https://aisafety.com/advisors',
    icon: hubIcons.advisors,
  },
];
---

<section class="section" aria-labelledby="resources-title">
  <div class="container">
    <h2 class="section-title" id="resources-title">{t(locale, 'resources.title')}</h2>
    <p class="section-subtitle">{t(locale, 'resources.subtitle')}</p>

    <div class="res-grid">
      {paths.map((path) => (
        <article class:list={['res-card', path.cls]}>
          <span class="res-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={path.icon} />
          </span>
          <h3>{path.title}</h3>
          <p class="res-desc">{path.desc}</p>
          <ul class="res-items">
            {path.links.map((item) => (
              <li>
                <a class="res-item" href={item.url} target="_blank" rel="noopener noreferrer">
                  <span class="res-thumb" aria-hidden="true">
                    {item.img && logos[`../assets/resources/${item.img}`] ? (
                      <Image
                        src={logos[`../assets/resources/${item.img}`]}
                        alt=""
                        width={128}
                        height={128}
                        loading="lazy"
                      />
                    ) : (
                      <span class="res-mono">{item.mono}</span>
                    )}
                  </span>
                  <span class="res-item-body">
                    <span class="res-item-name">{item.name}</span>
                    <span class="res-item-src">{item.source}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="res-hub-title">
  <div class="container">
    <div class="res-hub">
      <span class="res-hub-glow" aria-hidden="true"></span>
      <div class="res-hub-intro">
        <span class="section-label">{t(locale, 'resources.hub.kicker')}</span>
        <h2 class="section-title" id="res-hub-title">{t(locale, 'resources.hub.title')}</h2>
        <p class="res-hub-desc">{t(locale, 'resources.hub.desc')}</p>
        <a class="btn btn-primary" href="https://aisafety.com/map" target="_blank" rel="noopener noreferrer">
          {t(locale, 'resources.hub.mapCta')}
        </a>
      </div>
      <ul class="res-hub-links">
        {hubLinks.map((link) => (
          <li>
            <a class="res-item" href={link.url} target="_blank" rel="noopener noreferrer">
              <span class="res-thumb res-thumb-ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={link.icon} />
              </span>
              <span class="res-item-body">
                <span class="res-item-name">{link.name}</span>
                <span class="res-item-src">{link.desc}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="section alt res-cta" aria-labelledby="res-cta-title">
  <div class="container">
    <h2 class="section-title" id="res-cta-title">{t(locale, 'resources.cta.title')}</h2>
    <p class="section-subtitle">{t(locale, 'resources.cta.sub')}</p>
    <div class="res-cta-actions">
      <a class="btn btn-primary" href={`${localePath(locale, '/involucrate/')}#grupos`}>{t(locale, 'resources.cta.cta')}</a>
    </div>
  </div>
</section>

<style>
  .section-subtitle {
    margin-bottom: 2.5rem;
  }

  /* Learning paths as accent-tinted cards, mirroring the homepage
     "Qué hacemos" and About "Teoría de cambio" grid: icon chip,
     heading, one-line description, then the curated resources as
     image-led rows (logo tile + name + source). */
  .res-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .res-card {
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s;
  }

  .res-card:hover {
    border-color: var(--text-primary);
  }

  .res-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid currentColor;
    margin-bottom: 1.25rem;
  }

  .res-icon svg {
    width: 26px;
    height: 26px;
  }

  .is-green .res-icon { color: var(--accent-forest); }
  .is-coral .res-icon { color: var(--accent-vermillion); }
  .is-blue  .res-icon { color: var(--accent-sage); }

  .res-card h3 {
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .res-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .res-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  /* Image-led resource row, adapted from the AE Bogotá resources
     org-card: logo tile on the left, name + source, hover arrow. */
  .res-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-primary);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .res-item:hover {
    border-color: var(--text-primary);
    transform: translateX(2px);
  }

  .res-thumb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 10px;
    padding: 6px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .res-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .res-mono {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
  }

  .is-coral .res-mono { color: var(--accent-vermillion-dark); }

  .res-item-body {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
    flex: 1;
  }

  .res-item-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .res-item-src {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.3;
  }

  /* aisafety.com ecosystem hub — a calm paper band bridging the
     curated cards above and the closing CTA below. Reuses the same
     .res-item rows so it never reads as a foreign element. */
  .res-hub {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 2.5rem;
    align-items: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 2.75rem;
  }

  .res-hub > :not(.res-hub-glow) {
    position: relative;
    z-index: 1;
  }

  .res-hub-glow {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: var(--accent-sage);
    opacity: 0.13;
    top: -130px;
    right: -90px;
    z-index: 0;
    pointer-events: none;
  }

  .res-hub-intro .section-label {
    margin-bottom: 0.875rem;
  }

  .res-hub-intro .section-title {
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    line-height: 1.08;
    margin-bottom: 0.75rem;
  }

  .res-hub-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .res-hub-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .res-thumb-ic {
    color: var(--accent-forest);
  }

  .res-thumb-ic svg {
    width: 22px;
    height: 22px;
  }

  @media (max-width: 760px) {
    .res-hub {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding: 2rem 1.5rem;
    }
  }

  .res-cta .container {
    text-align: center;
  }

  .res-cta .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .res-cta-actions {
    display: flex;
    gap: 0.875rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .res-card,
    .res-item { transition: none; }
    .res-card:hover,
    .res-item:hover { transform: none; }
  }
</style>
