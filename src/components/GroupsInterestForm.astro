---
import type { Locale } from '../i18n/ui';
import courses from '../data/courses.json';
import { AREA_VALUES } from '../lib/groups-interest/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

// Build the list of areas from the canonical courses.json so the form
// stays aligned with the course cards rendered above.
const areaOptions = AREA_VALUES.map((slug) => {
  const c = courses.courses.find((cc) => cc.slug === slug);
  return {
    slug,
    label: es ? c?.titleEs ?? slug : c?.titleEn ?? slug,
    audience: es ? c?.audienceEs ?? '' : c?.audienceEn ?? '',
  };
});

const copy = {
  heroTitle: es ? 'Expresar interés' : 'Express interest',
  heroDesc: es
    ? 'Cuéntanos qué grupo te interesa y abrimos cohortes cuando hay suficientes personas.'
    : 'Tell us which group interests you and we open cohorts when enough people share the topic.',
  introP1: es
    ? 'Los grupos son gratuitos, sin requisitos previos, y se basan en las lecturas de BlueDot Impact.'
    : 'Groups are free, with no prior requirements, and built on the BlueDot Impact reading lists.',
  introP2: es
    ? 'Puedes tomar los cursos directamente con BlueDot en cualquier momento. Con nosotros la diferencia es que los grupos son en español y, si hay suficiente interés, presenciales en Bogotá.'
    : 'You can take the courses directly with BlueDot at any time. With us the difference is that the groups are in Spanish and, if there is enough interest, in person in Bogotá.',
  introP3: es
    ? 'Marca los temas que te interesen. Si llegaste desde una tarjeta de tema, ya quedó preseleccionado.'
    : 'Tick the topics that interest you. If you arrived from a topic card, that topic is already pre-selected.',
  sectionBasics: es ? 'Datos básicos' : 'Basic information',
  sectionInterest: es ? 'Tu interés' : 'Your interest',
  fieldFirstName: es ? 'Nombre' : 'First name',
  fieldLastName: es ? 'Apellido' : 'Last name',
  fieldEmail: 'Email',
  fieldLocation: es ? 'Ubicación (ciudad, país)' : 'Location (city, country)',
  fieldLinkedIn: es ? 'LinkedIn (URL)' : 'LinkedIn (URL)',
  fieldAbout: es ? 'Cuéntanos un poco sobre ti' : 'Tell us a bit about you',
  fieldAboutHelp: es
    ? '¿Qué haces, qué estudias o investigas, por qué te llama la atención la seguridad de IA? Una o dos frases bastan.'
    : 'What do you do, study or research, and why does AI safety catch your eye? One or two sentences is enough.',
  fieldAreas: es ? 'Temas que te interesan' : 'Topics you are interested in',
  fieldAreasHelp: es
    ? 'Marca uno o varios. Abrimos un grupo cuando reunimos suficientes personas en el mismo tema.'
    : 'Tick one or more. We open a group once enough people share the same topic.',
  fieldExtra: es ? 'Algo más que quieras compartir' : 'Anything else you would like to share',
  fieldExtraHelp: es ? 'Opcional.' : 'Optional.',
  optional: es ? 'Opcional' : 'Optional',
  submit: es ? 'Enviar interés' : 'Send interest',
  submitting: es ? 'Enviando…' : 'Submitting…',
  successTitle: es ? '¡Recibimos tu interés!' : 'We received your interest',
  successBody: es
    ? 'Te enviamos una copia de confirmación al email que registraste. Te avisaremos a la misma dirección en cuanto abramos un grupo del tema que elegiste.'
    : 'We sent a confirmation copy to the email you provided. We will write to the same address as soon as we open a group on the topic you picked.',
  successCtaWhatsApp: es ? 'Unirme al WhatsApp' : 'Join the WhatsApp',
  successCtaHome: es ? 'Volver al inicio' : 'Back home',
  errorTitle: es ? 'Hubo un problema al enviar' : 'There was a problem submitting',
  errorBody: es
    ? 'Tu interés no se envió. Por favor, intenta de nuevo en unos minutos o escríbenos directamente.'
    : 'Your interest did not go through. Please try again in a few minutes or write to us directly.',
  errorRetry: es ? 'Intentar de nuevo' : 'Try again',
  errorEmailCta: es ? 'Escribir a contacto' : 'Email us',
  areasMinError: es ? 'Marca al menos un tema.' : 'Pick at least one topic.',
};
---

<section class="apply-section" id="form-grupos">
  <span class="apply-shape apply-shape-yellow" aria-hidden="true"></span>
  <span class="apply-shape apply-shape-ring" aria-hidden="true"></span>

  <div class="apply-shell">
    <header class="apply-hero">
      <h1 class="apply-hero-title">{copy.heroTitle}</h1>
      <p class="apply-hero-desc">{copy.heroDesc}</p>
    </header>

    <div class="apply-intro">
      <p>{copy.introP1}</p>
      <p>{copy.introP2}</p>
      <p>{copy.introP3}</p>
    </div>

    <form id="interest-form" class="apply-form" novalidate>
      <input type="hidden" name="locale" value={locale} />

      <section class="apply-block">
        <h2 class="apply-h2">{copy.sectionBasics}</h2>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldFirstName}<em>*</em></span>
          <input type="text" name="firstName" required autocomplete="given-name" />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldLastName}<em>*</em></span>
          <input type="text" name="lastName" required autocomplete="family-name" />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldEmail}<em>*</em></span>
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldLocation}<em>*</em></span>
          <input type="text" name="location" required autocomplete="address-level2" placeholder={es ? 'Ej: Bogotá, Colombia' : 'Eg: Bogotá, Colombia'} />
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldLinkedIn} <small>· {copy.optional}</small></span>
          <input type="url" name="linkedin" inputmode="url" placeholder="https://linkedin.com/in/…" />
        </label>
      </section>

      <section class="apply-block">
        <h2 class="apply-h2">{copy.sectionInterest}</h2>

        <div class="apply-field">
          <span class="apply-label">{copy.fieldAreas}<em>*</em></span>
          <small class="apply-help">{copy.fieldAreasHelp}</small>
          <div class="apply-check-group" id="areas-group">
            {areaOptions.map((a) => (
              <label class="apply-check">
                <input type="checkbox" name="areas" value={a.slug} data-area={a.slug} />
                <span class="apply-check-body">
                  <span class="apply-check-title">{a.label}</span>
                  {a.audience && <span class="apply-check-aud">{a.audience}</span>}
                </span>
              </label>
            ))}
          </div>
        </div>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldAbout}<em>*</em></span>
          <small class="apply-help">{copy.fieldAboutHelp}</small>
          <textarea name="about" required rows="3" maxlength="1200"></textarea>
        </label>

        <label class="apply-field">
          <span class="apply-label">{copy.fieldExtra} <small>· {copy.optional}</small></span>
          <small class="apply-help">{copy.fieldExtraHelp}</small>
          <textarea name="extra" rows="2" maxlength="800"></textarea>
        </label>
      </section>

      <div class="apply-actions">
        <button type="submit" class="btn btn-primary apply-submit">
          <span class="apply-submit-default">{copy.submit}</span>
          <span class="apply-submit-loading" aria-hidden="true">{copy.submitting}</span>
        </button>
      </div>

      <p class="apply-error" role="alert" hidden></p>
    </form>

    <div class="apply-success" id="interest-success" hidden>
      <h2>{copy.successTitle}</h2>
      <p>{copy.successBody}</p>
      <div class="apply-success-actions">
        <a class="btn btn-primary" href="https://chat.whatsapp.com/KwE8cciX48TAVhAOHnrLaZ" target="_blank" rel="noopener noreferrer">{copy.successCtaWhatsApp}</a>
        <a class="btn btn-secondary" href={es ? '/' : '/en/'}>{copy.successCtaHome}</a>
      </div>
    </div>

    <div class="apply-error-box" id="interest-error-box" hidden>
      <h2>{copy.errorTitle}</h2>
      <p>{copy.errorBody}</p>
      <div class="apply-success-actions">
        <button type="button" class="btn btn-primary" id="interest-retry">{copy.errorRetry}</button>
        <a class="btn btn-secondary" href="mailto:contacto@aisafetycolombia.org">{copy.errorEmailCta}</a>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ locale, areasMinError: copy.areasMinError }}>
  (function () {
    const form = document.getElementById('interest-form');
    const successBox = document.getElementById('interest-success');
    const errorBox = document.getElementById('interest-error-box');
    const errorInline = form.querySelector('.apply-error');
    const submitBtn = form.querySelector('button[type="submit"]');
    const retryBtn = document.getElementById('interest-retry');
    const areasGroup = document.getElementById('areas-group');
    const areaInputs = areasGroup.querySelectorAll('input[type="checkbox"][name="areas"]');

    // Pre-check area from ?area=<slug> query param.
    try {
      const params = new URLSearchParams(window.location.search);
      const wanted = params.getAll('area').flatMap((v) => v.split(','));
      if (wanted.length > 0) {
        let matched = false;
        areaInputs.forEach((input) => {
          if (wanted.includes(input.value)) {
            input.checked = true;
            matched = true;
          }
        });
        if (matched) {
          // Scroll the form into view so the precheck is visible on landing.
          requestAnimationFrame(() => {
            document.getElementById('form-grupos')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        }
      }
    } catch (_) {}

    function showError(msg) {
      errorInline.textContent = msg;
      errorInline.hidden = false;
    }
    function clearError() {
      errorInline.textContent = '';
      errorInline.hidden = true;
    }
    function setLoading(loading) {
      submitBtn.disabled = loading;
      submitBtn.classList.toggle('is-loading', loading);
    }
    function showSuccess() {
      form.hidden = true;
      errorBox.hidden = true;
      successBox.hidden = false;
      successBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function showErrorBox() {
      form.hidden = true;
      successBox.hidden = true;
      errorBox.hidden = false;
      errorBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function va(name, props) {
      try {
        if (typeof window !== 'undefined' && typeof window.va === 'function') {
          window.va('event', { name: name, ...(props || {}) });
        }
        if (typeof window !== 'undefined' && typeof window.gtag === 'function') {
          window.gtag('event', name, props || {});
        }
      } catch (_) {}
    }

    let startedTracked = false;
    form.addEventListener(
      'focusin',
      function () {
        if (startedTracked) return;
        startedTracked = true;
        va('interest_started', { locale: locale });
      },
      { once: false }
    );

    retryBtn.addEventListener('click', function () {
      errorBox.hidden = true;
      form.hidden = false;
      setLoading(false);
      va('interest_retry', { locale: locale });
    });

    form.addEventListener('submit', async function (ev) {
      ev.preventDefault();
      clearError();
      if (!form.reportValidity()) return;

      const checkedAreas = Array.from(areaInputs).filter((i) => i.checked).map((i) => i.value);
      if (checkedAreas.length === 0) {
        showError(areasMinError);
        areasGroup.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      setLoading(true);

      const fd = new FormData(form);
      const payload = {};
      for (const [k, v] of fd.entries()) {
        if (k !== 'areas') payload[k] = v;
      }
      payload.areas = checkedAreas;

      try {
        const res = await fetch('/api/grupos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          let detail = '';
          try { detail = (await res.json()).error || ''; } catch (_) {}
          throw new Error(detail || 'Request failed with status ' + res.status);
        }
        va('interest_submitted', {
          locale: locale,
          areas: checkedAreas.join(','),
          area_count: checkedAreas.length,
        });
        showSuccess();
      } catch (err) {
        console.error('interest submit failed', err);
        va('interest_failed', {
          locale: locale,
          message: String((err && err.message) || 'unknown').slice(0, 120),
        });
        showErrorBox();
      } finally {
        setLoading(false);
      }
    });
  })();
</script>

<style>
  .apply-section {
    position: relative;
    overflow: hidden;
    padding: 5rem 1.5rem 7rem;
    background: var(--bg-primary);
  }

  .apply-shape {
    position: absolute;
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
  }

  .apply-shape-yellow {
    width: 280px;
    height: 280px;
    background: var(--accent-yellow);
    top: -110px;
    right: -90px;
  }

  .apply-shape-ring {
    width: 130px;
    height: 130px;
    background: transparent;
    border: 12px solid var(--accent-forest);
    bottom: 8rem;
    left: -55px;
  }

  .apply-shell {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
  }

  .apply-hero {
    margin-bottom: 2.5rem;
  }

  .apply-hero-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    margin: 0 0 1rem;
    max-width: 18ch;
  }

  .apply-hero-desc {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .apply-intro {
    border-top: 1px solid var(--hairline);
    padding-top: 2.5rem;
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .apply-intro p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  .apply-form {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  /* [hidden] must beat the flex/grid display rules above */
  [hidden] { display: none !important; }

  .apply-block {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .apply-h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.875rem, 3.8vw, 2.5rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .apply-field {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .apply-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
    line-height: 1.45;
  }

  .apply-label em {
    color: var(--accent-vermillion);
    font-style: normal;
    font-weight: 500;
    margin-left: 0.2rem;
  }

  .apply-label small {
    color: var(--text-secondary);
    font-weight: 400;
    font-size: 0.9375rem;
  }

  .apply-help {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.55;
    margin: 0;
  }

  .apply-field input,
  .apply-field textarea {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--text-primary);
    padding: 0.625rem 0;
    border: none;
    border-bottom: 1.5px solid var(--border);
    border-radius: 0;
    background: transparent;
    width: 100%;
    line-height: 1.5;
    transition: border-bottom-color 0.15s ease;
    -webkit-appearance: none;
    appearance: none;
  }

  .apply-field textarea {
    resize: vertical;
    min-height: 5.5rem;
    padding-top: 0.75rem;
  }

  .apply-field input::placeholder,
  .apply-field textarea::placeholder {
    color: #B5A88F;
    font-weight: 400;
  }

  .apply-field input:hover,
  .apply-field textarea:hover {
    border-bottom-color: var(--text-secondary);
  }

  .apply-field input:focus,
  .apply-field textarea:focus {
    outline: none;
    border-bottom: 2px solid var(--accent-vermillion);
    padding-bottom: calc(0.625rem - 0.5px);
  }

  /* Checkbox group — visually richer than radios because each option has a sub-line */
  .apply-check-group {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: 0.375rem;
  }

  .apply-check {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    cursor: pointer;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-elevated);
    transition: border-color 0.15s, background 0.15s;
  }

  .apply-check:hover {
    border-color: var(--accent-forest);
  }

  .apply-check input[type='checkbox'] {
    appearance: none;
    -webkit-appearance: none;
    margin: 0.25rem 0 0;
    width: 1.15rem;
    height: 1.15rem;
    border: 1.5px solid var(--border);
    border-radius: 4px;
    background: var(--bg-elevated);
    cursor: pointer;
    flex-shrink: 0;
    position: relative;
    transition: border-color 0.15s, background 0.15s;
  }

  .apply-check input[type='checkbox']:checked {
    border-color: var(--accent-forest);
    background: var(--accent-forest);
  }

  .apply-check input[type='checkbox']:checked::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 5px;
    width: 5px;
    height: 9px;
    border-right: 2px solid var(--bg-elevated);
    border-bottom: 2px solid var(--bg-elevated);
    transform: rotate(45deg);
  }

  .apply-check input[type='checkbox']:focus-visible {
    outline: 2px solid var(--accent-forest);
    outline-offset: 2px;
  }

  .apply-check:has(input[type='checkbox']:checked) {
    border-color: var(--accent-forest);
    background: rgba(20, 54, 32, 0.04);
  }

  .apply-check-body {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .apply-check-title {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .apply-check-aud {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .apply-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 1rem;
    padding-top: 0.5rem;
  }

  .apply-submit {
    padding: 1rem 2.25rem;
    font-size: 1rem;
    position: relative;
  }

  .apply-submit:disabled {
    opacity: 0.6;
    cursor: progress;
    transform: none;
  }

  .apply-submit-loading { display: none; }
  .apply-submit.is-loading .apply-submit-default { display: none; }
  .apply-submit.is-loading .apply-submit-loading { display: inline; }

  .apply-error {
    color: var(--accent-vermillion-dark);
    font-size: 1rem;
    margin: 1rem 0 0;
    text-align: center;
  }

  .apply-success,
  .apply-error-box {
    text-align: left;
    padding: 0;
    border: none;
    background: none;
  }

  .apply-success h2,
  .apply-error-box h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 1.25rem;
  }

  .apply-error-box h2 {
    color: var(--accent-vermillion-dark);
  }

  .apply-success p,
  .apply-error-box p {
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .apply-success-actions {
    display: flex;
    justify-content: flex-start;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .apply-section { padding: 3rem 1.25rem 5rem; }
    .apply-shape-yellow {
      width: 180px;
      height: 180px;
      top: -70px;
      right: -50px;
    }
    .apply-shape-ring { display: none; }
    .apply-hero { margin-bottom: 2rem; }
    .apply-intro { padding-top: 2rem; margin-bottom: 3rem; }
    .apply-form { gap: 3.5rem; }
    .apply-block { gap: 1.75rem; }
    .apply-submit { width: 100%; justify-content: center; }
  }
</style>
