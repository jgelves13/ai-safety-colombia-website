---
import type { Locale } from '../i18n/ui';
import data from '../data/hackathon.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

type DetailCard = {
  labelEs: string;
  labelEn: string;
  titleEs: string;
  titleEn: string;
  bodyEs: string;
  bodyEn: string;
  links?: Array<{ labelEs: string; labelEn: string; href: string }>;
};

const cards = data.detailCards as DetailCard[];
---

<section class="alt-details" id="details">
  <div class="container">
    <div class="alt-card-grid">
      {cards.map((card) => (
        <article class="alt-card">
          <span>{es ? card.labelEs : card.labelEn}</span>
          <h2>{es ? card.titleEs : card.titleEn}</h2>
          <p>{es ? card.bodyEs : card.bodyEn}</p>
          {card.links && (
            <div class="alt-card-links">
              {card.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {es ? link.labelEs : link.labelEn}
                </a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .alt-details {
    background: var(--bg-primary);
    padding: clamp(2.5rem, 5vw, 3.75rem) 0 clamp(3.75rem, 6vw, 5rem);
  }

  .alt-card-grid {
    display: grid;
    gap: clamp(0.85rem, 2vw, 1.15rem);
    grid-template-columns: repeat(3, 1fr);
  }

  .alt-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    min-height: 100%;
    padding: clamp(1.25rem, 2.4vw, 1.65rem);
  }

  .alt-card span {
    color: var(--accent-forest);
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .alt-card h2 {
    font-size: 1.4rem;
    line-height: 1.1;
    margin-bottom: 0.65rem;
  }

  .alt-card p {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.58;
  }

  .alt-card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .alt-card-links a {
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--accent-forest);
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1;
    padding: 0.55rem 0.7rem;
    text-decoration: none;
  }

  .alt-card-links a:hover {
    background: rgba(242, 183, 5, 0.2);
    border-color: var(--accent-forest);
  }

  @media (max-width: 900px) {
    .alt-card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
