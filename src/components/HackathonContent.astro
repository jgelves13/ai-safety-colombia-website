---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import data from '../data/hackathon.json';
import { daysUntil } from '../utils/countdown.js';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

const daysLeft = daysUntil(data.date);
const whatBody = es ? data.whatIsEs : data.whatIsEn;
const submission = es ? data.submissionEs : data.submissionEn;

type Person = {
  name: string;
  affiliationEs?: string;
  affiliationEn?: string;
  attendance?: 'inperson' | 'remote' | 'tbc';
  evalTopicEs?: string;
  evalTopicEn?: string;
  bioEs?: string;
  bioEn?: string;
  linkedin?: string;
  photo?: string;
};
const judges = data.judges as Person[];
const speakers = data.speakers as Person[];

type City = { name: string; bogota?: boolean; tbd?: boolean };
type Region = {
  nameEs: string;
  nameEn: string;
  accent: string;
  teamsEs: string;
  teamsEn: string;
  prizeEs: string;
  prizeEn: string;
  cities: City[];
};
const regions = data.regions as Region[];

// Brand LinkedIn glyph, injected inline so the link carries a real logo
// (not a text arrow). The anchor owns the accessible name; mark decorative.
const linkedinIcon =
  '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>';

const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();

// Attendance badge label (key cast: dynamic suffix off the literal union)
const attLabel = (a?: Person['attendance']) =>
  a ? t(locale, `hackathon.att.${a}` as Parameters<typeof t>[1]) : '';
---

<section class="hk-hero">
  <div class="container">
    <p class="hk-kicker">{t(locale, 'hackathon.kicker')}</p>
    <h1 class="hk-h1">{t(locale, 'hackathon.h1a')} <span class="hk-accent">{t(locale, 'hackathon.h1b')}</span></h1>
    <p class="hk-sub">{t(locale, 'hackathon.sub')}</p>
    <p class="hk-hook">{t(locale, 'hackathon.hook')}</p>
    <div class="hk-cta">
      <a href={data.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t(locale, 'hackathon.ctaPrimary')} &rarr;</a>
      <a href={data.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">{t(locale, 'hackathon.ctaSecondary')}</a>
      <div class="hk-count">
        <span class="hk-count-num" data-hackathon-date={data.date} aria-live="polite">{daysLeft}</span>
        <span class="hk-count-label">{t(locale, 'hackathon.countdownLabel')}</span>
      </div>
    </div>
  </div>
</section>

<section class="section hk-intro">
  <div class="container hk-narrow">
    <h2 class="section-title">{t(locale, 'hackathon.whatTitle')}</h2>
    <p class="hk-lead">{whatBody}</p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.whyTitle')}</h2>
    <p class="hk-why-lead">{es ? data.whyLeadEs : data.whyLeadEn}</p>
    <h3 class="hk-pathway-label">{es ? data.pathwayLabelEs : data.pathwayLabelEn}</h3>
    <div class="editorial">
      {data.pipeline.map((step, i) => (
        <div class={`editorial-row ${['is-green','is-coral','is-blue'][i % 3]}`}>
          <div class="editorial-bar"></div>
          <div class="editorial-tx">
            <h3>{es ? step.stepEs : step.stepEn}</h3>
            <p>{es ? step.descEs : step.descEn}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.tracksTitle')}</h2>
    <div class="hk-tracks">
      {data.tracks.map(track => (
        <div class={`hk-track ${track.accent}`}>
          <div class="hk-track-bar"></div>
          <div class="hk-track-tx">
            <h3>{es ? track.titleEs : track.titleEn}</h3>
            <p class="hk-track-desc">{es ? track.descEs : track.descEn}</p>
            <ul class="hk-track-subs">
              {track.subareas.map(s => (
                <li>{es ? s.es : s.en}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.prizesTitle')}</h2>
    <div class="hk-prize">
      <p class="hk-prize-amount">{es ? data.prizesDetail.amountEs : data.prizesDetail.amountEn}</p>
      <p class="hk-prize-head">{es ? data.prizesDetail.headlineEs : data.prizesDetail.headlineEn}</p>
      <p class="hk-prize-total">{es ? data.prizesDetail.totalEs : data.prizesDetail.totalEn}</p>
      <div class="hk-pills">
        {data.prizesDetail.perks.map(perk => (
          <span class="hk-pill">{es ? perk.es : perk.en}</span>
        ))}
      </div>
      <p class="hk-prize-extra">{es ? data.prizesDetail.fellowsEs : data.prizesDetail.fellowsEn}</p>
      <div class="hk-success">
        <h3 class="hk-success-title">{es ? data.prizesDetail.successTitleEs : data.prizesDetail.successTitleEn}</h3>
        <ul class="hk-success-list">
          {data.prizesDetail.successExamples.map(ex => (
            <li>{es ? ex.es : ex.en}</li>
          ))}
        </ul>
      </div>
    </div>
    <p class="hk-note hk-venue-note">{es ? data.prizesDetail.venueNoteEs : data.prizesDetail.venueNoteEn}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.hubsTitle')}</h2>
    <div class="hk-regions">
      {regions.map(region => (
        <article class={`hk-region ${region.accent}`}>
          <div class="hk-region-head">
            <h3>{es ? region.nameEs : region.nameEn}</h3>
            <span class="hk-region-meta">
              {es ? region.teamsEs : region.teamsEn} · {es ? region.prizeEs : region.prizeEn}
            </span>
          </div>
          <ul class="hk-cities">
            {region.cities.map((city, ci) => (
              <li
                class={`hk-city${city.bogota ? ' is-bogota' : ''}${city.tbd ? ' is-tbd' : ''}`}
                style={`--ci:${ci}`}
              >
                <span class="hk-city-dot" aria-hidden="true"></span>
                <span class="hk-city-name">{city.name}</span>
                {city.bogota && (
                  <span class="hk-city-tag">{t(locale, 'hackathon.ourHub')}</span>
                )}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="hk-note">{t(locale, 'hackathon.hubsNote')}</p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.whoTitle')}</h2>
    <div class="hk-pills">
      {data.eligibility.map(e => (
        <span class="hk-pill">{es ? e.es : e.en}</span>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.agendaTitle')}</h2>
    <div class="editorial">
      {data.schedule.map((day, i) => (
        <div class={`editorial-row ${day.accent ?? ['is-green','is-blue','is-yellow'][i % 3]}`}>
          <div class="editorial-bar"></div>
          <div class="editorial-tx">
            <h3>{es ? day.day : day.dayEn}</h3>
            <p>{es ? day.events[0].title : day.events[0].titleEn}</p>
          </div>
        </div>
      ))}
    </div>
    <p class="hk-note">{submission}</p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.speakersTitle')}</h2>
    <div class="hk-people">
      {speakers.map((sp, i) => (
        <article class={`hk-person ${['is-green','is-coral','is-blue','is-yellow'][i % 4]}`}>
          {sp.photo
            ? <img class="hk-person-av" src={`/people/${sp.photo}`} alt="" width="104" height="104" />
            : <div class="hk-person-av" aria-hidden="true">{initials(sp.name)}</div>}
          <div class="hk-person-tx">
            <h3>{sp.name}</h3>
            <p class="hk-person-aff">{es ? sp.affiliationEs : sp.affiliationEn}</p>
            {sp.attendance && (
              <span class={`hk-att hk-att-${sp.attendance}`}>{attLabel(sp.attendance)}</span>
            )}
            {(es ? sp.bioEs : sp.bioEn) && <p class="hk-person-bio">{es ? sp.bioEs : sp.bioEn}</p>}
            {sp.linkedin && (
              <a
                class="hk-person-link"
                href={sp.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`LinkedIn — ${sp.name}`}
              >
                <span class="hk-li-icon" set:html={linkedinIcon} />
                <span>LinkedIn</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.judgesTitle')}</h2>
    {judges.length > 0 ? (
      <div class="hk-people">
        {judges.map((j, i) => (
          <article class={`hk-person ${['is-green','is-coral','is-blue','is-yellow'][i % 4]}`}>
            {j.photo
              ? <img class="hk-person-av" src={`/people/${j.photo}`} alt="" width="104" height="104" />
              : <div class="hk-person-av" aria-hidden="true">{initials(j.name)}</div>}
            <div class="hk-person-tx">
              <h3>{j.name}</h3>
              {(es ? j.affiliationEs : j.affiliationEn) && (
                <p class="hk-person-aff">{es ? j.affiliationEs : j.affiliationEn}</p>
              )}
              {j.attendance && (
                <span class={`hk-att hk-att-${j.attendance}`}>{attLabel(j.attendance)}</span>
              )}
              {(es ? j.evalTopicEs : j.evalTopicEn) && (
                <p class="hk-person-eval">
                  <span class="hk-person-eval-label">{t(locale, 'hackathon.judgeEvalLabel')}</span>
                  {es ? j.evalTopicEs : j.evalTopicEn}
                </p>
              )}
              {(es ? j.bioEs : j.bioEn) && <p class="hk-person-bio">{es ? j.bioEs : j.bioEn}</p>}
              {j.linkedin && (
                <a
                  class="hk-person-link"
                  href={j.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`LinkedIn — ${j.name}`}
                >
                  <span class="hk-li-icon" set:html={linkedinIcon} />
                  <span>LinkedIn</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="hk-note">{t(locale, 'hackathon.judgesTba')}</p>
    )}
  </div>
</section>

<section class="hk-band">
  <div class="container">
    <h2 class="hk-band-title">{t(locale, 'hackathon.ctaBandTitle')}</h2>
    <p class="hk-band-sub">{t(locale, 'hackathon.ctaBandSub')}</p>
    <a href={data.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t(locale, 'hackathon.ctaPrimary')} &rarr;</a>
    <p class="hk-band-mail">{data.contactEmail}</p>
  </div>
</section>

<style>
  .hk-hero {
    padding: 9rem 1.5rem 4rem;
    background: linear-gradient(180deg, #F1F8F2, #FFFFFF);
  }

  .hk-kicker {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--green-text);
  }

  .hk-h1 {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.03;
    margin: 0.5rem 0;
    color: var(--text-primary);
  }

  .hk-accent {
    color: var(--accent-green);
  }

  .hk-sub {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 600px;
    line-height: 1.55;
  }

  .hk-hook {
    margin-top: 1rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .hk-cta {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hk-count {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .hk-count-num {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--green-text);
  }

  .hk-count-label {
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  .hk-narrow {
    max-width: 760px;
  }

  .hk-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .hk-tracks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .hk-track {
    display: flex;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    background: #FFFFFF;
  }

  .hk-track-bar {
    width: 5px;
    flex: none;
    border-radius: 4px;
  }

  .hk-track.is-green .hk-track-bar { background: var(--accent-green); }
  .hk-track.is-coral .hk-track-bar { background: var(--accent-coral); }
  .hk-track.is-blue .hk-track-bar { background: var(--accent-blue); }
  .hk-track.is-yellow .hk-track-bar { background: var(--accent-yellow-line); }

  .hk-track h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.375rem;
  }

  .hk-track p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .hk-prize {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
    background: #FFFFFF;
  }

  .hk-prize-amount {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--green-text);
  }

  .hk-prize-head {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 0.25rem;
  }

  .hk-prize-total {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }

  .hk-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .hk-pill {
    font-size: 0.8125rem;
    font-weight: 600;
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.375rem 0.875rem;
    color: var(--text-primary);
  }

  /* Regional map: one card per region, cities animate in on load,
     Bogotá (our hub) gets a pulsing dot + tag. */
  .hk-regions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .hk-region {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    background: #FFFFFF;
    border-top: 4px solid var(--border);
  }

  .hk-region.is-green { border-top-color: var(--accent-green); }
  .hk-region.is-coral { border-top-color: var(--accent-coral); }
  .hk-region.is-blue { border-top-color: var(--accent-blue); }
  .hk-region.is-yellow { border-top-color: var(--accent-yellow-line); }

  .hk-region-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .hk-region-head h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .hk-region-meta {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .hk-cities {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .hk-city {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    color: var(--text-primary);
    opacity: 0;
    transform: translateY(6px);
    animation: hk-city-in 0.45s ease forwards;
    animation-delay: calc(var(--ci) * 90ms);
  }

  .hk-city-dot {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: var(--text-secondary);
  }

  .hk-region.is-green .hk-city-dot { background: var(--accent-green); }
  .hk-region.is-coral .hk-city-dot { background: var(--accent-coral); }
  .hk-region.is-blue .hk-city-dot { background: var(--accent-blue); }

  .hk-city.is-tbd {
    color: var(--text-secondary);
  }

  .hk-city.is-tbd .hk-city-dot {
    background: transparent;
    border: 1.5px dashed var(--text-secondary);
  }

  .hk-city.is-bogota {
    font-weight: 700;
  }

  .hk-city.is-bogota .hk-city-dot {
    width: 12px;
    height: 12px;
    background: var(--accent-green);
    box-shadow: 0 0 0 0 rgba(43, 213, 118, 0.7);
    animation: hk-bogota-pulse 2s ease-out infinite;
  }

  .hk-city-tag {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--accent-green);
    color: #101010;
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
  }

  @keyframes hk-city-in {
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes hk-bogota-pulse {
    0% { box-shadow: 0 0 0 0 rgba(43, 213, 118, 0.6); }
    70% { box-shadow: 0 0 0 10px rgba(43, 213, 118, 0); }
    100% { box-shadow: 0 0 0 0 rgba(43, 213, 118, 0); }
  }

  .hk-note {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .hk-band {
    background: var(--dark-bg);
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .hk-band-title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #FFFFFF;
  }

  .hk-band-sub {
    color: var(--dark-muted);
    font-size: 0.9375rem;
    margin: 0.5rem 0 1.5rem;
  }

  .hk-band-mail {
    color: var(--dark-muted);
    font-size: 0.8125rem;
    margin-top: 1.25rem;
  }

  /* "Qué es": lone short lead, so tighten the vertical rhythm */
  .hk-intro {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .hk-intro .section-title {
    margin-bottom: 0.625rem;
  }

  .hk-intro .hk-lead {
    margin: 0;
  }

  .hk-why-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 720px;
    margin-bottom: 2rem;
  }

  /* Track cards: full description + subareas always visible. */
  .hk-track {
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .hk-track:hover {
    border-color: var(--accent-green);
    transform: translateY(-2px);
  }

  .hk-track.is-coral:hover { border-color: var(--accent-coral); }
  .hk-track.is-blue:hover { border-color: var(--accent-blue); }
  .hk-track.is-yellow:hover { border-color: var(--accent-yellow-line); }

  .hk-track-tx {
    display: flex;
    flex-direction: column;
  }

  .hk-track-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0 0 0.875rem;
  }

  .hk-track-subs {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 0;
    padding: 0;
  }

  .hk-track-subs li {
    font-size: 0.75rem;
    font-weight: 600;
    background: #F4F6F4;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    color: var(--text-primary);
  }

  .hk-pathway-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--green-text);
    margin-bottom: 1rem;
  }

  .hk-prize-extra {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .hk-venue-note {
    font-weight: 600;
    color: var(--text-primary);
  }

  .hk-success {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .hk-success-title {
    font-size: 0.75rem;
    font-weight: 700;
