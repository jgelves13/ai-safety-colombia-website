<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.judgesTitle')}</h2>
    {judges.length > 0 ? (
      <div class="hk-people">
        {judges.map((j, i) => (
          <article class={`hk-person ${['is-green','is-coral','is-blue','is-yellow'][i % 4]}`}>
            {j.photo
              ? <img class="hk-person-av" src={`/people/${j.photo}`} alt="" width="104" height="104" />
              : <div class="hk-person-av" aria-hidden="true">{initials(j.name)}</div>}
            <div class="hk-person-tx">
              <h3>{j.name}</h3>
              {(es ? j.affiliationEs : j.affiliationEn) && (
                <p class="hk-person-aff">{es ? j.affiliationEs : j.affiliationEn}</p>
              )}
              {j.attendance && (
                <span class={`hk-att hk-att-${j.attendance}`}>{attLabel(j.attendance)}</span>
              )}
              {(es ? j.evalTopicEs : j.evalTopicEn) && (
                <p class="hk-person-eval">
                  <span class="hk-person-eval-label">{t(locale, 'hackathon.judgeEvalLabel')}</span>
                  {es ? j.evalTopicEs : j.evalTopicEn}
                </p>
              )}
              {(es ? j.bioEs : j.bioEn) && <p class="hk-person-bio" set:html={es ? j.bioEs : j.bioEn} />}
              {j.linkedin && (
                <a
                  class="hk-person-link"
                  href={j.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`LinkedIn — ${j.name}`}
                >
                  <span class="hk-li-icon" set:html={linkedinIcon} />
                  <span>LinkedIn</span>
                </a>
              )}
              {j.openreview && (
                <a
                  class="hk-person-link"
                  href={j.openreview}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`OpenReview — ${j.name}`}
                >
                  <span>OpenReview</span>
                </a>
              )}
              {j.camara && (
                <a
                  class="hk-person-link"
                  href={j.camara}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${t(locale, 'hackathon.camaraLabel')} — ${j.name}`}
                >
                  <span>{t(locale, 'hackathon.camaraLabel')}</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="hk-note">{t(locale, 'hackathon.judgesTba')}</p>
    )}
  </div>
</section>

<section class="hk-band featured-block">
  <div class="container">
    <h2 class="hk-band-title">{t(locale, 'hackathon.ctaBandTitle')}</h2>
    <p class="hk-band-sub">{t(locale, 'hackathon.ctaBandSub')}</p>
