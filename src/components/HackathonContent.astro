---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import data from '../data/hackathon.json';
import { daysUntil } from '../utils/countdown.js';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

const daysLeft = daysUntil(data.date);
const whatBody = es ? data.whatIsEs : data.whatIsEn;
const submission = es ? data.submissionEs : data.submissionEn;

type Person = {
  name: string;
  affiliationEs?: string;
  affiliationEn?: string;
  attendance?: 'inperson' | 'remote' | 'tbc';
  bioEs?: string;
  bioEn?: string;
  linkedin?: string;
  photo?: string;
};
const judges = data.judges as Person[];
const speakers = data.speakers as Person[];

const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();

// Attendance badge label (key cast: dynamic suffix off the literal union)
const attLabel = (a?: Person['attendance']) =>
  a ? t(locale, `hackathon.att.${a}` as Parameters<typeof t>[1]) : '';
---

<section class="hk-hero">
  <div class="container">
    <p class="hk-kicker">{t(locale, 'hackathon.kicker')}</p>
    <h1 class="hk-h1">{t(locale, 'hackathon.h1a')} <span class="hk-accent">{t(locale, 'hackathon.h1b')}</span></h1>
    <p class="hk-sub">{t(locale, 'hackathon.sub')}</p>
    <p class="hk-hook">{t(locale, 'hackathon.hook')}</p>
    <div class="hk-cta">
      <a href={data.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t(locale, 'hackathon.ctaPrimary')} &rarr;</a>
      <a href={data.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">{t(locale, 'hackathon.ctaSecondary')}</a>
      <div class="hk-count">
        <span class="hk-count-num" data-hackathon-date={data.date} aria-live="polite">{daysLeft}</span>
        <span class="hk-count-label">{t(locale, 'hackathon.countdownLabel')}</span>
      </div>
    </div>
  </div>
</section>

<section class="section hk-intro">
  <div class="container hk-narrow">
    <h2 class="section-title">{t(locale, 'hackathon.whatTitle')}</h2>
    <p class="hk-lead">{whatBody}</p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.whyTitle')}</h2>
    <p class="hk-why-lead">{es ? data.whyLeadEs : data.whyLeadEn}</p>
    <div class="editorial">
      {data.pipeline.map((step, i) => (
        <div class={`editorial-row ${['is-green','is-coral','is-blue'][i % 3]}`}>
          <div class="editorial-bar"></div>
          <div class="editorial-tx">
            <h3>{es ? step.stepEs : step.stepEn}</h3>
            <p>{es ? step.descEs : step.descEn}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.tracksTitle')}</h2>
    <div class="hk-tracks">
      {data.tracks.map(track => (
        <div class={`hk-track ${track.accent}`} tabindex="0">
          <div class="hk-track-bar"></div>
          <div>
            <h3>{es ? track.titleEs : track.titleEn}</h3>
            <p class="hk-track-desc">{track.subareas.map(s => (es ? s.es : s.en)).join(' / ')}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.prizesTitle')}</h2>
    <div class="hk-prize">
      <p class="hk-prize-amount">{es ? data.prizesDetail.amountEs : data.prizesDetail.amountEn}</p>
      <p class="hk-prize-head">{es ? data.prizesDetail.headlineEs : data.prizesDetail.headlineEn}</p>
      <p class="hk-prize-total">{es ? data.prizesDetail.totalEs : data.prizesDetail.totalEn}</p>
      <div class="hk-pills">
        {data.prizesDetail.perks.map(perk => (
          <span class="hk-pill">{es ? perk.es : perk.en}</span>
        ))}
      </div>
      <p class="hk-prize-extra">{es ? data.prizesDetail.fellowsEs : data.prizesDetail.fellowsEn}</p>
    </div>
    <p class="hk-note hk-venue-note">{es ? data.prizesDetail.venueNoteEs : data.prizesDetail.venueNoteEn}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.hubsTitle')}</h2>
    <div class="hk-hubs">
      {data.hubs.map(hub => (
        <span class={hub.bogota ? 'hk-hub is-bogota' : 'hk-hub'}>{hub.city}</span>
      ))}
    </div>
    <p class="hk-note">{t(locale, 'hackathon.hubsNote')}</p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.whoTitle')}</h2>
    <div class="hk-pills">
      {data.eligibility.map(e => (
        <span class="hk-pill">{es ? e.es : e.en}</span>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.agendaTitle')}</h2>
    <div class="editorial">
      {data.schedule.map((day, i) => (
        <div class={`editorial-row ${day.accent ?? ['is-green','is-blue','is-yellow'][i % 3]}`}>
          <div class="editorial-bar"></div>
          <div class="editorial-tx">
            <h3>{es ? day.day : day.dayEn}</h3>
            <p>{es ? day.events[0].title : day.events[0].titleEn}</p>
          </div>
        </div>
      ))}
    </div>
    <p class="hk-note">{submission}</p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.speakersTitle')}</h2>
    <div class="hk-people">
      {speakers.map((sp, i) => (
        <article class={`hk-person ${['is-green','is-coral','is-blue','is-yellow'][i % 4]}`}>
          {sp.photo
            ? <img class="hk-person-av" src={`/people/${sp.photo}`} alt="" width="104" height="104" />
            : <div class="hk-person-av" aria-hidden="true">{initials(sp.name)}</div>}
          <div class="hk-person-tx">
            <h3>{sp.name}</h3>
            <p class="hk-person-aff">{es ? sp.affiliationEs : sp.affiliationEn}</p>
            {sp.attendance && (
              <span class={`hk-att hk-att-${sp.attendance}`}>{attLabel(sp.attendance)}</span>
            )}
            {(es ? sp.bioEs : sp.bioEn) && <p class="hk-person-bio">{es ? sp.bioEs : sp.bioEn}</p>}
            {sp.linkedin && (
              <a class="hk-person-link" href={sp.linkedin} target="_blank" rel="noopener noreferrer">
                LinkedIn &rarr;
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.judgesTitle')}</h2>
    {judges.length > 0 ? (
      <div class="hk-people">
        {judges.map((j, i) => (
          <article class={`hk-person ${['is-green','is-coral','is-blue','is-yellow'][i % 4]}`}>
            {j.photo
              ? <img class="hk-person-av" src={`/people/${j.photo}`} alt="" width="104" height="104" />
              : <div class="hk-person-av" aria-hidden="true">{initials(j.name)}</div>}
            <div class="hk-person-tx">
              <h3>{j.name}</h3>
              {(es ? j.affiliationEs : j.affiliationEn) && (
                <p class="hk-person-aff">{es ? j.affiliationEs : j.affiliationEn}</p>
              )}
              {j.attendance && (
                <span class={`hk-att hk-att-${j.attendance}`}>{attLabel(j.attendance)}</span>
              )}
              {(es ? j.bioEs : j.bioEn) && <p class="hk-person-bio">{es ? j.bioEs : j.bioEn}</p>}
              {j.linkedin && (
                <a class="hk-person-link" href={j.linkedin} target="_blank" rel="noopener noreferrer">
                  LinkedIn &rarr;
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="hk-note">{t(locale, 'hackathon.judgesTba')}</p>
    )}
  </div>
</section>

<section class="hk-band">
  <div class="container">
    <h2 class="hk-band-title">{t(locale, 'hackathon.ctaBandTitle')}</h2>
    <p class="hk-band-sub">{t(locale, 'hackathon.ctaBandSub')}</p>
    <a href={data.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t(locale, 'hackathon.ctaPrimary')} &rarr;</a>
    <p class="hk-band-mail">{data.contactEmail}</p>
  </div>
</section>

<style>
  .hk-hero {
    padding: 9rem 1.5rem 4rem;
    background: linear-gradient(180deg, #F1F8F2, #FFFFFF);
  }

  .hk-kicker {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--green-text);
  }

  .hk-h1 {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.03;
    margin: 0.5rem 0;
    color: var(--text-primary);
  }

  .hk-accent {
    color: var(--accent-green);
  }

  .hk-sub {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 600px;
    line-height: 1.55;
  }

  .hk-hook {
    margin-top: 1rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .hk-cta {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hk-count {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .hk-count-num {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--green-text);
  }

  .hk-count-label {
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  .hk-narrow {
    max-width: 760px;
  }

  .hk-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .hk-tracks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .hk-track {
    display: flex;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    background: #FFFFFF;
  }

  .hk-track-bar {
    width: 5px;
    flex: none;
    border-radius: 4px;
  }

  .hk-track.is-green .hk-track-bar { background: var(--accent-green); }
  .hk-track.is-coral .hk-track-bar { background: var(--accent-coral); }
  .hk-track.is-blue .hk-track-bar { background: var(--accent-blue); }
  .hk-track.is-yellow .hk-track-bar { background: var(--accent-yellow-line); }

  .hk-track h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.375rem;
  }

  .hk-track p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .hk-prize {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
    background: #FFFFFF;
  }

  .hk-prize-amount {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--green-text);
  }

  .hk-prize-head {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 0.25rem;
  }

  .hk-prize-total {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }

  .hk-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .hk-pill {
    font-size: 0.8125rem;
    font-weight: 600;
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.375rem 0.875rem;
    color: var(--text-primary);
  }

  .hk-hubs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hk-hub {
    font-size: 0.875rem;
    font-weight: 600;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    color: var(--text-secondary);
  }

  .hk-hub.is-bogota {
    background: var(--accent-green);
    color: #101010;
    border-color: var(--accent-green);
  }

  .hk-note {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .hk-band {
    background: var(--dark-bg);
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .hk-band-title {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #FFFFFF;
  }

  .hk-band-sub {
    color: var(--dark-muted);
    font-size: 0.9375rem;
    margin: 0.5rem 0 1.5rem;
  }

  .hk-band-mail {
    color: var(--dark-muted);
    font-size: 0.8125rem;
    margin-top: 1.25rem;
  }

  /* "Qué es": lone short lead, so tighten the vertical rhythm */
  .hk-intro {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .hk-intro .section-title {
    margin-bottom: 0.625rem;
  }

  .hk-intro .hk-lead {
    margin: 0;
  }

  .hk-why-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 720px;
    margin-bottom: 2rem;
  }

  /* Track cards: reveal a short description on hover / keyboard focus */
  .hk-track {
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .hk-track:hover,
  .hk-track:focus-within {
    border-color: var(--accent-green);
    transform: translateY(-2px);
  }

  .hk-track.is-coral:hover,
  .hk-track.is-coral:focus-within { border-color: var(--accent-coral); }
  .hk-track.is-blue:hover,
  .hk-track.is-blue:focus-within { border-color: var(--accent-blue); }
  .hk-track.is-yellow:hover,
  .hk-track.is-yellow:focus-within { border-color: var(--accent-yellow-line); }

  .hk-track-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.5;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    margin: 0;
    transition: max-height 0.22s ease, opacity 0.22s ease, margin 0.22s ease;
  }

  .hk-track:hover .hk-track-desc,
  .hk-track:focus-within .hk-track-desc {
    max-height: 12rem;
    opacity: 1;
    margin: 0 0 0.625rem;
  }

  .hk-prize-extra {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .hk-venue-note {
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Speaker / judge cards */
  .hk-people {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .hk-person {
    display: flex;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    background: #FFFFFF;
  }

  .hk-person-av {
    width: 104px;
    height: 104px;
    flex: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.875rem;
    font-weight: 700;
    object-fit: cover;
    color: #FFFFFF;
    background: var(--accent-green);
  }

  .hk-person.is-coral .hk-person-av { background: var(--accent-coral); }
  .hk-person.is-blue .hk-person-av { background: var(--accent-blue); }
  .hk-person.is-yellow .hk-person-av { background: var(--accent-yellow-line); }

  .hk-person h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .hk-person-aff {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--green-text);
    margin-top: 0.125rem;
  }

  .hk-att {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 999px;
    padding: 0.25rem 0.625rem;
  }

  .hk-att-inperson {
    background: #E7F8EC;
    color: var(--green-text);
  }

  .hk-att-remote {
    background: #E4F6FC;
    color: #0090c4;
  }

  .hk-att-tbc {
    background: #F0F0EC;
    color: var(--text-secondary);
  }

  .hk-person-bio {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-top: 0.5rem;
  }

  .hk-person-link {
    display: inline-block;
    margin-top: 0.625rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .hk-person-link:hover {
    color: var(--green-text);
  }

  /* Touch devices have no hover: show track descriptions by default */
  @media (hover: none) {
    .hk-track-desc {
      max-height: none;
      opacity: 1;
      margin: 0 0 0.625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hk-track,
    .hk-track-desc {
      transition: none;
    }
    .hk-track:hover,
    .hk-track:focus-within {
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .hk-tracks,
    .hk-people {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { daysUntil } from '../utils/countdown.js';
  const el = document.querySelector('[data-hackathon-date]');
  const date = el && el.getAttribute('data-hackathon-date');
  if (el && date) {
    el.textContent = String(daysUntil(date));
  }
</script>
