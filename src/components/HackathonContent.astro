---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import data from '../data/hackathon.json';
import { daysUntil } from '../utils/countdown.js';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

const daysLeft = daysUntil(data.date);
const whatBody = es ? data.whatIsEs : data.whatIsEn;
const submission = es ? data.submissionEs : data.submissionEn;

type Person = {
  name: string;
  affiliationEs?: string;
  affiliationEn?: string;
  attendance?: 'inperson' | 'remote' | 'tbc';
  evalTopicEs?: string;
  evalTopicEn?: string;
  bioEs?: string;
  bioEn?: string;
  linkedin?: string;
  openreview?: string;
  camara?: string;
  photo?: string;
};
const judges = data.judges as Person[];
const speakers = data.speakers as Person[];

type City = { name: string; nameEs?: string; bogota?: boolean; tbd?: boolean };
type Region = {
  nameEs: string;
  nameEn: string;
  accent: string;
  teamsEs: string;
  teamsEn: string;
  prizeEs: string;
  prizeEn: string;
  cities: City[];
};
const regions = data.regions as Region[];

// Brand LinkedIn glyph, injected inline so the link carries a real logo
// (not a text arrow). The anchor owns the accessible name; mark decorative.
const linkedinIcon =
  '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>';

const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();

// Attendance badge label (key cast: dynamic suffix off the literal union)
const attLabel = (a?: Person['attendance']) =>
  a ? t(locale, `hackathon.att.${a}` as Parameters<typeof t>[1]) : '';

// One line-icon per eligibility profile, in data order (chip, code,
// scales, shield, cap, bulb). Decorative: cards own the text label.
const ic = (paths: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${paths}</svg>`;
const whoIcons = [
  ic('<rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M10 3v2M14 3v2M10 19v2M14 19v2M3 10h2M3 14h2M19 10h2M19 14h2"/>'),  // chip (AI/ML)
  ic('<path d="M8 6l-6 6 6 6M16 6l6 6-6 6M14 4l-4 16"/>'),  // code (developers/data)
  ic('<path d="M12 4v16M7 20h10M5 8h14M5 8l-2.5 5a3 3 0 0 0 5 0L5 8zM19 8l-2.5 5a3 3 0 0 0 5 0L19 8z"/>'),  // scales (policy/law)
  ic('<path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>'),  // shield (security)
  ic('<path d="M12 4L2 9l10 5 10-5-10-5z"/><path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/>'),  // cap (students)
  ic('<path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2v.3h6v-.3c0-.8.4-1.5 1-2A7 7 0 0 0 12 2z"/>'),  // bulb (other fields)
];
const whoAccents = ['is-green', 'is-coral', 'is-blue', 'is-yellow'];

// One line-icon per hackathon front, in whyCases order: magnifier
// (technical safety — evaluate/inspect), shield + keyhole (security),
// compass (responsible AI — steering), institution columns
// (governance). Decorative — the card heading owns the text label.
const caseIcons = [
  ic('<circle cx="11" cy="11" r="7.5"/><path d="M16.8 16.8 21 21"/>'),
  ic('<path d="M12 3l7 3v6c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6l7-3z"/><circle cx="12" cy="10.8" r="1.7"/><path d="M12 12.5V15"/>'),
  ic('<circle cx="12" cy="12" r="9"/><path d="M16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88Z"/>'),
  ic('<path d="M3 9l9-5 9 5M5 9.5V19M19 9.5V19M3 21h18M9.5 9.5V19M14.5 9.5V19"/>'),
];

// Mode card icons: header icon for each card, then per-perk icons
const pinIcon   = ic('<path d="M12 2C8.7 2 6 4.7 6 8c0 5.3 6 14 6 14s6-8.7 6-14c0-3.3-2.7-6-6-6z"/><circle cx="12" cy="8" r="2.5"/>');
const globeIcon = ic('<circle cx="12" cy="12" r="9"/><path d="M3.6 9h16.8M3.6 15h16.8"/><ellipse cx="12" cy="12" rx="4.5" ry="9"/>');
const inPersonIcons = [
  ic('<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2M7 2v20"/><path d="M21 15V2c-3 0-5 2-5 5v6c0 1.1.9 2 2 2h3zm0 0v7"/>'),  // food
  ic('<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>'),  // mentorship
  ic('<path d="M12 2a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1M12 19v3M8 22h8"/>'),  // talks/mic
  ic('<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>'),  // travel/map pin
];
const onlineIcons = [
  ic('<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>'),  // mentorship
  ic('<path d="M12 2a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V5a3 3 0 0 1 3-3z"/><path d="M19 10v1a7 7 0 0 1-14 0v-1M12 19v3M8 22h8"/>'),  // talks/mic
  ic('<polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/>'),  // video/Zoom
  ic('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>'),  // document/checklist
];
const infoIcon = ic('<circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/>');
---

<section class="hk-hero">
  <div class="container">
    <p class="hk-kicker">{t(locale, 'hackathon.kicker')}</p>
    <h1 class="hk-h1">{t(locale, 'hackathon.h1a')} <span class="hk-accent">{t(locale, 'hackathon.h1b')}</span></h1>
    <p class="hk-sub">{t(locale, 'hackathon.sub')}</p>
    <p class="hk-hook">{t(locale, 'hackathon.hook')}</p>
    <div class="hk-cta">
      <a href={data.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t(locale, 'hackathon.ctaPrimary')}</a>
      <div class="hk-count">
        {t(locale, 'hackathon.countdownPre') && <span class="hk-count-pre">{t(locale, 'hackathon.countdownPre')}</span>}
        <span class="hk-count-num" data-hackathon-date={data.date} aria-live="polite">{daysLeft}</span>
        <span class="hk-count-label">{t(locale, 'hackathon.countdownLabel')}</span>
      </div>
    </div>
  </div>
</section>

<section class="section hk-intro">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.whatTitle')}</h2>
    <p class="hk-lead">{whatBody}</p>

    <div class="hk-modes">
      <article class="hk-mode is-coral">
        <div class="hk-mode-top">
          <span class="hk-mode-icon" set:html={pinIcon} />
          <span class="hk-mode-badge">{es ? data.inPerson.modeInpersonLabelEs : data.inPerson.modeInpersonLabelEn}</span>
        </div>
        <h3 class="hk-mode-h3">{es ? data.inPerson.bogotaHubTitleEs : data.inPerson.bogotaHubTitleEn}</h3>
        <p class="hk-mode-tag">{es ? data.inPerson.bogotaTagEs : data.inPerson.bogotaTagEn}</p>
        <ul class="hk-mode-perks">
          {data.inPerson.items.map((item, i) => (
            <li class="hk-mode-perk">
              <span class="hk-mode-perk-ic" set:html={inPersonIcons[i % inPersonIcons.length]} />
              <span>{es ? item.es : item.en}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="hk-mode is-blue">
        <div class="hk-mode-top">
          <span class="hk-mode-icon" set:html={globeIcon} />
          <span class="hk-mode-badge">{es ? data.inPerson.modeOnlineLabelEs : data.inPerson.modeOnlineLabelEn}</span>
        </div>
        <h3 class="hk-mode-h3">{es ? data.inPerson.onlineTitleEs : data.inPerson.onlineTitleEn}</h3>
        <p class="hk-mode-tag">{es ? data.inPerson.virtualTagEs : data.inPerson.virtualTagEn}</p>
        <ul class="hk-mode-perks">
          {data.inPerson.onlineItems.map((item: {es: string; en: string}, i: number) => (
            <li class="hk-mode-perk">
              <span class="hk-mode-perk-ic" set:html={onlineIcons[i % onlineIcons.length]} />
              <span>{es ? item.es : item.en}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>

    <p class="hk-mode-note">
      <span class="hk-mode-note-ic" set:html={infoIcon} />
      <span>{es ? data.inPerson.bogotaApplyEs : data.inPerson.bogotaApplyEn}</span>
    </p>

    <p class="hk-attr" set:html={es ? data.organizerNoteEs : data.organizerNoteEn} />
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.whoTitle')}</h2>
    <ul class="hk-who">
      {data.eligibility.map((e, i) => (
        <li class={`hk-who-card ${whoAccents[i % whoAccents.length]}`} style={`--wi:${i}`}>
          <span class="hk-who-ic" set:html={whoIcons[i % whoIcons.length]} />
          <span class="hk-who-label">{es ? e.es : e.en}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.whyTitle')}</h2>
    <p class="hk-why-intro">{es ? data.whyIntroEs : data.whyIntroEn}</p>
    <div class="hk-why-grid">
      {data.whyCases.map((c, i) => (
        <article class={`hk-case ${c.accent}`}>
          <div class="hk-case-head">
            <span class="hk-case-ic" set:html={caseIcons[i % caseIcons.length]} />
            <h3 class="hk-case-area">{es ? c.areaEs : c.areaEn}</h3>
          </div>
          <p class="hk-case-body" set:html={es ? c.bodyEs : c.bodyEn}></p>
        </article>
      ))}
    </div>
    <p class="hk-why-close">{es ? data.whyCloseEs : data.whyCloseEn}</p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.tracksTitle')}</h2>
    <div class="hk-tracks">
      {data.tracks.map(track => (
        <div class={`hk-track ${track.accent}`}>
          <div class="hk-track-bar"></div>
          <div class="hk-track-tx">
            <h3>{es ? track.titleEs : track.titleEn}</h3>
            <p class="hk-track-desc">{es ? track.descEs : track.descEn}</p>
            <ul class="hk-track-subs">
              {track.subareas.map(s => (
                <li>{es ? s.es : s.en}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.agendaTitle')}</h2>
    <p class="hk-agenda-note">{t(locale, 'hackathon.agendaNote')}</p>
    <ol class="hk-timeline">
      {data.schedule.map((day, i) => (
        <li class={`hk-tl-item ${day.accent ?? ['is-green','is-blue','is-yellow'][i % 3]}`} style={`--ti:${i}`}>
          <span class="hk-tl-marker">{i + 1}</span>
          <div class="hk-tl-body">
            <span class="hk-tl-day">{es ? day.day : day.dayEn}</span>
            <ul class="hk-tl-acts">
              {day.events.map((ev) => {
                const note = es ? ev.note : ev.noteEn;
                return (
                  <li class="hk-tl-act">
                    <span class="hk-tl-time">{es ? ev.time : ev.timeEn}</span>
                    <span class="hk-tl-act-tx">
                      {es ? ev.title : ev.titleEn}
                      {note && <span class="hk-tl-note">{note}</span>}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        </li>
      ))}
    </ol>
    <div class="hk-deliverable">
      <span class="hk-deliverable-ic" set:html={ic('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>')} />
      <div class="hk-deliverable-tx">
        <span class="hk-deliverable-label">{t(locale, 'hackathon.deliverableLabel')}</span>
        <p>{submission}</p>
      </div>
    </div>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.prizesTitle')}</h2>
    <div class="hk-prize">
      <p class="hk-prize-amount">{es ? data.prizesDetail.amountEs : data.prizesDetail.amountEn}</p>
      <p class="hk-prize-head">{es ? data.prizesDetail.headlineEs : data.prizesDetail.headlineEn}</p>
      <p class="hk-prize-total">{es ? data.prizesDetail.totalEs : data.prizesDetail.totalEn}</p>
      <div class="hk-pills">
        {data.prizesDetail.perks.map(perk => (
          <span class="hk-pill">{es ? perk.es : perk.en}</span>
        ))}
      </div>
      <p class="hk-prize-extra" set:html={es ? data.prizesDetail.fellowsEs : data.prizesDetail.fellowsEn} />
      <div class="hk-success">
        <h3 class="hk-success-title">{es ? data.prizesDetail.successTitleEs : data.prizesDetail.successTitleEn}</h3>
        <ul class="hk-success-list">
          {data.prizesDetail.successExamples.map(ex => (
            <li set:html={es ? ex.es : ex.en} />
          ))}
        </ul>
        <a
          class="hk-success-src"
          href="https://apartresearch.com/impact"
          target="_blank"
          rel="noopener noreferrer"
        >{t(locale, 'hackathon.sourceLabel')}</a>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.hubsTitle')}</h2>
    <div class="hk-globe-wrap">
      <div class="hk-globe" aria-hidden="true">
        <svg viewBox="0 0 240 240" role="presentation" focusable="false">
          <defs>
            <radialGradient id="hkOcean" cx="40%" cy="34%" r="80%">
              <stop offset="0%" stop-color="#F4FBF7" />
              <stop offset="58%" stop-color="#E6F5EC" />
              <stop offset="100%" stop-color="#D2EBDD" />
            </radialGradient>
            <radialGradient id="hkShade" cx="36%" cy="30%" r="78%">
              <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.55" />
              <stop offset="54%" stop-color="#FFFFFF" stop-opacity="0" />
              <stop offset="100%" stop-color="#0A3D24" stop-opacity="0.20" />
            </radialGradient>
            <clipPath id="hkGlobeClip">
              <circle cx="120" cy="120" r="90" />
            </clipPath>
            <pattern id="hkDots" width="6.6" height="6.6" patternUnits="userSpaceOnUse">
              <circle cx="2.1" cy="2.1" r="1.45" fill="#1F4D32" />
            </pattern>
            <!-- Equirectangular world map (one 240-wide tile = full globe).
                 Continents in roughly correct positions/proportions; the
                 dot-pattern fill reads as a stylised world map. -->
            <g id="hkLand" fill="url(#hkDots)">
              <!-- North America -->
              <path d="M22 70 C18 60 31 53 45 53 C59 51 75 56 83 64 C87 70 82 79 76 83 C84 87 86 97 80 105 C74 113 64 113 60 121 C58 127 56 133 52 133 C48 129 50 118 46 112 C40 108 34 108 30 100 C24 94 28 86 26 80 C25 76 23 73 22 70 Z" />
              <!-- Greenland -->
              <path d="M98 52 C106 50 113 54 111 62 C109 69 100 71 96 66 C93 62 94 55 98 52 Z" />
              <!-- South America -->
              <path d="M70 127 C79 125 89 130 91 140 C93 150 86 159 84 169 C82 179 78 191 72 195 C68 197 65 188 65 180 C65 170 60 162 62 152 C63 143 64 133 70 127 Z" />
              <!-- Europe -->
              <path d="M116 66 C122 62 132 62 140 66 C146 69 144 76 138 78 C132 80 128 84 122 82 C117 80 112 78 112 72 C112 69 114 67 116 66 Z" />
              <!-- Africa -->
              <path d="M120 86 C132 84 146 87 152 97 C156 105 152 115 150 124 C156 128 156 136 150 141 C146 151 142 163 134 171 C128 177 124 170 124 162 C124 150 116 143 116 131 C116 118 110 108 112 98 C113 92 115 88 120 86 Z" />
              <!-- Asia -->
              <path d="M146 74 C150 64 162 58 178 58 C198 56 219 60 228 70 C232 78 226 87 218 89 C224 95 222 105 214 107 C206 109 198 105 192 109 C190 117 188 127 182 129 C178 131 176 122 176 114 C170 116 164 114 162 108 C156 110 150 106 148 98 C146 90 144 82 146 74 Z" />
              <!-- SE Asia / Indonesia -->
              <ellipse cx="192" cy="120" rx="4" ry="2.4" />
              <ellipse cx="202" cy="127" rx="5" ry="2.6" />
              <ellipse cx="210" cy="121" rx="3" ry="2" />
              <!-- Australia -->
              <path d="M203 143 C211 141 221 143 225 151 C227 159 220 167 212 169 C204 171 198 164 198 156 C198 150 199 146 203 143 Z" />
            </g>
          </defs>
          <circle cx="120" cy="120" r="90" fill="url(#hkOcean)" />
          <g clip-path="url(#hkGlobeClip)">
            <g class="hk-globe-rot">
              <use href="#hkLand" />
              <use href="#hkLand" x="240" />
            </g>
          </g>
          <circle cx="120" cy="120" r="90" fill="url(#hkShade)" />
          <g class="hk-grid" stroke="rgba(33,26,18,0.10)" fill="none" stroke-width="1">
            <circle cx="120" cy="120" r="90" stroke="rgba(33,26,18,0.18)" />
            <ellipse cx="120" cy="120" rx="45" ry="90" />
            <ellipse cx="120" cy="120" rx="90" ry="45" />
            <line x1="30" y1="120" x2="210" y2="120" />
            <line x1="120" y1="30" x2="120" y2="210" />
          </g>
          <g class="hk-arcs" stroke-linecap="round" fill="none" stroke-width="2">
            <path d="M92 150 Q 118 92 140 168" />
            <path d="M92 150 Q 150 108 172 102" />
          </g>
          <circle class="hk-node is-coral" cx="140" cy="168" r="5" />
          <circle class="hk-node is-blue" cx="172" cy="102" r="5" />
          <circle class="hk-hub-halo" cx="92" cy="150" r="9" />
          <circle class="hk-hub-core" cx="92" cy="150" r="5.5" />
          <ellipse class="hk-orbit" cx="120" cy="120" rx="110" ry="46"
            fill="none" stroke="var(--accent-forest)" stroke-width="1.5"
            stroke-dasharray="3 9" stroke-linecap="round" />
        </svg>
      </div>
      <div class="hk-regions">
      {regions.map(region => (
        <article class={`hk-region ${region.accent}`}>
          <div class="hk-region-head">
            <h3>{es ? region.nameEs : region.nameEn}</h3>
            <span class="hk-region-meta">
              {es ? region.teamsEs : region.teamsEn} · {es ? region.prizeEs : region.prizeEn}
            </span>
          </div>
          <ul class="hk-cities">
            {region.cities.map((city, ci) => (
              <li
                class={`hk-city${city.bogota ? ' is-bogota' : ''}${city.tbd ? ' is-tbd' : ''}`}
                style={`--ci:${ci}`}
              >
                <span class="hk-city-dot" aria-hidden="true"></span>
                <span class="hk-city-name">{es ? (city.nameEs ?? city.name) : city.name}</span>
                {city.bogota && (
                  <span class="hk-city-tag">{t(locale, 'hackathon.ourHub')}</span>
                )}
              </li>
            ))}
          </ul>
        </article>
      ))}
      </div>
    </div>
    <p class="hk-note">{t(locale, 'hackathon.hubsNote')}</p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.speakersTitle')}</h2>
    <div class="hk-people">
      {speakers.map((sp, i) => (
        <article class={`hk-person ${['is-green','is-coral','is-blue','is-yellow'][i % 4]}`}>
          {sp.photo
            ? <img class="hk-person-av" src={`/people/${sp.photo}`} alt="" width="104" height="104" />
            : <div class="hk-person-av" aria-hidden="true">{initials(sp.name)}</div>}
          <div class="hk-person-tx">
            <h3>{sp.name}</h3>
            <p class="hk-person-aff">{es ? sp.affiliationEs : sp.affiliationEn}</p>
            {sp.attendance && (
              <span class={`hk-att hk-att-${sp.attendance}`}>{attLabel(sp.attendance)}</span>
            )}
            {(es ? sp.bioEs : sp.bioEn) && <p class="hk-person-bio" set:html={es ? sp.bioEs : sp.bioEn} />}
            {sp.linkedin && (
              <a
                class="hk-person-link"
                href={sp.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`LinkedIn — ${sp.name}`}
              >
                <span class="hk-li-icon" set:html={linkedinIcon} />
                <span>LinkedIn</span>
              </a>
            )}
            {sp.openreview && (
              <a
                class="hk-person-link"
                href={sp.openreview}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`OpenReview — ${sp.name}`}
              >
