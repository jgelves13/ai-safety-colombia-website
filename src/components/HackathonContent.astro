---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import data from '../data/hackathon.json';
import { daysUntil } from '../utils/countdown.js';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

const daysLeft = daysUntil(data.date);
const whatBody = es ? data.whatIsEs : data.whatIsEn;
const submission = es ? data.submissionEs : data.submissionEn;

type Person = {
  name: string;
  affiliationEs?: string;
  affiliationEn?: string;
  attendance?: 'inperson' | 'remote' | 'tbc';
  evalTopicEs?: string;
  evalTopicEn?: string;
  bioEs?: string;
  bioEn?: string;
  linkedin?: string;
  photo?: string;
};
const judges = data.judges as Person[];
const speakers = data.speakers as Person[];

type City = { name: string; bogota?: boolean; tbd?: boolean };
type Region = {
  nameEs: string;
  nameEn: string;
  accent: string;
  teamsEs: string;
  teamsEn: string;
  prizeEs: string;
  prizeEn: string;
  cities: City[];
};
const regions = data.regions as Region[];

// Brand LinkedIn glyph, injected inline so the link carries a real logo
// (not a text arrow). The anchor owns the accessible name; mark decorative.
const linkedinIcon =
  '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>';

const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();

// Attendance badge label (key cast: dynamic suffix off the literal union)
const attLabel = (a?: Person['attendance']) =>
  a ? t(locale, `hackathon.att.${a}` as Parameters<typeof t>[1]) : '';

// One line-icon per eligibility profile, in data order (chip, chart,
// scales, brackets, shield, cap). Decorative: cards own the text label.
const ic = (paths: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${paths}</svg>`;
const whoIcons = [
  ic('<rect x="7" y="7" width="10" height="10" rx="1.5"/><path d="M10 3v2M14 3v2M10 19v2M14 19v2M3 10h2M3 14h2M19 10h2M19 14h2"/>'),
  ic('<path d="M4 19V5M4 19h16"/><path d="M7 15l3.5-4 3 2.5L20 7"/>'),
  ic('<path d="M12 4v16M7 20h10M5 8h14M5 8l-2.5 5a3 3 0 0 0 5 0L5 8zM19 8l-2.5 5a3 3 0 0 0 5 0L19 8z"/>'),
  ic('<path d="M9 7l-5 5 5 5M15 7l5 5-5 5"/>'),
  ic('<path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>'),
  ic('<path d="M12 4L2 9l10 5 10-5-10-5z"/><path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/>'),
];
const whoAccents = ['is-green', 'is-coral', 'is-blue', 'is-yellow'];
---

<section class="hk-hero">
  <div class="container">
    <p class="hk-kicker">{t(locale, 'hackathon.kicker')}</p>
    <h1 class="hk-h1">{t(locale, 'hackathon.h1a')} <span class="hk-accent">{t(locale, 'hackathon.h1b')}</span></h1>
    <p class="hk-sub">{t(locale, 'hackathon.sub')}</p>
    <p class="hk-hook">{t(locale, 'hackathon.hook')}</p>
    <div class="hk-cta">
      <a href={data.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t(locale, 'hackathon.ctaPrimary')} &rarr;</a>
      <a href={data.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">{t(locale, 'hackathon.ctaSecondary')}</a>
      <div class="hk-count">
        <span class="hk-count-num" data-hackathon-date={data.date} aria-live="polite">{daysLeft}</span>
        <span class="hk-count-label">{t(locale, 'hackathon.countdownLabel')}</span>
      </div>
    </div>
  </div>
</section>

<section class="section hk-intro">
  <div class="container hk-narrow">
    <h2 class="section-title">{t(locale, 'hackathon.whatTitle')}</h2>
    <p class="hk-lead">{whatBody}</p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.whyTitle')}</h2>
    <p class="hk-why-lead">{es ? data.whyLeadEs : data.whyLeadEn}</p>
    <h3 class="hk-pathway-label">{es ? data.pathwayLabelEs : data.pathwayLabelEn}</h3>
    <ol class="hk-steps">
      {data.pipeline.map((step, i) => (
        <li class={`hk-step ${['is-green','is-coral','is-blue'][i % 3]}`} style={`--si:${i}`}>
          <div class="hk-step-marker">{i + 1}</div>
          <div class="hk-step-body">
            <span class="hk-step-kicker">{t(locale, 'hackathon.stepLabel')} {i + 1}</span>
            <h4 class="hk-step-title">{es ? step.stepEs : step.stepEn}</h4>
            <p class="hk-step-desc">{es ? step.descEs : step.descEn}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.tracksTitle')}</h2>
    <div class="hk-tracks">
      {data.tracks.map(track => (
        <div class={`hk-track ${track.accent}`}>
          <div class="hk-track-bar"></div>
          <div class="hk-track-tx">
            <h3>{es ? track.titleEs : track.titleEn}</h3>
            <p class="hk-track-desc">{es ? track.descEs : track.descEn}</p>
            <ul class="hk-track-subs">
              {track.subareas.map(s => (
                <li>{es ? s.es : s.en}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.prizesTitle')}</h2>
    <div class="hk-prize">
      <p class="hk-prize-amount">{es ? data.prizesDetail.amountEs : data.prizesDetail.amountEn}</p>
      <p class="hk-prize-head">{es ? data.prizesDetail.headlineEs : data.prizesDetail.headlineEn}</p>
      <p class="hk-prize-total">{es ? data.prizesDetail.totalEs : data.prizesDetail.totalEn}</p>
      <div class="hk-pills">
        {data.prizesDetail.perks.map(perk => (
          <span class="hk-pill">{es ? perk.es : perk.en}</span>
        ))}
      </div>
      <p class="hk-prize-extra">{es ? data.prizesDetail.fellowsEs : data.prizesDetail.fellowsEn}</p>
      <div class="hk-success">
        <h3 class="hk-success-title">{es ? data.prizesDetail.successTitleEs : data.prizesDetail.successTitleEn}</h3>
        <ul class="hk-success-list">
          {data.prizesDetail.successExamples.map(ex => (
            <li>{es ? ex.es : ex.en}</li>
          ))}
        </ul>
        <a
          class="hk-success-src"
          href="https://apartresearch.com/impact"
          target="_blank"
          rel="noopener noreferrer"
        >{t(locale, 'hackathon.sourceLabel')} &rarr;</a>
      </div>
    </div>
    <p class="hk-note hk-venue-note">{es ? data.prizesDetail.venueNoteEs : data.prizesDetail.venueNoteEn}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.hubsTitle')}</h2>
    <div class="hk-globe-wrap">
      <div class="hk-globe" aria-hidden="true">
        <svg viewBox="0 0 240 240" role="presentation" focusable="false">
          <defs>
            <radialGradient id="hkOcean" cx="40%" cy="34%" r="80%">
              <stop offset="0%" stop-color="#EAFBF1" />
              <stop offset="58%" stop-color="#CFF3DF" />
              <stop offset="100%" stop-color="#A6E7C4" />
            </radialGradient>
            <radialGradient id="hkShade" cx="36%" cy="32%" r="76%">
              <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.5" />
              <stop offset="55%" stop-color="#FFFFFF" stop-opacity="0" />
              <stop offset="100%" stop-color="#0A3D24" stop-opacity="0.22" />
            </radialGradient>
            <clipPath id="hkGlobeClip">
              <circle cx="120" cy="120" r="90" />
            </clipPath>
            <g id="hkLand" fill="#41C184" fill-opacity="0.7">
              <path d="M40 52 C52 54 58 66 54 80 C50 92 60 98 58 110 C56 122 66 128 60 146 C56 160 48 176 40 186 C34 178 36 164 40 150 C44 138 36 130 38 116 C40 102 30 96 32 82 C34 68 32 58 40 52 Z" />
              <path d="M118 50 C132 50 144 58 142 70 C140 80 128 82 124 92 C132 100 138 112 134 128 C130 146 120 168 116 188 C113 196 108 190 108 178 C108 162 100 150 102 132 C104 116 94 108 98 94 C101 82 96 70 104 60 C109 53 112 50 118 50 Z" />
              <path d="M170 56 C186 52 206 56 212 68 C216 78 206 86 196 86 C204 94 200 106 188 108 C176 110 168 102 166 92 C164 84 156 82 158 72 C160 62 162 58 170 56 Z" />
              <path d="M198 152 C210 150 220 156 220 164 C220 172 210 178 200 176 C192 174 188 166 190 160 C191 155 194 153 198 152 Z" />
              <ellipse cx="150" cy="58" rx="5" ry="3" />
              <ellipse cx="224" cy="130" rx="4" ry="3" />
            </g>
          </defs>
          <circle cx="120" cy="120" r="90" fill="url(#hkOcean)" />
          <g clip-path="url(#hkGlobeClip)">
            <g class="hk-globe-rot">
              <use href="#hkLand" />
              <use href="#hkLand" x="240" />
            </g>
          </g>
          <circle cx="120" cy="120" r="90" fill="url(#hkShade)" />
          <g class="hk-grid" stroke="rgba(16,16,16,0.13)" fill="none" stroke-width="1">
            <circle cx="120" cy="120" r="90" />
            <ellipse cx="120" cy="120" rx="34" ry="90" />
            <ellipse cx="120" cy="120" rx="68" ry="90" />
            <ellipse cx="120" cy="120" rx="90" ry="34" />
            <ellipse cx="120" cy="120" rx="90" ry="68" />
            <line x1="30" y1="120" x2="210" y2="120" />
            <line x1="120" y1="30" x2="120" y2="210" />
          </g>
          <g class="hk-arcs" stroke-linecap="round" fill="none" stroke-width="2">
            <path d="M92 150 Q 118 92 140 168" />
            <path d="M92 150 Q 150 108 172 102" />
          </g>
          <circle class="hk-node is-coral" cx="140" cy="168" r="5" />
          <circle class="hk-node is-blue" cx="172" cy="102" r="5" />
          <circle class="hk-hub-halo" cx="92" cy="150" r="9" />
          <circle class="hk-hub-core" cx="92" cy="150" r="5.5" />
          <ellipse class="hk-orbit" cx="120" cy="120" rx="110" ry="46"
            fill="none" stroke="var(--accent-green)" stroke-width="1.5"
            stroke-dasharray="3 9" stroke-linecap="round" />
        </svg>
      </div>
      <div class="hk-regions">
      {regions.map(region => (
        <article class={`hk-region ${region.accent}`}>
          <div class="hk-region-head">
            <h3>{es ? region.nameEs : region.nameEn}</h3>
            <span class="hk-region-meta">
              {es ? region.teamsEs : region.teamsEn} · {es ? region.prizeEs : region.prizeEn}
            </span>
          </div>
          <ul class="hk-cities">
            {region.cities.map((city, ci) => (
              <li
                class={`hk-city${city.bogota ? ' is-bogota' : ''}${city.tbd ? ' is-tbd' : ''}`}
                style={`--ci:${ci}`}
              >
                <span class="hk-city-dot" aria-hidden="true"></span>
                <span class="hk-city-name">{city.name}</span>
                {city.bogota && (
                  <span class="hk-city-tag">{t(locale, 'hackathon.ourHub')}</span>
                )}
              </li>
            ))}
          </ul>
        </article>
      ))}
      </div>
    </div>
    <p class="hk-note">{t(locale, 'hackathon.hubsNote')}</p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.whoTitle')}</h2>
    <ul class="hk-who">
      {data.eligibility.map((e, i) => (
        <li class={`hk-who-card ${whoAccents[i % whoAccents.length]}`} style={`--wi:${i}`}>
          <span class="hk-who-ic" set:html={whoIcons[i % whoIcons.length]} />
          <span class="hk-who-label">{es ? e.es : e.en}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.agendaTitle')}</h2>
    <ol class="hk-timeline">
      {data.schedule.map((day, i) => (
        <li class={`hk-tl-item ${day.accent ?? ['is-green','is-blue','is-yellow'][i % 3]}`} style={`--ti:${i}`}>
          <span class="hk-tl-marker">{i + 1}</span>
          <div class="hk-tl-body">
            <span class="hk-tl-day">{es ? day.day : day.dayEn}</span>
            <p class="hk-tl-act">{es ? day.events[0].title : day.events[0].titleEn}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="hk-deliverable">
      <span class="hk-deliverable-ic" set:html={ic('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>')} />
      <div class="hk-deliverable-tx">
        <span class="hk-deliverable-label">{t(locale, 'hackathon.deliverableLabel')}</span>
        <p>{submission}</p>
      </div>
    </div>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.speakersTitle')}</h2>
    <div class="hk-people">
      {speakers.map((sp, i) => (
        <article class={`hk-person ${['is-green','is-coral','is-blue','is-yellow'][i % 4]}`}>
          {sp.photo
            ? <img class="hk-person-av" src={`/people/${sp.photo}`} alt="" width="104" height="104" />
            : <div class="hk-person-av" aria-hidden="true">{initials(sp.name)}</div>}
          <div class="hk-person-tx">
            <h3>{sp.name}</h3>
            <p class="hk-person-aff">{es ? sp.affiliationEs : sp.affiliationEn}</p>
            {sp.attendance && (
              <span class={`hk-att hk-att-${sp.attendance}`}>{attLabel(sp.attendance)}</span>
            )}
            {(es ? sp.bioEs : sp.bioEn) && <p class="hk-person-bio">{es ? sp.bioEs : sp.bioEn}</p>}
            {sp.linkedin && (
              <a
                class="hk-person-link"
                href={sp.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`LinkedIn — ${sp.name}`}
              >
                <span class="hk-li-icon" set:html={linkedinIcon} />
                <span>LinkedIn</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2 class="section-title">{t(locale, 'hackathon.judgesTitle')}</h2>
    {judges.length > 0 ? (
      <div class="hk-people">
        {judges.map((j, i) => (
          <article class={`hk-person ${['is-green','is-coral','is-blue','is-yellow'][i % 4]}`}>
            {j.photo
              ? <img class="hk-person-av" src={`/people/${j.photo}`} alt="" width="104" height="104" />
              : <div class="hk-person-av" aria-hidden="true">{initials(j.name)}</div>}
            <div class="hk-person-tx">
              <h3>{j.name}</h3>
              {(es ? j.affiliationEs : j.affiliationEn) && (
                <p class="hk-person-aff">{es ? j.affiliationEs : j.affiliationEn}</p>
              )}
              {j.attendance && (
                <span class={`hk-att hk-att-${j.attendance}`}>{attLabel(j.attendance)}</span>
              )}
              {(es ? j.evalTopicEs : j.evalTopicEn) && (
                <p class="hk-person-eval">
                  <span class="hk-person-eval-label">{t(locale, 'hackathon.judgeEvalLabel')}</span>
                  {es ? j.evalTopicEs : j.evalTopicEn}
                </p>
              )}
              {(es ? j.bioEs : j.bioEn) && <p class="hk-person-bio">{es ? j.bioEs : j.bioEn}</p>}
              {j.linkedin && (
                <a
                  class="hk-person-link"
                  href={j.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`LinkedIn — ${j.name}`}
                >
                  <span class="hk-li-icon" set:html={linkedinIcon} />
                  <span>LinkedIn</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="hk-note">{t(locale, 'hackathon.judgesTba')}</p>
    )}
  </div>
</section>

<section class="hk-band">
  <div class="container">
    <h2 class="hk-band-title">{t(locale, 'hackathon.ctaBandTitle')}</h2>
    <p class="hk-band-sub">{t(locale, 'hackathon.ctaBandSub')}</p>
    <a href={data.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t(locale, 'hackathon.ctaPrimary')} &rarr;</a>
    <p class="hk-band-mail">{data.contactEmail}</p>
  </div>
</section>

<style>
  .hk-hero {
    padding: 9rem 1.5rem 4rem;
    background: linear-gradient(180deg, #F1F8F2, #FFFFFF);
  }

  .hk-kicker {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--green-text);
  }

  .hk-h1 {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.03;
    margin: 0.5rem 0;
    color: var(--text-primary);
  }

  .hk-accent {
    color: var(--accent-green);
  }

  .hk-sub {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 600px;
    line-height: 1.55;
  }

  .hk-hook {
    margin-top: 1rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .hk-cta {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hk-count {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .hk-count-num {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--green-text);
  }

  .hk-count-label {
    color: var(--text-secondary);
    font-size: 0.8125rem;
  }

  .hk-narrow {
    max-width: 760px;
  }

  .hk-lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .hk-tracks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .hk-track {
    display: flex;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    background: #FFFFFF;
  }

  .hk-track-bar {
    width: 5px;
    flex: none;
    border-radius: 4px;
  }

  .hk-track.is-green .hk-track-bar { background: var(--accent-green); }
  .hk-track.is-coral .hk-track-bar { background: var(--accent-coral); }
  .hk-track.is-blue .hk-track-bar { background: var(--accent-blue); }
  .hk-track.is-yellow .hk-track-bar { background: var(--accent-yellow-line); }

  .hk-track h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.375rem;
  }

  .hk-track p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .hk-prize {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
    background: #FFFFFF;
  }

  .hk-prize-amount {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--green-text);
  }

  .hk-prize-head {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 0.25rem;
  }

  .hk-prize-total {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }

  .hk-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .hk-pill {
    font-size: 0.8125rem;
    font-weight: 600;
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.375rem 0.875rem;
    color: var(--text-primary);
  }

  /* Regional map: one card per region, cities animate in on load,
     Bogotá (our hub) gets a pulsing dot + tag. */
  .hk-regions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .hk-region {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    background: #FFFFFF;
    border-top: 4px solid var(--border);
  }

  .hk-region.is-green { border-top-color: var(--accent-green); }
  .hk-region.is-coral { border-top-color: var(--accent-coral); }
  .hk-region.is-blue { border-top-color: var(--accent-blue); }
