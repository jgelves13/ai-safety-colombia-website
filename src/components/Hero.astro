---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const titleWords = t(locale, 'hero.title').split(' ');
const firstWord = titleWords[0];
const accentWord = titleWords[1] ?? '';
const restWords = titleWords.slice(2).join(' ');
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title">{firstWord} <span class="hero-accent">{accentWord}</span>{restWords ? ` ${restWords}` : ''}</h1>
      <p class="hero-subtitle">{t(locale, 'hero.subtitle')}</p>
      <div class="hero-actions">
        <a href={localePath(locale, '/involucrate/')} class="btn btn-primary">
          {t(locale, 'hero.cta-primary')} &rarr;
        </a>
        <a href={localePath(locale, '/recursos/')} class="btn btn-secondary">
          {t(locale, 'hero.cta-secondary')}
        </a>
      </div>
      <p class="hero-credibility">{t(locale, 'hero.credibility')}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 4rem 1.5rem 5.5rem;
    text-align: left;
    border-bottom: 1px solid var(--hairline);
  }

  .hero-content {
    max-width: 1100px;
    margin: 0 auto;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 7.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.92;
    margin-bottom: 2rem;
    color: var(--text-primary);
    max-width: 14ch;
  }

  .hero-accent {
    color: var(--accent-vermillion);
  }

  .hero-subtitle {
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    line-height: 1.5;
    max-width: 60ch;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-credibility {
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2.5rem 1rem 3.5rem;
    }
  }
</style>
