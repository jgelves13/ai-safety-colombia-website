---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const titleWords = t(locale, 'hero.title').split(' ');
const firstWord = titleWords[0];
const accentWord = titleWords[1] ?? '';
const restWords = titleWords.slice(2).join(' ');
---

<section class="hero">
  <span class="hero-s2" aria-hidden="true"></span>
  <span class="hero-s3" aria-hidden="true"></span>
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title">{firstWord} <span class="hero-accent">{accentWord}</span>{restWords ? ` ${restWords}` : ''}</h1>
      <p class="hero-subtitle">{t(locale, 'hero.subtitle')}</p>
      <div class="hero-actions">
        <a href={localePath(locale, '/involucrate/')} class="btn btn-primary">
          {t(locale, 'hero.cta-primary')}
        </a>
        <a href={localePath(locale, '/recursos/')} class="btn btn-secondary">
          {t(locale, 'hero.cta-secondary')}
        </a>
      </div>
      <p class="hero-credibility">{t(locale, 'hero.credibility')}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 2.75rem 1.5rem 6rem;
    text-align: left;
    border-bottom: 1px solid var(--hairline);
  }

  .hero-s2 {
    position: absolute;
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
    width: 190px;
    height: 190px;
    background: var(--accent-vermillion);
    bottom: 20px;
    right: 310px;
    display: none;
  }

  .hero-s3 {
    position: absolute;
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
    width: 120px;
    height: 120px;
    background: transparent;
    border: 12px solid var(--accent-forest);
    bottom: 60px;
    right: 40px;
    display: none;
  }

  @media (min-width: 1024px) {
    .hero-s2, .hero-s3 { display: block; }
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }


  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.96;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
    max-width: 14ch;
  }

  .hero-accent {
    color: var(--accent-forest);
    background: var(--accent-yellow);
    padding: 0 0.12em;
    border-radius: 6px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .hero-subtitle {
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
    line-height: 1.5;
    max-width: 60ch;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-credibility {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2.5rem 1rem 3.5rem;
    }
  }
</style>
