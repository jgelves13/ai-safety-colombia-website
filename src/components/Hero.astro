---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title">{t(locale, 'hero.title')}</h1>
      <p class="hero-subtitle">{t(locale, 'hero.subtitle')}</p>
      <div class="hero-actions">
        <a href={localePath(locale, '/involucrate/')} class="btn btn-primary">
          {t(locale, 'hero.cta-primary')}
        </a>
        <a href={localePath(locale, '/recursos/')} class="btn btn-secondary">
          {t(locale, 'hero.cta-secondary')}
        </a>
      </div>
    </div>
    <div class="hero-glow"></div>
  </div>
</section>

<style>
  .hero {
    padding: 8rem 1.5rem 5rem;
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: var(--text-secondary);
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(45, 212, 191, 0.08) 0%, rgba(167, 139, 250, 0.04) 40%, transparent 70%);
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 6rem 1rem 3rem;
    }
  }
</style>
