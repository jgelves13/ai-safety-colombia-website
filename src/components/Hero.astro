---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="hero">
  <div class="hero-dots"></div>
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title">{t(locale, 'hero.title')}</h1>
      <p class="hero-subtitle">{t(locale, 'hero.subtitle')}</p>
      <div class="hero-actions">
        <a href={localePath(locale, '/involucrate/')} class="btn btn-primary">
          {t(locale, 'hero.cta-primary')} &rarr;
        </a>
        <a href={localePath(locale, '/recursos/')} class="btn btn-secondary">
          {t(locale, 'hero.cta-secondary')} &rarr;
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 10rem 1.5rem 6rem;
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .hero-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, #333 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.3;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 750px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .hero-subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 7rem 1rem 4rem;
    }
  }
</style>
