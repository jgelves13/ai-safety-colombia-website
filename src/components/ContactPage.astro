---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const EMAIL = 'aisafetycolombia@gmail.com';
const WHATSAPP = 'https://chat.whatsapp.com/KwE8cciX48TAVhAOHnrLaZ';
const INSTAGRAM = 'https://www.instagram.com/aisafetycolombia/';
const LINKEDIN = 'https://www.linkedin.com/company/ai-safety-col/';
---

<PageHero title={t(locale, 'contact.hero.title')} desc={t(locale, 'contact.hero.subtitle')} />

<section class="section contact-section">
  <span class="contact-shape contact-shape-1" aria-hidden="true"></span>
  <span class="contact-shape contact-shape-2" aria-hidden="true"></span>

  <div class="container contact-grid">
    <aside class="contact-aside">
      <span class="section-label contact-kicker">{t(locale, 'contact.channelsKicker')}</span>
      <h2 class="contact-h">{t(locale, 'contact.channelsTitle')}</h2>

      <div class="ch-list">
        <a class="ch-card ch-email" href={`mailto:${EMAIL}`}>
          <span class="ch-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
              <path d="M3.5 6.5 12 13l8.5-6.5" />
            </svg>
          </span>
          <span class="ch-tx">
            <span class="ch-name">Email</span>
            <span class="ch-value">{EMAIL}</span>
          </span>
          <span class="ch-arrow" aria-hidden="true">&rarr;</span>
        </a>

        <a class="ch-card ch-whatsapp" href={WHATSAPP} target="_blank" rel="noopener noreferrer">
          <span class="ch-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5c0 4.1-4 7.5-9 7.5-1.3 0-2.6-.2-3.7-.7L3 20l1.4-3.9C3.5 14.8 3 13.2 3 11.5 3 7.4 7 4 12 4s9 3.4 9 7.5Z" />
              <circle cx="8.5" cy="11.7" r="1.05" fill="currentColor" stroke="none" />
              <circle cx="12" cy="11.7" r="1.05" fill="currentColor" stroke="none" />
              <circle cx="15.5" cy="11.7" r="1.05" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <span class="ch-tx">
            <span class="ch-name">WhatsApp</span>
            <span class="ch-value">{t(locale, 'contact.whatsappValue')}</span>
          </span>
          <span class="ch-arrow" aria-hidden="true">&rarr;</span>
        </a>

        <a class="ch-card ch-instagram" href={INSTAGRAM} target="_blank" rel="noopener noreferrer">
          <span class="ch-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.1" cy="6.9" r="1.2" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <span class="ch-tx">
            <span class="ch-name">Instagram</span>
            <span class="ch-value">@aisafetycolombia</span>
          </span>
          <span class="ch-arrow" aria-hidden="true">&rarr;</span>
        </a>

        <a class="ch-card ch-linkedin" href={LINKEDIN} target="_blank" rel="noopener noreferrer">
          <span class="ch-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.5" y="7.5" width="19" height="12.5" rx="2.5" />
              <path d="M8.5 7.5V6A2.5 2.5 0 0 1 11 3.5h2A2.5 2.5 0 0 1 15.5 6v1.5" />
              <path d="M2.5 12.5h19" />
            </svg>
          </span>
          <span class="ch-tx">
            <span class="ch-name">LinkedIn</span>
            <span class="ch-value">AI Safety Colombia</span>
          </span>
          <span class="ch-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </aside>

    <div class="contact-form-card">
      <span class="section-label contact-kicker">{t(locale, 'contact.formKicker')}</span>
      <h2 class="contact-h">{t(locale, 'contact.formTitle')}</h2>

      <form id="contact-form" class="cf" novalidate>
        <div class="cf-field">
          <label for="name">{t(locale, 'contact.formName')}</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="cf-field">
          <label for="email">{t(locale, 'contact.formEmail')}</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="cf-field">
          <label for="message">{t(locale, 'contact.formMessage')}</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary cf-submit">{t(locale, 'contact.formSubmit')}</button>
        <p class="cf-note">{t(locale, 'contact.formNote')}</p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    overflow: hidden;
  }

  /* Decorative shapes — bleed off the section edges, behind content */
  .contact-shape {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }

  .contact-shape-1 {
    width: 210px;
    height: 210px;
    border-radius: 50%;
    background: var(--accent-vermillion);
    opacity: 0.5;
    top: 90px;
    right: -85px;
  }

  .contact-shape-2 {
    width: 210px;
    height: 210px;
    border-radius: 50%;
    border: 28px solid var(--accent-sage);
    opacity: 0.55;
    bottom: 60px;
    left: -95px;
  }

  .contact-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .contact-kicker {
    margin-bottom: 0.875rem;
  }

  .contact-h {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  /* ---- Channels ---- */
  .ch-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .ch-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 1rem 1.125rem;
    transition: border-color 0.15s, transform 0.15s;
  }

  .ch-card:hover {
    border-color: var(--text-primary);
    transform: translateY(-2px);
  }

  .ch-icon {
    flex: none;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    color: var(--bg-elevated);
  }

  .ch-icon svg {
    width: 23px;
    height: 23px;
  }

  .ch-email .ch-icon { background: var(--accent-forest); }
  .ch-whatsapp .ch-icon { background: var(--accent-sage); }
  .ch-instagram .ch-icon { background: var(--accent-vermillion); }
  .ch-linkedin .ch-icon {
    background: var(--accent-yellow);
    color: var(--text-primary);
  }

  .ch-tx {
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    min-width: 0;
  }

  .ch-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .ch-value {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ch-arrow {
    margin-left: auto;
    flex: none;
    font-size: 1.05rem;
    color: var(--text-secondary);
    transition: transform 0.15s, color 0.15s;
  }

  .ch-card:hover .ch-arrow {
    transform: translateX(3px);
    color: var(--text-primary);
  }

  /* ---- Message form ---- */
  .contact-form-card {
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 2.25rem;
  }

  .cf {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .cf-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cf-field label {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .cf-field input,
  .cf-field textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    background: var(--bg-primary);
    border: 1.5px solid var(--border);
    border-radius: 14px;
    color: var(--text-primary);
    font-size: 0.9375rem;
    font-family: var(--font-body);
    transition: border-color 0.15s, background 0.15s;
  }

  .cf-field textarea {
    resize: vertical;
    min-height: 120px;
  }

  .cf-field input:focus,
  .cf-field textarea:focus {
    border-color: var(--accent-forest);
    background: var(--bg-elevated);
  }

  .cf-submit {
    width: 100%;
    justify-content: center;
    margin-top: 0.25rem;
  }

  .cf-note {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-align: center;
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .contact-form-card {
      padding: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch-card,
    .ch-card:hover,
    .ch-arrow,
    .ch-card:hover .ch-arrow {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  import { buildMailto } from '../utils/contactMailto.js';

  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form as HTMLFormElement);
    const locale = document.documentElement.lang === 'en' ? 'en' : 'es';
    window.location.href = buildMailto({
      to: 'aisafetycolombia@gmail.com',
      name: String(fd.get('name') || ''),
      email: String(fd.get('email') || ''),
      message: String(fd.get('message') || ''),
      locale,
    });
  });
</script>
