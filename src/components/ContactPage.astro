---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/ui';
import PageHero from './PageHero.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const EMAIL = 'contacto@aisafetycolombia.org';
const WHATSAPP = 'https://chat.whatsapp.com/KwE8cciX48TAVhAOHnrLaZ';
const INSTAGRAM = 'https://www.instagram.com/aisafetycolombia/';
const LINKEDIN = 'https://www.linkedin.com/company/ai-safety-col/';
---

<PageHero title={t(locale, 'contact.hero.title')} desc={t(locale, 'contact.hero.subtitle')} />

<section class="section contact-section">
  <span class="contact-shape contact-shape-1" aria-hidden="true"></span>
  <span class="contact-shape contact-shape-2" aria-hidden="true"></span>

  <div class="container contact-grid">
    <aside class="contact-aside">
      <span class="section-label contact-kicker">{t(locale, 'contact.channelsKicker')}</span>
      <h2 class="contact-h">{t(locale, 'contact.channelsTitle')}</h2>

      <div class="ch-list">
        <a class="ch-card ch-email" href={`mailto:${EMAIL}`}>
          <span class="ch-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
              <path d="M3.5 6.5 12 13l8.5-6.5" />
            </svg>
          </span>
          <span class="ch-tx">
            <span class="ch-name">Email</span>
            <span class="ch-value">{EMAIL}</span>
          </span>
        </a>

        <a class="ch-card ch-whatsapp" href={WHATSAPP} target="_blank" rel="noopener noreferrer">
          <span class="ch-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5c0 4.1-4 7.5-9 7.5-1.3 0-2.6-.2-3.7-.7L3 20l1.4-3.9C3.5 14.8 3 13.2 3 11.5 3 7.4 7 4 12 4s9 3.4 9 7.5Z" />
              <circle cx="8.5" cy="11.7" r="1.05" fill="currentColor" stroke="none" />
              <circle cx="12" cy="11.7" r="1.05" fill="currentColor" stroke="none" />
              <circle cx="15.5" cy="11.7" r="1.05" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <span class="ch-tx">
            <span class="ch-name">WhatsApp</span>
            <span class="ch-value">{t(locale, 'contact.whatsappValue')}</span>
          </span>
        </a>

        <a class="ch-card ch-instagram" href={INSTAGRAM} target="_blank" rel="noopener noreferrer">
          <span class="ch-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.1" cy="6.9" r="1.2" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <span class="ch-tx">
            <span class="ch-name">Instagram</span>
            <span class="ch-value">@aisafetycolombia</span>
          </span>
        </a>

        <a class="ch-card ch-linkedin" href={LINKEDIN} target="_blank" rel="noopener noreferrer">
          <span class="ch-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.5" y="7.5" width="19" height="12.5" rx="2.5" />
              <path d="M8.5 7.5V6A2.5 2.5 0 0 1 11 3.5h2A2.5 2.5 0 0 1 15.5 6v1.5" />
              <path d="M2.5 12.5h19" />
            </svg>
          </span>
          <span class="ch-tx">
            <span class="ch-name">LinkedIn</span>
            <span class="ch-value">AI Safety Colombia</span>
          </span>
        </a>
      </div>
    </aside>

    <div class="contact-form-card">
      <span class="section-label contact-kicker">{t(locale, 'contact.formKicker')}</span>
      <h2 class="contact-h">{t(locale, 'contact.formTitle')}</h2>

      <form id="contact-form" class="cf">
        <div class="cf-field">
          <label for="name">{t(locale, 'contact.formName')}</label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>
        <div class="cf-field">
          <label for="email">{t(locale, 'contact.formEmail')}</label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>
        <div class="cf-field">
          <label for="message">{t(locale, 'contact.formMessage')}</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <input type="text" name="_honey" class="cf-honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <input type="hidden" name="_subject" value="Nuevo mensaje · aisafetycolombia.org" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />

        <button
          type="submit"
          class="btn btn-primary cf-submit"
          data-idle={t(locale, 'contact.formSubmit')}
          data-sending={t(locale, 'contact.formSending')}
        >{t(locale, 'contact.formSubmit')}</button>

        <p class="cf-error" id="cf-error" role="alert" hidden data-error={t(locale, 'contact.formError')}></p>
        <p class="cf-note">{t(locale, 'contact.formNote')}</p>
      </form>

      <div class="cf-success" id="cf-success" role="status" aria-live="polite" hidden>
        <span class="cf-success-ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </span>
        <h3 class="cf-success-h">{t(locale, 'contact.formSuccessTitle')}</h3>
        <p class="cf-success-tx">{t(locale, 'contact.formSuccessText')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    overflow: hidden;
  }

  /* Decorative shapes — bleed off the section edges, behind content */
  .contact-shape {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }

  .contact-shape-1 {
    width: 210px;
    height: 210px;
    border-radius: 50%;
    background: var(--accent-vermillion);
    opacity: 0.5;
    top: 90px;
    right: -85px;
  }

  .contact-shape-2 {
    width: 210px;
    height: 210px;
    border-radius: 50%;
    border: 28px solid var(--accent-sage);
    opacity: 0.55;
    bottom: 60px;
    left: -95px;
  }

  .contact-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .contact-kicker {
    margin-bottom: 0.875rem;
  }

  .contact-h {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  /* ---- Channels ---- */
  .ch-list {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .ch-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 1rem 1.125rem;
    transition: border-color 0.15s, transform 0.15s;
  }

  .ch-card:hover {
    border-color: var(--text-primary);
    transform: translateY(-2px);
  }

  .ch-icon {
    flex: none;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    color: var(--bg-elevated);
  }

  .ch-icon svg {
    width: 23px;
    height: 23px;
  }

  .ch-email .ch-icon { background: var(--accent-forest); }
  .ch-whatsapp .ch-icon { background: var(--accent-sage); }
  .ch-instagram .ch-icon { background: var(--accent-vermillion); }
  .ch-linkedin .ch-icon {
    background: var(--accent-yellow);
    color: var(--text-primary);
  }

  .ch-tx {
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    min-width: 0;
  }

  .ch-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .ch-value {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---- Message form ---- */
  .contact-form-card {
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 2.25rem;
  }

  .cf {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .cf-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cf-field label {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .cf-field input,
  .cf-field textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    background: var(--bg-primary);
    border: 1.5px solid var(--border);
    border-radius: 14px;
    color: var(--text-primary);
    font-size: 0.9375rem;
    font-family: var(--font-body);
    transition: border-color 0.15s, background 0.15s;
  }

  .cf-field textarea {
    resize: vertical;
    min-height: 120px;
  }

  .cf-field input:focus,
  .cf-field textarea:focus {
    border-color: var(--accent-forest);
    background: var(--bg-elevated);
  }

  .cf-submit {
    width: 100%;
    justify-content: center;
    margin-top: 0.25rem;
  }

  .cf-submit:disabled {
    opacity: 0.65;
    cursor: progress;
  }

  /* Honeypot — hidden from users, bait for bots */
  .cf-honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .cf-note {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-align: center;
    line-height: 1.5;
  }

  .cf-error {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-vermillion-dark);
    text-align: center;
    line-height: 1.5;
  }

  /* ---- Success state ---- */
  .cf-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    text-align: center;
    padding: 1.25rem 0 0.5rem;
  }

  /* Author display:flex above overrides the UA [hidden] rule, so the success
     box would show on load — re-assert hidden with higher specificity. */
  .cf-success[hidden] {
    display: none;
  }

  .cf-success-ic {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent-forest);
    color: var(--bg-elevated);
  }

  .cf-success-ic svg {
    width: 28px;
    height: 28px;
  }

  .cf-success-h {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .cf-success-tx {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .contact-form-card {
      padding: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ch-card,
    .ch-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  // FormSubmit.co AJAX endpoint — delivers each submission straight to the inbox.
  const ENDPOINT = 'https://formsubmit.co/ajax/contacto@aisafetycolombia.org';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = form?.querySelector('.cf-submit') as HTMLButtonElement | null;
  const errorEl = document.getElementById('cf-error');
  const successEl = document.getElementById('cf-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    if (errorEl) errorEl.hidden = true;
    submitBtn.disabled = true;
    submitBtn.textContent = submitBtn.dataset.sending || submitBtn.textContent;

    try {
      const res = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const data = await res.json().catch(() => null);
      const ok =
        res.ok && data && (data.success === 'true' || data.success === true);
      if (!ok) throw new Error('submit failed');

      form.hidden = true;
      if (successEl) {
        successEl.hidden = false;
        successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } catch {
      if (errorEl) {
        errorEl.textContent = errorEl.dataset.error || '';
        errorEl.hidden = false;
      }
      submitBtn.disabled = false;
      submitBtn.textContent = submitBtn.dataset.idle || submitBtn.textContent;
    }
  });
</script>
