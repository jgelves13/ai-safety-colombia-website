---
import type { Locale } from '../i18n/ui';
import { t, localePath } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const steps = [
  { label: t(locale, 'programs.curious'), sub: t(locale, 'journey.curious.sub'), href: localePath(locale, '/recursos/') },
  { label: t(locale, 'programs.learning'), sub: t(locale, 'journey.learning.sub'), href: `${localePath(locale, '/involucrate/')}#grupos` },
  { label: t(locale, 'programs.participating'), sub: t(locale, 'journey.participating.sub'), href: localePath(locale, '/eventos/') },
  { label: t(locale, 'programs.contributing'), sub: t(locale, 'journey.contributing.sub'), href: localePath(locale, '/hackathon/') },
];
---

<section class="section alt journey-band" aria-labelledby="journey-title">
  <div class="container">
    <header class="journey-head">
      <h2 class="section-title" id="journey-title">{t(locale, 'sections.journey')}</h2>
      <p class="section-subtitle">{t(locale, 'journey.subtitle')}</p>
    </header>
    <div class="pipeline">
      {steps.map((s, idx) => (
        <>
          {idx > 0 && <div class="pipeline-arrow" aria-hidden="true"></div>}
          <a class="pipeline-step" href={s.href}>
            <span class="pipeline-dot" aria-hidden="true"></span>
            <span class="pipeline-tx">
              <span class="pipeline-label">{s.label}</span>
              <span class="pipeline-sub">{s.sub}</span>
            </span>
          </a>
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .journey-head {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .journey-head .section-subtitle {
    margin: 0.5rem auto 0;
  }

  .pipeline {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .pipeline-step {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 1.125rem 1.375rem;
    min-width: 200px;
    transition: border-color 0.15s;
  }

  .pipeline-step:hover {
    border-color: var(--text-primary);
    opacity: 1;
  }

  .pipeline-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex: none;
    margin-top: 0.4375rem;
  }

  .pipeline-step:nth-of-type(1) .pipeline-dot { background: var(--accent-sage); }
  .pipeline-step:nth-of-type(2) .pipeline-dot { background: var(--accent-forest); }
  .pipeline-step:nth-of-type(3) .pipeline-dot { background: var(--accent-forest-deep); }
  .pipeline-step:nth-of-type(4) .pipeline-dot { background: var(--accent-vermillion); }

  .pipeline-tx {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
  }

  .pipeline-label {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .pipeline-sub {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .pipeline-arrow {
    align-self: center;
    width: 1.5rem;
    height: 2px;
    background: var(--border);
    position: relative;
    flex: none;
  }

  .pipeline-arrow::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    border: solid var(--border);
    border-width: 0 2px 2px 0;
    padding: 3px;
    transform: rotate(-45deg);
  }

  @media (max-width: 768px) {
    .pipeline-arrow { display: none; }
    .pipeline-step { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pipeline-step { transition: none; }
    .pipeline-step:hover { transform: none; }
  }
</style>
