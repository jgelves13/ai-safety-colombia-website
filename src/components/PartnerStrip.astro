---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const es = locale === 'es';

const logos = import.meta.glob<ImageMetadata>('../assets/resources/*', {
  eager: true,
  import: 'default',
});

const apartLogo = logos['../assets/resources/apart.png'];

const apartDescriptor = es
  ? 'Red internacional de investigación en seguridad de IA. Organizadores del Global South AIS Hackathon.'
  : 'International AI safety research network. Organizers of the Global South AIS Hackathon.';

const supportEyebrow = es ? 'Con el apoyo de' : 'With support from';
---

<section class="partners" aria-label={t(locale, 'partners.title')}>
  <div class="container">
    <p class="partners-title">{t(locale, 'partners.title')}</p>

    <a class="partner-feature" href="https://apartresearch.com/" target="_blank" rel="noopener noreferrer">
      <Image src={apartLogo} alt="Apart Research" width={320} height={120} loading="lazy" class="partner-feature-logo" />
      <p class="partner-feature-name">Apart Research</p>
      <p class="partner-feature-desc">{apartDescriptor}</p>
    </a>

    <div class="partners-support">
      <p class="partners-support-eyebrow">{supportEyebrow}</p>
      <p class="partners-support-name">Schmidt Sciences</p>
    </div>
  </div>
</section>

<style>
  .partners {
    padding: 4rem 1.5rem 4.5rem;
    text-align: center;
    border-top: 1px solid var(--hairline);
    background: var(--bg-secondary, transparent);
  }

  .partners-title {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: var(--text-secondary);
    margin: 0 0 2rem;
  }

  .partner-feature {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 520px;
    margin: 0 auto;
    padding: 2rem 2.25rem 1.75rem;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--bg-primary, #fff);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .partner-feature:hover {
    border-color: var(--accent-forest);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.06);
  }

  .partner-feature-logo {
    display: block;
    height: 64px;
    width: auto;
    max-width: 260px;
    object-fit: contain;
  }

  .partner-feature-name {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .partner-feature-desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .partners-support {
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--hairline);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  .partners-support-eyebrow {
    margin: 0 0 0.375rem;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--text-secondary);
  }

  .partners-support-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  @media (max-width: 600px) {
    .partner-feature {
      padding: 1.5rem 1.25rem 1.25rem;
      gap: 0.625rem;
    }
    .partner-feature-logo { height: 52px; }
    .partner-feature-desc { font-size: 0.875rem; }
  }
</style>
