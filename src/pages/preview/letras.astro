---
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Revista Literaria Latina · preview</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Piazzolla:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --le-bg: #F4EFE6;
      --le-bg-deep: #ECE5D7;
      --le-ink: #1C1A17;
      --le-muted: #57514A;
      --le-green: #1F4D32;
      --le-green-deep: #0D2A1A;
      --le-hair: #CFC6B4;
      --le-paper: #F7F3EB;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Piazzolla', Georgia, serif;
      background: var(--le-bg);
      color: var(--le-ink);
      line-height: 1.65;
      font-size: 17px;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    .le-mono { font-family: 'JetBrains Mono', monospace; }
    .le-wrap { max-width: 1060px; margin: 0 auto; padding-left: 2rem; padding-right: 2rem; }
    .le-measure { max-width: 720px; margin-left: auto; margin-right: auto; }

    /* MASTHEAD NAV */
    .le-nav {
      border-bottom: 1px solid var(--le-ink);
      border-top: 4px double var(--le-ink);
    }
    .le-nav-inner {
      display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
      padding-top: 0.85rem; padding-bottom: 0.85rem; gap: 1rem;
    }
    .le-issue {
      font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem;
      letter-spacing: 0.1em; text-transform: uppercase; color: var(--le-muted);
    }
    .le-brand {
      font-weight: 700; font-size: 1.25rem; letter-spacing: 0.01em;
      text-align: center; white-space: nowrap;
    }
    .le-brand::first-letter { color: var(--le-green); }
    .le-navlinks {
      display: flex; gap: 1.3rem; justify-content: flex-end; align-items: center;
    }
    .le-navlinks a {
      font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--le-muted);
    }
    .le-navlinks a:hover { color: var(--le-green); }
    .le-navlinks .le-lang { color: var(--le-green); border-bottom: 1px solid var(--le-green); }

    /* HERO */
    .le-hero { padding-top: 4.5rem; padding-bottom: 1rem; text-align: center; }
    .le-kicker {
      font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem;
      letter-spacing: 0.34em; text-transform: uppercase; color: var(--le-green);
      margin-bottom: 1.8rem;
    }
    .le-hero h1 {
      font-weight: 700; font-size: clamp(2.6rem, 6.4vw, 5rem);
      line-height: 1.04; letter-spacing: -0.018em;
      max-width: 16ch; margin: 0 auto 1.6rem;
    }
    .le-hero h1 em { font-style: italic; font-weight: 600; color: var(--le-green); }
    .le-lead {
      font-size: 1.2rem; color: var(--le-ink); text-align: left;
      margin-bottom: 2.2rem;
    }
    .le-lead::first-letter {
      float: left; font-size: 4.6rem; line-height: 0.78;
      font-weight: 700; color: var(--le-green);
      margin: 0.42rem 0.7rem 0 0;
    }
    .le-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .le-btn {
      font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;
      letter-spacing: 0.08em; text-transform: uppercase;
      padding: 0.85rem 1.6rem; border: 1.5px solid var(--le-green);
      transition: background .15s, color .15s;
    }
    .le-btn-primary { background: var(--le-green); color: var(--le-paper); }
    .le-btn-primary:hover { background: var(--le-green-deep); border-color: var(--le-green-deep); }
    .le-btn-quiet { background: transparent; color: var(--le-green); }
    .le-btn-quiet:hover { background: var(--le-green); color: var(--le-paper); }

    /* ORNAMENT RULE */
    .le-rule {
      display: flex; align-items: center; gap: 1.1rem;
      margin: 3.4rem auto; max-width: 720px;
    }
    .le-rule::before, .le-rule::after {
      content: ""; flex: 1; height: 1px; background: var(--le-green);
    }
    .le-rule i {
      width: 8px; height: 8px; background: var(--le-green);
      transform: rotate(45deg); flex: none;
    }

    /* SECTION */
    .le-section { padding-top: 1rem; padding-bottom: 4rem; }
    .le-sec-label {
      font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem;
      letter-spacing: 0.22em; text-transform: uppercase; color: var(--le-muted);
      text-align: center; margin-bottom: 0.5rem;
    }
    .le-sec-title {
      font-weight: 700; font-style: italic; font-size: 2rem;
      text-align: center; margin-bottom: 2.6rem;
    }
    .le-entry {
      display: grid; grid-template-columns: 4.5rem 1fr; gap: 1.5rem;
      padding: 1.7rem 0; border-top: 1px solid var(--le-hair);
    }
    .le-entry:last-child { border-bottom: 1px solid var(--le-hair); }
    .le-entry-num {
      font-family: 'JetBrains Mono', monospace; font-size: 0.8125rem;
      color: var(--le-green); padding-top: 0.45rem; letter-spacing: 0.04em;
    }
    .le-entry h3 {
      font-weight: 700; font-size: 1.4rem; letter-spacing: -0.01em;
      margin-bottom: 0.35rem;
    }
    .le-entry p { color: var(--le-muted); font-size: 1.0625rem; max-width: 58ch; }

    /* FEATURED */
    .le-featured-wrap { background: var(--le-green); color: var(--le-paper); }
    .le-featured {
      padding-top: 4.4rem; padding-bottom: 4.4rem; text-align: center;
    }
    .le-featured .le-kicker { color: #BFD6C7; }
    .le-featured h2 {
      font-weight: 700; font-size: clamp(2rem, 4.6vw, 3.2rem);
      line-height: 1.08; letter-spacing: -0.018em; margin: 0 auto 1.2rem;
      max-width: 18ch;
    }
    .le-featured h2 em { font-style: italic; color: #E7DFC9; }
    .le-featured > .le-measure > p {
      color: rgba(247,243,235,.84); font-size: 1.15rem; margin-bottom: 1.6rem;
    }
    .le-featured .le-btn-primary {
      background: var(--le-paper); color: var(--le-green); border-color: var(--le-paper);
    }
    .le-featured .le-btn-primary:hover { background: #fff; }
    .le-featured-meta {
      display: flex; justify-content: center; gap: 0; flex-wrap: wrap;
      margin-top: 2.8rem; border-top: 1px solid rgba(247,243,235,.28);
      padding-top: 2rem;
    }
    .le-stat { padding: 0 2rem; }
    .le-stat + .le-stat { border-left: 1px solid rgba(247,243,235,.28); }
    .le-stat-num {
      font-weight: 700; font-size: 2.4rem; line-height: 1;
      margin-bottom: 0.3rem;
    }
    .le-stat-label {
      font-family: 'JetBrains Mono', monospace; font-size: 0.625rem;
      letter-spacing: 0.12em; text-transform: uppercase; color: #BFD6C7;
    }

    /* FOOTER */
    .le-footer {
      padding-top: 2.6rem; padding-bottom: 2.6rem; text-align: center;
      font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--le-muted);
    }
    .le-footer a { color: var(--le-ink); }
    .le-footer a:hover { color: var(--le-green); }
    .le-footer .le-foot-links { margin-top: 0.6rem; }

    @media (max-width: 760px) {
      .le-nav-inner { grid-template-columns: 1fr; text-align: center; gap: 0.4rem; }
      .le-issue { text-align: center; }
      .le-navlinks { justify-content: center; flex-wrap: wrap; gap: 0.9rem; }
      .le-hero { padding-top: 3rem; }
      .le-entry { grid-template-columns: 1fr; gap: 0.3rem; }
      .le-entry-num { padding-top: 0; }
      .le-stat + .le-stat { border-left: 0; }
    }
  </style>
</head>
<body>
  <nav class="le-nav">
    <div class="le-wrap le-nav-inner">
      <div class="le-issue">Número 01 · MMXXVI</div>
      <div class="le-brand">AI Safety Colombia</div>
      <div class="le-navlinks">
        <a href="#">Sobre</a>
        <a href="#">Programas</a>
        <a href="#">Hackathon</a>
        <a href="#">Recursos</a>
        <a href="#" class="le-lang">ES · EN</a>
      </div>
    </div>
  </nav>

  <section class="le-wrap le-hero">
    <div class="le-kicker">Investigación · Comunidad · Política</div>
    <h1>Seguridad de IA <em>desde</em> Colombia.</h1>
    <p class="le-lead le-measure">Investigación, comunidad y política pública para que la IA avance de forma segura en América Latina. Una comunidad de investigadores, ingenieros y profesionales de política que trabajan juntos sobre los problemas abiertos del campo.</p>
    <div class="le-actions">
      <a class="le-btn le-btn-primary" href="#">Únete a la comunidad</a>
      <a class="le-btn le-btn-quiet" href="#">Ver recursos</a>
    </div>
  </section>

  <div class="le-rule"><i></i></div>

  <section class="le-wrap le-section">
    <div class="le-sec-label">Índice</div>
    <div class="le-sec-title">Qué hacemos</div>
    <div class="le-entry">
      <div class="le-entry-num">§ 01</div>
      <div>
        <h3>Investigación</h3>
        <p>Evaluaciones, alineación y gobernanza con la comunidad técnica latinoamericana. Trabajamos en problemas abiertos del campo.</p>
      </div>
    </div>
    <div class="le-entry">
      <div class="le-entry-num">§ 02</div>
      <div>
        <h3>Comunidad</h3>
        <p>Investigadores, ingenieros y profesionales de política en Bogotá y en línea. Grupos de discusión y hackathons a lo largo del año.</p>
      </div>
    </div>
    <div class="le-entry">
      <div class="le-entry-num">§ 03</div>
      <div>
        <h3>Formación</h3>
        <p>Cursos curados de BlueDot Impact y rutas de aprendizaje pensadas para distintos puntos de partida.</p>
      </div>
    </div>
    <div class="le-entry">
      <div class="le-entry-num">§ 04</div>
      <div>
        <h3>Gobernanza</h3>
        <p>Política pública sobre IA en Colombia y América Latina. Documentos, conversaciones y aportes regulatorios.</p>
      </div>
    </div>
  </section>

  <div class="le-featured-wrap">
    <div class="le-wrap le-featured">
      <div class="le-kicker">Hackathon · 19–21 Jun 2026</div>
      <h2>Global South AI Safety <em>Hackathon</em></h2>
      <div class="le-measure">
        <p>Un fin de semana donde investigadores, ingenieros y profesionales de política de América Latina, África y Asia construyen seguridad de IA para sus regiones. Organiza Apart Research; AI Safety Colombia coordina el hub de Bogotá.</p>
      </div>
      <a class="le-btn le-btn-primary" href="#">Inscríbete</a>
      <div class="le-featured-meta">
        <div class="le-stat">
          <div class="le-stat-num">USD 1.000</div>
          <div class="le-stat-label">Premio por equipo regional</div>
        </div>
        <div class="le-stat">
          <div class="le-stat-num">3 días</div>
          <div class="le-stat-label">Cuatro pistas de trabajo</div>
        </div>
        <div class="le-stat">
          <div class="le-stat-num">3 hubs</div>
          <div class="le-stat-label">Bogotá · Buenos Aires · México</div>
        </div>
      </div>
    </div>
  </div>

  <footer class="le-footer">
    <div>© 2026 AI Safety Colombia · Bogotá</div>
    <div class="le-foot-links">
      <a href="#">WhatsApp</a> · <a href="#">Instagram</a> · <a href="#">LinkedIn</a> · <a href="#">Contacto</a>
    </div>
  </footer>
</body>
</html>
