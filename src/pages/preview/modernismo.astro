---
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Modernismo Arquitectónico · preview</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --mo-bg: #EAE6DE;
      --mo-panel: #DDD7C9;
      --mo-panel-2: #D2CABA;
      --mo-brick: #A6492E;
      --mo-brick-deep: #863A24;
      --mo-green: #1F4D32;
      --mo-green-deep: #0D2A1A;
      --mo-sage: #4A8466;
      --mo-ink: #1A1714;
      --mo-muted: #5C564E;
      --mo-line: #1A1714;
      --mo-hair: #C2BAAA;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--mo-bg);
      color: var(--mo-ink);
      line-height: 1.6;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
    }
    .mo-disp { font-family: 'Archivo', system-ui, sans-serif; }
    a { color: inherit; text-decoration: none; }
    .mo-wrap { max-width: 1180px; margin: 0 auto; padding-left: 2rem; padding-right: 2rem; }

    /* brick coursing band — signature divider */
    .mo-band {
      height: 30px;
      background-color: var(--mo-brick);
      background-image:
        repeating-linear-gradient(0deg, rgba(0,0,0,.22) 0 1.5px, transparent 1.5px 15px),
        repeating-linear-gradient(90deg, rgba(0,0,0,.22) 0 1.5px, transparent 1.5px 46px),
        repeating-linear-gradient(90deg, rgba(255,255,255,.05) 0 1.5px, transparent 1.5px 46px);
      background-position: 0 0, 0 0, 23px 15px;
    }

    /* NAVBAR */
    .mo-nav {
      border-bottom: 2.5px solid var(--mo-line);
      background: var(--mo-bg);
    }
    .mo-nav-inner {
      display: flex; justify-content: space-between; align-items: center;
      padding-top: 1.15rem; padding-bottom: 1.15rem;
    }
    .mo-brand {
      font-family: 'Archivo', sans-serif; font-weight: 800;
      font-size: 1.0625rem; letter-spacing: -0.015em;
      display: flex; align-items: center; gap: 0.6rem;
    }
    .mo-brand::before {
      content: ""; width: 14px; height: 14px;
      background: var(--mo-brick);
      box-shadow: 4px 4px 0 var(--mo-green);
    }
    .mo-nav ul { list-style: none; display: flex; gap: 1.9rem; align-items: center; }
    .mo-nav a {
      font-size: 0.75rem; text-transform: uppercase;
      letter-spacing: 0.11em; font-weight: 600;
    }
    .mo-nav a:hover { color: var(--mo-brick); }
    .mo-lang {
      border: 1.5px solid var(--mo-line); padding: 0.35rem 0.6rem;
      letter-spacing: 0.14em;
    }

    /* HERO */
    .mo-hero { padding-top: 5rem; padding-bottom: 5.5rem; position: relative; }
    .mo-kicker {
      font-family: 'Archivo', sans-serif; font-weight: 700;
      font-size: 0.6875rem; letter-spacing: 0.32em; text-transform: uppercase;
      color: var(--mo-brick); display: flex; align-items: center; gap: 0.8rem;
      margin-bottom: 2.5rem;
    }
    .mo-kicker::before {
      content: ""; width: 44px; height: 3px; background: var(--mo-brick);
    }
    .mo-hero h1 {
      font-family: 'Archivo', sans-serif; font-weight: 900;
      font-size: clamp(2.9rem, 8.2vw, 6.6rem);
      line-height: 0.95; letter-spacing: -0.035em;
      max-width: 15ch; margin-bottom: 1.9rem;
      text-transform: uppercase;
    }
    .mo-hero h1 em { font-style: normal; color: var(--mo-brick); }
    .mo-lead {
      font-size: 1.15rem; color: var(--mo-muted); max-width: 56ch;
      margin-bottom: 2.6rem;
    }
    .mo-actions { display: flex; gap: 0.9rem; flex-wrap: wrap; }
    .mo-btn {
      font-family: 'Archivo', sans-serif; font-weight: 700;
      display: inline-flex; align-items: center;
      padding: 0.95rem 1.8rem; font-size: 0.8125rem;
      letter-spacing: 0.05em; text-transform: uppercase;
      border: 2.5px solid var(--mo-line);
      transition: background .15s, color .15s, transform .1s;
    }
    .mo-btn-primary { background: var(--mo-green); color: #fff; border-color: var(--mo-green); }
    .mo-btn-primary:hover { background: var(--mo-green-deep); border-color: var(--mo-green-deep); }
    .mo-btn-quiet { background: transparent; color: var(--mo-ink); }
    .mo-btn-quiet:hover { background: var(--mo-ink); color: var(--mo-bg); }

    /* blueprint coordinate label, top-right of hero */
    .mo-coord {
      position: absolute; top: 2.4rem; right: 2rem;
      font-family: 'Archivo', sans-serif; font-size: 0.625rem;
      letter-spacing: 0.18em; color: var(--mo-muted);
      text-transform: uppercase; text-align: right; line-height: 1.8;
    }

    /* SECTION */
    .mo-section { padding-top: 4.5rem; padding-bottom: 5rem; }
    .mo-sec-head {
      display: flex; justify-content: space-between; align-items: baseline;
      border-bottom: 2.5px solid var(--mo-line); padding-bottom: 1rem;
      margin-bottom: 2.4rem; flex-wrap: wrap; gap: 0.5rem;
    }
    .mo-sec-title {
      font-family: 'Archivo', sans-serif; font-weight: 800;
      font-size: 1.75rem; letter-spacing: -0.02em; text-transform: uppercase;
    }
    .mo-sec-meta {
      font-family: 'Archivo', sans-serif; font-size: 0.6875rem;
      letter-spacing: 0.2em; text-transform: uppercase; color: var(--mo-brick);
      font-weight: 700;
    }
    .mo-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;
    }
    .mo-panel {
      background: var(--mo-panel); border: 2px solid var(--mo-line);
      padding: 2.1rem 2rem 2.2rem; position: relative;
    }
    .mo-panel:nth-child(2), .mo-panel:nth-child(3) { background: var(--mo-panel-2); }
    .mo-plate {
      font-family: 'Archivo', sans-serif; font-weight: 700;
      font-size: 0.6875rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--mo-bg); background: var(--mo-green);
      display: inline-block; padding: 0.3rem 0.65rem; margin-bottom: 1.4rem;
    }
    .mo-panel h3 {
      font-family: 'Archivo', sans-serif; font-weight: 800;
      font-size: 1.5rem; letter-spacing: -0.02em; margin-bottom: 0.7rem;
    }
    .mo-panel p { color: var(--mo-muted); font-size: 0.9375rem; max-width: 40ch; }
    /* blueprint corner tick */
    .mo-panel::after {
      content: ""; position: absolute; bottom: 9px; right: 9px;
      width: 13px; height: 13px;
      border-bottom: 2.5px solid var(--mo-brick);
      border-right: 2.5px solid var(--mo-brick);
    }

    /* FEATURED */
    .mo-featured-wrap { background: var(--mo-green); color: var(--mo-bg); padding: 5rem 0; }
    .mo-featured {
      display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 3.5rem;
      align-items: stretch;
    }
    .mo-featured .mo-kicker { color: #E9B7A6; }
    .mo-featured .mo-kicker::before { background: var(--mo-brick); }
    .mo-featured h2 {
      font-family: 'Archivo', sans-serif; font-weight: 900;
      font-size: clamp(2rem, 4.6vw, 3.4rem); line-height: 0.98;
      letter-spacing: -0.03em; text-transform: uppercase; margin-bottom: 1.3rem;
    }
    .mo-featured > div:first-child > p {
      color: rgba(255,255,255,.82); max-width: 46ch; font-size: 1.0625rem;
      margin-bottom: 2rem;
    }
    .mo-featured .mo-btn-primary {
      background: var(--mo-brick); border-color: var(--mo-brick); color: #fff;
    }
    .mo-featured .mo-btn-primary:hover { background: var(--mo-brick-deep); border-color: var(--mo-brick-deep); }
    .mo-statcard {
      background: var(--mo-panel); color: var(--mo-ink);
      border: 2.5px solid var(--mo-brick); padding: 2.3rem 2rem;
      position: relative;
    }
    .mo-statcard::before, .mo-statcard::after {
      content: ""; position: absolute; width: 16px; height: 16px;
    }
    .mo-statcard::before {
      top: -2.5px; left: -2.5px;
      border-top: 5px solid var(--mo-bg); border-left: 5px solid var(--mo-bg);
    }
    .mo-statcard::after {
      bottom: -2.5px; right: -2.5px;
      border-bottom: 5px solid var(--mo-bg); border-right: 5px solid var(--mo-bg);
    }
    .mo-statnum {
      font-family: 'Archivo', sans-serif; font-weight: 900;
      font-size: 3.6rem; line-height: 0.92; letter-spacing: -0.04em;
      color: var(--mo-green); margin-bottom: 0.4rem;
    }
    .mo-statlabel {
      font-family: 'Archivo', sans-serif; font-weight: 700;
      font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--mo-brick);
    }
    .mo-statcard hr { border: 0; border-top: 2px solid var(--mo-hair); margin: 1.6rem 0; }
    .mo-statcard p { font-size: 0.9375rem; color: var(--mo-muted); }
    .mo-statcard strong { color: var(--mo-ink); font-family: 'Archivo', sans-serif; font-weight: 700; }

    /* FOOTER */
    .mo-footer {
      border-top: 2.5px solid var(--mo-line);
      padding-top: 2.4rem; padding-bottom: 2.4rem;
      display: flex; justify-content: space-between; align-items: baseline;
      flex-wrap: wrap; gap: 1rem;
      font-family: 'Archivo', sans-serif; font-size: 0.75rem;
      letter-spacing: 0.06em; text-transform: uppercase; color: var(--mo-muted);
    }
    .mo-footer a { color: var(--mo-ink); font-weight: 600; }
    .mo-footer a:hover { color: var(--mo-brick); }

    @media (max-width: 760px) {
      .mo-grid, .mo-featured { grid-template-columns: 1fr; }
      .mo-coord { display: none; }
      .mo-hero { padding-top: 3rem; padding-bottom: 3.5rem; }
      .mo-nav ul { gap: 1rem; }
      .mo-nav li:nth-child(-n+3) { display: none; }
    }
  </style>
</head>
<body>
  <nav class="mo-nav">
    <div class="mo-wrap mo-nav-inner">
      <div class="mo-brand mo-disp">AI Safety Colombia</div>
      <ul>
        <li><a href="#">Sobre</a></li>
        <li><a href="#">Programas</a></li>
        <li><a href="#">Hackathon</a></li>
        <li><a href="#">Eventos</a></li>
        <li><a href="#">Recursos</a></li>
        <li><a href="#" class="mo-lang">ES · EN</a></li>
      </ul>
    </div>
  </nav>

  <section class="mo-wrap mo-hero">
    <div class="mo-coord">Lat 4.7110° N<br/>Lon 74.0721° W<br/>Bogotá — DC</div>
    <div class="mo-kicker">Investigación · Comunidad · Política</div>
    <h1 class="mo-disp">Seguridad de IA desde <em>Colombia</em>.</h1>
    <p class="mo-lead">Investigación, comunidad y política pública para que la IA avance de forma segura en América Latina. Una comunidad de investigadores, ingenieros y profesionales de política trabajando juntos.</p>
    <div class="mo-actions">
      <a class="mo-btn mo-btn-primary" href="#">Únete a la comunidad</a>
      <a class="mo-btn mo-btn-quiet" href="#">Ver recursos</a>
    </div>
  </section>

  <div class="mo-band"></div>

  <section class="mo-wrap mo-section">
    <div class="mo-sec-head">
      <div class="mo-sec-title mo-disp">Qué hacemos</div>
      <div class="mo-sec-meta">Cuatro frentes de trabajo</div>
    </div>
    <div class="mo-grid">
      <div class="mo-panel">
        <span class="mo-plate">Lámina 01</span>
        <h3 class="mo-disp">Investigación</h3>
        <p>Evaluaciones, alineación y gobernanza con la comunidad técnica latinoamericana. Trabajamos en problemas abiertos.</p>
      </div>
      <div class="mo-panel">
        <span class="mo-plate">Lámina 02</span>
        <h3 class="mo-disp">Comunidad</h3>
        <p>Investigadores, ingenieros y profesionales de política en Bogotá y en línea. Grupos de discusión y hackathons.</p>
      </div>
      <div class="mo-panel">
        <span class="mo-plate">Lámina 03</span>
        <h3 class="mo-disp">Formación</h3>
        <p>Cursos curados de BlueDot Impact y rutas de aprendizaje para distintos puntos de partida.</p>
      </div>
      <div class="mo-panel">
        <span class="mo-plate">Lámina 04</span>
        <h3 class="mo-disp">Gobernanza</h3>
        <p>Política pública sobre IA en Colombia y América Latina. Documentos, conversaciones y aportes regulatorios.</p>
      </div>
    </div>
  </section>

  <div class="mo-band"></div>

  <div class="mo-featured-wrap">
    <div class="mo-wrap mo-featured">
      <div>
        <div class="mo-kicker">Hackathon · 19–21 Jun 2026</div>
        <h2 class="mo-disp">Global South AI Safety Hackathon</h2>
        <p>Un fin de semana donde investigadores, ingenieros y profesionales de política de América Latina, África y Asia construyen seguridad de IA para sus regiones. Organiza Apart Research; AI Safety Colombia coordina el hub de Bogotá.</p>
        <a class="mo-btn mo-btn-primary" href="#">Inscríbete</a>
      </div>
      <div class="mo-statcard">
        <div class="mo-statnum mo-disp">USD 1.000</div>
        <div class="mo-statlabel">Premio por equipo regional</div>
        <hr/>
        <p><strong>Tres días</strong> · <strong>cuatro pistas</strong>: evals, gobernanza, interpretabilidad y LAWS. Hubs simultáneos en Bogotá, Buenos Aires y México DF.</p>
      </div>
    </div>
  </div>

  <div class="mo-band"></div>

  <footer class="mo-wrap mo-footer">
    <div>© 2026 AI Safety Colombia · Bogotá</div>
    <div>
      <a href="#">WhatsApp</a> · <a href="#">Instagram</a> · <a href="#">LinkedIn</a> · <a href="#">Contacto</a>
    </div>
  </footer>
</body>
</html>
