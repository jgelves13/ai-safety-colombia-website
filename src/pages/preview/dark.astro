---
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Dark Terminal Research · preview</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --dk-bg: #0B1626;
      --dk-bg-alt: #0E1B30;
      --dk-text: #E8E6E1;
      --dk-muted: #8A93A6;
      --dk-line: #1E2A40;
      --dk-lime: #C8FF3A;
      --dk-amber: #FFB347;
      --dk-coral: #FF6B5B;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--dk-bg);
      color: var(--dk-text);
      line-height: 1.6;
      font-size: 16px;
    }
    .dk-mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
    a { color: inherit; text-decoration: none; }

    /* NAVBAR — thin top bar, dark, no pill */
    .dk-nav {
      border-bottom: 1px solid var(--dk-line);
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.875rem;
    }
    .dk-nav-brand {
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--dk-lime);
    }
    .dk-nav-brand::before {
      content: "▌ ";
      color: var(--dk-lime);
    }
    .dk-nav ul { list-style: none; display: flex; gap: 1.75rem; align-items: center; }
    .dk-nav a { color: var(--dk-muted); transition: color .15s; }
    .dk-nav a:hover { color: var(--dk-lime); }
    .dk-nav .dk-lang { color: var(--dk-text); }

    /* HERO */
    .dk-hero {
      max-width: 1100px;
      margin: 0 auto;
      padding: 6rem 2rem 5rem;
    }
    .dk-kicker {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      color: var(--dk-lime);
      margin-bottom: 2.5rem;
      text-transform: uppercase;
    }
    .dk-kicker::before {
      content: "> ";
      color: var(--dk-lime);
    }
    .dk-hero h1 {
      font-weight: 700;
      font-size: clamp(2.5rem, 6.5vw, 5rem);
      line-height: 1.02;
      letter-spacing: -0.025em;
      margin-bottom: 1.5rem;
      max-width: 16ch;
    }
    .dk-hero h1 .dk-accent { color: var(--dk-lime); }
    .dk-hero p {
      font-size: 1.125rem;
      color: var(--dk-muted);
      max-width: 56ch;
      line-height: 1.55;
      margin-bottom: 2.5rem;
    }
    .dk-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
    .dk-btn {
      font-family: 'JetBrains Mono', monospace;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.875rem 1.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      border-radius: 2px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      transition: background .15s, color .15s, transform .15s;
      border: 1px solid transparent;
    }
    .dk-btn-primary { background: var(--dk-lime); color: #0B1626; }
    .dk-btn-primary:hover { transform: translateY(-1px); }
    .dk-btn-quiet {
      background: transparent;
      color: var(--dk-text);
      border-color: var(--dk-line);
    }
    .dk-btn-quiet:hover { border-color: var(--dk-lime); color: var(--dk-lime); }

    /* SECTION */
    .dk-section {
      padding: 5rem 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }
    .dk-section-head {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8125rem;
      letter-spacing: 0.1em;
      color: var(--dk-lime);
      text-transform: uppercase;
      margin-bottom: 3rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .dk-section-head::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--dk-line);
    }
    .dk-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
      border-top: 1px solid var(--dk-line);
      border-left: 1px solid var(--dk-line);
    }
    .dk-cell {
      border-right: 1px solid var(--dk-line);
      border-bottom: 1px solid var(--dk-line);
      padding: 2rem;
    }
    .dk-cell-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      color: var(--dk-muted);
      margin-bottom: 0.75rem;
      text-transform: uppercase;
    }
    .dk-cell h3 {
      font-size: 1.375rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      margin-bottom: 0.75rem;
    }
    .dk-cell p { color: var(--dk-muted); font-size: 0.9375rem; max-width: 45ch; }

    /* FEATURED — amber/lime panel on darker bg */
    .dk-featured-wrap {
      background: var(--dk-bg-alt);
      padding: 5rem 2rem;
      border-top: 1px solid var(--dk-line);
      border-bottom: 1px solid var(--dk-line);
    }
    .dk-featured {
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
    .dk-featured .dk-kicker { color: var(--dk-amber); margin-bottom: 1.5rem; }
    .dk-featured .dk-kicker::before { color: var(--dk-amber); }
    .dk-featured h2 {
      font-size: clamp(1.875rem, 4.5vw, 3rem);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.02em;
      margin-bottom: 1.25rem;
    }
    .dk-featured p {
      color: var(--dk-muted);
      max-width: 50ch;
      font-size: 1.0625rem;
      margin-bottom: 1.75rem;
    }
    .dk-stat-block {
      border: 1px solid var(--dk-line);
      padding: 2rem;
      background: var(--dk-bg);
    }
    .dk-stat {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 1.25rem;
      padding: 1rem 0;
      border-bottom: 1px solid var(--dk-line);
      align-items: baseline;
    }
    .dk-stat:last-child { border-bottom: 0; }
    .dk-stat-val {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--dk-lime);
      min-width: 5ch;
    }
    .dk-stat-lbl {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8125rem;
      color: var(--dk-muted);
      letter-spacing: 0.05em;
    }

    /* FOOTER */
    .dk-footer {
      padding: 3rem 2rem 2rem;
      border-top: 1px solid var(--dk-line);
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.8125rem;
      color: var(--dk-muted);
      flex-wrap: wrap;
      gap: 1rem;
    }
    .dk-footer a { color: var(--dk-text); }
    .dk-footer a:hover { color: var(--dk-lime); }

    @media (max-width: 760px) {
      .dk-grid { grid-template-columns: 1fr; }
      .dk-featured { grid-template-columns: 1fr; gap: 2rem; }
      .dk-hero { padding-top: 3rem; padding-bottom: 3rem; }
    }
  </style>
</head>
<body>
  <nav class="dk-nav">
    <div class="dk-nav-brand">AISC</div>
    <ul>
      <li><a href="#">research</a></li>
      <li><a href="#">community</a></li>
      <li><a href="#">programs</a></li>
      <li><a href="#">hackathon</a></li>
      <li><a href="#" class="dk-lang">ES · EN</a></li>
    </ul>
  </nav>

  <section class="dk-hero">
    <div class="dk-kicker">research · community · governance</div>
    <h1>AI safety, built from <span class="dk-accent">Colombia</span>.</h1>
    <p>Investigación, comunidad y política pública para que la IA avance de forma segura en América Latina. Una comunidad de investigadores, ingenieros y profesionales de política trabajando juntos.</p>
    <div class="dk-actions">
      <a class="dk-btn dk-btn-primary" href="#">Join ▸</a>
      <a class="dk-btn dk-btn-quiet" href="#">Read more →</a>
    </div>
  </section>

  <section class="dk-section">
    <div class="dk-section-head">[ what we do ]</div>
    <div class="dk-grid">
      <div class="dk-cell">
        <div class="dk-cell-label">01 / research</div>
        <h3>Investigación</h3>
        <p>Evaluaciones, alineación y gobernanza con la comunidad técnica latinoamericana. Trabajamos en problemas abiertos.</p>
      </div>
      <div class="dk-cell">
        <div class="dk-cell-label">02 / community</div>
        <h3>Comunidad</h3>
        <p>Reunimos investigadores, ingenieros y profesionales de política en Bogotá y en línea. Grupos de discusión y hackathons.</p>
      </div>
      <div class="dk-cell">
        <div class="dk-cell-label">03 / education</div>
        <h3>Formación</h3>
        <p>Cursos curados de BlueDot Impact y rutas de aprendizaje para distintos puntos de partida.</p>
      </div>
      <div class="dk-cell">
        <div class="dk-cell-label">04 / governance</div>
        <h3>Gobernanza</h3>
        <p>Política pública sobre IA en Colombia y América Latina. Documentos y aportes a marcos regulatorios.</p>
      </div>
    </div>
  </section>

  <div class="dk-featured-wrap">
    <div class="dk-featured">
      <div>
        <div class="dk-kicker">hackathon · jun 19–21</div>
        <h2>Global South AI Safety Hackathon 2026</h2>
        <p>Un fin de semana donde investigadores, ingenieros y profesionales de política de América Latina, África y Asia construyen seguridad de IA para sus regiones.</p>
        <a class="dk-btn dk-btn-primary" href="#">Register →</a>
      </div>
      <div class="dk-stat-block">
        <div class="dk-stat">
          <div class="dk-stat-val">3</div>
          <div class="dk-stat-lbl">days · jun 19–21</div>
        </div>
        <div class="dk-stat">
          <div class="dk-stat-val">$1K</div>
          <div class="dk-stat-lbl">prize per regional winner</div>
        </div>
        <div class="dk-stat">
          <div class="dk-stat-val">4</div>
          <div class="dk-stat-lbl">tracks · evals · governance · interp · LAWS</div>
        </div>
      </div>
    </div>
  </div>

  <footer class="dk-footer">
    <div>© 2026 AISC</div>
    <div>
      <a href="#">whatsapp</a> · <a href="#">instagram</a> · <a href="#">linkedin</a> · <a href="#">contact</a>
    </div>
  </footer>
</body>
</html>
