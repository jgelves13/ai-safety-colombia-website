---
import BaseLayout from "../layouts/BaseLayout.astro";
import HackathonBanner from "../components/HackathonBanner.astro";
import Hero from "../components/Hero.astro";
import AboutAISafety from "../components/AboutAISafety.astro";
import WhatWeDo from "../components/WhatWeDo.astro";
import HomeEvents from "../components/HomeEvents.astro";
import StartHere from "../components/StartHere.astro";
import HomeWaysToHelp from "../components/HomeWaysToHelp.astro";
import { t } from "../i18n/ui";

const locale = "es";
---

<BaseLayout
  locale={locale}
  currentPage="index"
  title="AI Safety Colombia · Comunidad de seguridad y alineación de IA en LATAM"
  description="Capítulo colombiano de AI safety y alineación de IA. Grupos de lectura BlueDot, charlas, hackathons con Apart Research y recursos en español para LATAM y el Global South."
>
  <div class="hero-wrapper">
    <span class="hero-yellow-shape" aria-hidden="true"></span>
    <HackathonBanner locale={locale} />
    <Hero locale={locale} />
  </div>

  <AboutAISafety locale={locale} />

  <WhatWeDo locale={locale} />

  <HomeEvents locale={locale} />

  <StartHere locale={locale} />

  <HomeWaysToHelp locale={locale} />

  <section
    class="section join-section featured-block"
    aria-labelledby="join-title"
  >
    <div class="container">
      <div class="join-card">
        <div class="join-text">
          <h2 class="section-title" id="join-title">
            {t(locale, "sections.join")}
          </h2>
          <p class="join-sub">{t(locale, "join.subtitle")}</p>
        </div>
        <div class="join-links">
          <a
            href="https://chat.whatsapp.com/KwE8cciX48TAVhAOHnrLaZ"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            {t(locale, "join.whatsapp")}
          </a>
          <a
            href="https://www.linkedin.com/company/ai-safety-col/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            LinkedIn
          </a>
          <a
            href="https://www.instagram.com/aisafetycolombia/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            Instagram
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-wrapper {
    position: relative;
    overflow-x: hidden;
  }

  .hero-yellow-shape {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    width: 240px;
    height: 240px;
    background: var(--accent-yellow);
    top: 288px;
    right: -140px;
    display: block;
  }

  @media (min-width: 480px) {
    .hero-yellow-shape { right: -70px; }
  }

  @media (min-width: 768px) {
    .hero-yellow-shape {
      width: 380px;
      height: 380px;
      top: 224px;
      right: -100px;
    }
  }

  .join-card {
    background: var(--card-surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 2.25rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .join-card .section-title {
    margin-bottom: 0.375rem;
    color: var(--text-primary);
  }

  .join-card .join-sub {
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .join-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
