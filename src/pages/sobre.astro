---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { t } from '../i18n/ui';

const locale = 'es';
---

<BaseLayout locale={locale} currentPage="about" title="Sobre nosotros | AI Safety Colombia">
  <PageHero
    title="Sobre nosotros"
    desc="Somos un grupo de investigadores, ingenieros y profesionales comprometidos con construir un futuro seguro con inteligencia artificial en Colombia y América Latina."
  />

  <section class="section">
    <div class="container">
      <h2 class="section-title">Misión</h2>
      <p class="text-block">Reducir los riesgos existenciales y catastróficos de la inteligencia artificial, formando talento local, produciendo investigación relevante y conectando a Colombia con la comunidad global de AI Safety.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Teoría de cambio</h2>
      <div class="editorial">
        <div class="editorial-row is-green">
          <div class="editorial-bar"></div>
          <div class="editorial-tx">
            <h3>Talento</h3>
            <p>Formamos investigadores y profesionales que puedan contribuir directamente a la seguridad de IA.</p>
          </div>
        </div>
        <div class="editorial-row is-coral">
          <div class="editorial-bar"></div>
          <div class="editorial-tx">
            <h3>Investigación</h3>
            <p>Producimos trabajo técnico y de gobernanza adaptado al contexto latinoamericano.</p>
          </div>
        </div>
        <div class="editorial-row is-blue">
          <div class="editorial-bar"></div>
          <div class="editorial-tx">
            <h3>Comunidad</h3>
            <p>Construimos una red de personas informadas que puedan influir en decisiones clave sobre IA.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="team-title">
    <div class="container">
      <h2 class="section-title" id="team-title">Equipo</h2>
      <div class="people">
        <article class="person-card is-memoriam">
          <div class="person-head">
            <img class="person-photo" src="/people/fernando.jpg" alt={t(locale, 'about.memoriam.name')} width="120" height="150" loading="lazy" />
            <div class="person-id">
              <p class="memoriam-kicker">{t(locale, 'about.memoriam.kicker')}</p>
              <h3 class="person-name">{t(locale, 'about.memoriam.name')}</h3>
              <p class="person-role">{t(locale, 'about.memoriam.role')}</p>
              <p class="person-affil">{t(locale, 'about.memoriam.affiliation')}</p>
            </div>
          </div>
          <p class="person-bio">{t(locale, 'about.memoriam.bio')}</p>
          <p class="memoriam-tribute">{t(locale, 'about.memoriam.tribute')}</p>
        </article>
        <article class="person-card">
          <div class="person-head">
            <img class="person-photo" src="/people/jose.jpg" alt={t(locale, 'about.team.name')} width="120" height="150" loading="lazy" />
            <div class="person-id">
              <h3 class="person-name">{t(locale, 'about.team.name')}</h3>
              <p class="person-role">{t(locale, 'about.team.role')}</p>
              <p class="person-affil">{t(locale, 'about.team.affiliation')}</p>
            </div>
          </div>
          <p class="person-bio">{t(locale, 'about.team.bio')}</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .text-block {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 700px;
    line-height: 1.7;
  }

  /* Fernando and Jose are peers, side by side: a two-column grid,
     top-aligned (no forced-stretch void), each card a clean
     profile header (photo + identity) → bio → remembrance. */
  .people {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
    max-width: 920px;
  }

  .person-card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 1.75rem 2rem;
  }

  /* Only the memorial is visually elevated: soft gradient + the
     "En memoria" eyebrow. Jose's card shares the shape but stays plain. */
  .person-card.is-memoriam {
    background: linear-gradient(140deg, #F1F8F2, #FFF8E7);
  }

  .person-head {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .person-photo {
    width: 96px;
    height: 120px;
    flex: none;
    object-fit: cover;
    border-radius: 14px;
    background: #ECECEC;
    display: block;
  }

  .person-id {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .memoriam-kicker {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green-text);
    margin-bottom: 0.15rem;
  }

  .person-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .person-role {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .person-affil {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .person-bio {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* The tribute is a remembrance set apart from the factual bio:
     a soft green hairline divides it from the rest of the card. */
  .memoriam-tribute {
    font-size: 0.9375rem;
    color: var(--text-primary);
    line-height: 1.65;
    padding-top: 1rem;
    border-top: 1px solid rgba(43, 213, 118, 0.4);
  }

  @media (max-width: 768px) {
    .people {
      grid-template-columns: 1fr;
      max-width: 680px;
    }
    .person-card {
      padding: 1.5rem;
    }
  }
</style>
