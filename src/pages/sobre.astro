---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AboutContent from '../components/AboutContent.astro';

const locale = 'es';
---

<BaseLayout locale={locale} currentPage="about" title="Sobre nosotros | AI Safety Colombia">
  <PageHero
    title="Sobre nosotros"
    desc="La comunidad detrás de la seguridad de IA en Colombia: quiénes somos, cómo empezamos y cómo creemos que ocurre el cambio."
  />
  <AboutContent locale={locale} />
</BaseLayout>
