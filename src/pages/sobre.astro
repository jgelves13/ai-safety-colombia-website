---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AboutContent from '../components/AboutContent.astro';

const locale = 'es';
---

<BaseLayout locale={locale} currentPage="about" title="Sobre nosotros | AI Safety Colombia">
  <PageHero
    title="Sobre nosotros"
    desc="Una comunidad de investigadores, ingenieros y profesionales que trabaja, desde Colombia, en la seguridad de la inteligencia artificial."
  />
  <AboutContent locale={locale} />
</BaseLayout>
