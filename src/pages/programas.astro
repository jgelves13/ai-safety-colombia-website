---
import BaseLayout from '../layouts/BaseLayout.astro';

const locale = 'es';

const programs = [
  {
    stage: 'Curioso',
    desc: 'Descubre que es la seguridad de IA y por que importa.',
    items: ['Charlas introductorias', 'Lecturas recomendadas', 'Eventos de comunidad'],
  },
  {
    stage: 'Aprendiendo',
    desc: 'Profundiza en los fundamentos tecnicos y conceptuales.',
    items: ['Curso introductorio (8 semanas)', 'Grupos de estudio', 'Mentoria uno a uno'],
  },
  {
    stage: 'Participando',
    desc: 'Aplica tus conocimientos en proyectos reales.',
    items: ['Hackathons', 'Proyectos de investigacion', 'Colaboraciones internacionales'],
  },
  {
    stage: 'Contribuyendo',
    desc: 'Genera impacto directo en el campo.',
    items: ['Publicaciones', 'Fellowships', 'Roles en organizaciones de AI Safety'],
  },
];
---

<BaseLayout locale={locale} currentPage="programs" title="Programas | AI Safety Colombia">
  <section class="hero-mini">
    <div class="container">
      <h1 class="section-title">Programas</h1>
      <p class="page-desc">Nuestra pipeline de desarrollo te lleva desde la curiosidad inicial hasta contribuciones significativas al campo de la seguridad de IA.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="programs-list">
        {programs.map((prog, i) => (
          <div class="program-card card">
            <div class="program-header">
              <span class="program-num">{i + 1}</span>
              <h3>{prog.stage}</h3>
            </div>
            <p class="program-desc">{prog.desc}</p>
            <ul class="program-items">
              {prog.items.map(item => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-mini {
    padding: 9rem 1.5rem 3rem;
    text-align: center;
  }

  .page-desc {
    color: var(--text-secondary);
    font-size: 1.125rem;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .programs-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .program-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .program-num {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--accent-green);
    color: #0a0a0a;
    font-size: 0.875rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .program-header h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .program-desc {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .program-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .program-items li {
    color: var(--text-secondary);
    font-size: 0.875rem;
    padding-left: 1rem;
    position: relative;
  }

  .program-items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-green);
  }
</style>
