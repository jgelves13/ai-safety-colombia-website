---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ResourcesContent from '../components/ResourcesContent.astro';

const locale = 'es';
---

<BaseLayout locale={locale} currentPage="resources" title="Recursos | AI Safety Colombia">
  <PageHero
    title="Recursos"
    desc="Rutas de aprendizaje curadas para explorar la seguridad de IA desde distintos ángulos."
  />
  <ResourcesContent locale={locale} />
</BaseLayout>
