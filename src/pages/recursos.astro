---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ResourcesContent from '../components/ResourcesContent.astro';

const locale = 'es';
---

<BaseLayout locale={locale} currentPage="resources" title="Recursos | AI Safety Colombia">
  <PageHero
    title="Recursos"
    desc="Los mejores videos, lecturas, podcasts, libros y cursos para entender la seguridad de la IA, organizados por formato."
  />
  <ResourcesContent locale={locale} />
</BaseLayout>
