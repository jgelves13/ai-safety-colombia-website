---
import BaseLayout from '../layouts/BaseLayout.astro';

const locale = 'es';

const paths = [
  {
    title: 'Fundamentos de AI Safety',
    items: [
      { name: 'AGI Safety Fundamentals (BlueDot Impact)', url: 'https://aisafetyfundamentals.com/' },
      { name: 'Intro to AI Safety (Robert Miles)', url: 'https://www.youtube.com/@RobertMilesAI' },
      { name: 'The Alignment Problem (Brian Christian)', url: '#' },
    ],
  },
  {
    title: 'Investigacion tecnica',
    items: [
      { name: 'Alignment Forum', url: 'https://www.alignmentforum.org/' },
      { name: 'AI Safety Papers (Apart Research)', url: 'https://apartresearch.com' },
      { name: 'MIRI Research', url: 'https://intelligence.org/research/' },
    ],
  },
  {
    title: 'Gobernanza de IA',
    items: [
      { name: 'AI Governance Research (GovAI)', url: 'https://www.governance.ai/' },
      { name: 'CAIS Statement on AI Risk', url: 'https://www.safe.ai/statement-on-ai-risk' },
      { name: 'Colombia AI Framework', url: '#' },
    ],
  },
];
---

<BaseLayout locale={locale} currentPage="resources" title="Recursos | AI Safety Colombia">
  <section class="hero-mini">
    <div class="container">
      <h1 class="section-title">Recursos</h1>
      <p class="page-desc">Rutas de aprendizaje curadas para explorar la seguridad de IA desde distintos angulos.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="editorial">
        {paths.map((path, i) => (
          <div class={`editorial-row ${['is-green','is-coral','is-blue'][i]}`}>
            <div class="editorial-num">{`0${i + 1}`}</div>
            <div class="editorial-bar"></div>
            <div class="editorial-tx path-tx">
              <h3>{path.title}</h3>
              <ul>
                {path.items.map(item => (
                  <li>
                    <a href={item.url} target="_blank" rel="noopener noreferrer">{item.name}</a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-mini {
    padding: 9rem 1.5rem 3rem;
    text-align: center;
  }

  .page-desc {
    color: var(--text-secondary);
    font-size: 1.125rem;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.7;
  }


  .path-tx ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .path-tx li a {
    color: var(--green-text);
    font-size: 0.9375rem;
    transition: opacity 0.2s;
  }

  .path-tx li a:hover {
    opacity: 0.7;
  }
</style>
