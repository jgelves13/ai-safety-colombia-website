---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ResourcesContent from '../components/ResourcesContent.astro';

const locale = 'es';
---

<BaseLayout locale={locale} currentPage="resources" title="Recursos | AI Safety Colombia">
  <PageHero
    title="Recursos"
    desc="Videos, lecturas, podcasts, libros y cursos seleccionados para entender la seguridad de IA: desde los fundamentos hasta investigación de fondo."
  />
  <ResourcesContent locale={locale} />
</BaseLayout>
