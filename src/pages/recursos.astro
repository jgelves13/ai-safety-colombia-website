---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ResourcesContent from '../components/ResourcesContent.astro';

const locale = 'es';
---

<BaseLayout locale={locale} currentPage="resources" title="Recursos | AI Safety Colombia">
  <PageHero
    title="Recursos"
    desc="Lecturas, videos, podcasts, libros y cursos sobre seguridad de IA seleccionados por la comunidad. Cubre desde los fundamentos del campo hasta alineación técnica, gobernanza y evaluación de modelos."
  />
  <ResourcesContent locale={locale} />
</BaseLayout>
