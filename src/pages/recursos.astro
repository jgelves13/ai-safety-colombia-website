---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ResourcesContent from '../components/ResourcesContent.astro';

const locale = 'es';
---

<BaseLayout locale={locale} currentPage="resources" title="Recursos | AI Safety Colombia">
  <PageHero
    title="Recursos"
    desc="Una selección de cursos, lecturas e investigación para adentrarte en la seguridad de la inteligencia artificial."
  />
  <ResourcesContent locale={locale} />
</BaseLayout>
