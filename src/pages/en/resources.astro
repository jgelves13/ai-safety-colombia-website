---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ResourcesContent from '../../components/ResourcesContent.astro';

const locale = 'en';
---

<BaseLayout locale={locale} currentPage="resources" title="AI Safety Resources in Spanish & English | AI Safety Colombia" description="Readings, videos, podcasts, books, and courses on AI safety and alignment, in Spanish and English. Curated by AI Safety Colombia for the Global South.">
  <PageHero
    title="Resources"
    desc="Readings, videos, podcasts, books, and courses on AI safety curated by the community. Covers everything from foundations of the field to technical alignment, governance, and model evaluations."
  />
  <ResourcesContent locale={locale} />
</BaseLayout>
