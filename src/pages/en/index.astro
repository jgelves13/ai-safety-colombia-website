---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HackathonBanner from '../../components/HackathonBanner.astro';
import Hero from '../../components/Hero.astro';
import AboutAISafety from '../../components/AboutAISafety.astro';
import StartHere from '../../components/StartHere.astro';
import JourneyPipeline from '../../components/JourneyPipeline.astro';
import MetricsBar from '../../components/MetricsBar.astro';
import WhatWeDo from '../../components/WhatWeDo.astro';
import { t } from '../../i18n/ui';
import metricsData from '../../data/metrics.json';

const locale = 'en';
const metrics = metricsData.map((m) => ({
  value: m.value,
  label: t(locale, m.labelKey as Parameters<typeof t>[1]),
}));
---

<BaseLayout locale={locale} currentPage="index">
  <HackathonBanner locale={locale} />
  <Hero locale={locale} />

  <AboutAISafety locale={locale} />

  <WhatWeDo locale={locale} />

  <StartHere locale={locale} />

  <JourneyPipeline locale={locale} />

  <MetricsBar metrics={metrics} />

  <section class="section join-section" aria-labelledby="join-title">
    <div class="container">
      <div class="join-card">
        <div class="join-text">
          <h2 class="section-title" id="join-title">{t(locale, 'sections.join')}</h2>
          <p class="join-sub">{t(locale, 'join.subtitle')}</p>
        </div>
        <div class="join-links">
          <a href="https://chat.whatsapp.com/KwE8cciX48TAVhAOHnrLaZ" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            {t(locale, 'join.whatsapp')}
          </a>
          <a href="https://www.linkedin.com/company/ai-safety-colombia" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            LinkedIn
          </a>
          <a href="https://www.instagram.com/aisafetycolombia/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Instagram
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .join-card {
    background: linear-gradient(100deg, #eafff2, #e7f6ff);
    border: 1px solid #d5efe0;
    border-radius: 18px;
    padding: 2.25rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .join-card .section-title {
    margin-bottom: 0.375rem;
  }

  .join-sub {
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }

  .join-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
