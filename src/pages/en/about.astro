---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AboutContent from '../../components/AboutContent.astro';

const locale = 'en';
---

<BaseLayout
  locale={locale}
  currentPage="about"
  title="About AI Safety Colombia · AI Safety Community in LATAM"
  description="Colombian chapter focused on risks from advanced AI systems. Community, BlueDot-style training, and events on AI alignment and governance from the Global South."
>
  <PageHero
    title="About Us"
    desc="A Colombian chapter focused on the risks of advanced AI systems. Here we share who we are, how the group started, and the three levers that shape our work: community, learning, and events."
  />
  <AboutContent locale={locale} />
</BaseLayout>
