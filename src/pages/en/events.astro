---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventsPage from '../../components/EventsPage.astro';
import EventJsonLd from '../../components/EventJsonLd.astro';
import eventsData from '../../data/events.json';
import type { AisEvent } from '../../types';

const locale = 'en';
const events = eventsData as AisEvent[];
---

<BaseLayout
  locale={locale}
  currentPage="events"
  title="AI Safety Events in Bogotá | AI Safety Colombia"
  description="AI safety and alignment talks, panels, and workshops in Bogotá. Public events hosted by AI Safety Colombia for researchers, engineers, and students across LATAM."
>
  <EventJsonLd slot="head" events={events} locale={locale} />
  <EventsPage locale={locale} />
</BaseLayout>
