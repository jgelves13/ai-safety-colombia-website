---
import BaseLayout from '../layouts/BaseLayout.astro';
import HackathonContent from '../components/HackathonContent.astro';
import HackathonJsonLd from '../components/HackathonJsonLd.astro';
import PartnerStrip from '../components/PartnerStrip.astro';

const locale = 'es';
---

<BaseLayout locale={locale} currentPage="hackathon" title="Hackathon | AI Safety Colombia" description="Global South AI Safety Hackathon: 19-21 de junio de 2026, online y hub Bogotá. Organiza Apart Research; hub local AI Safety Colombia." ogImage="/og/hackathon.png">
  <HackathonJsonLd slot="head" locale={locale} />
  <HackathonContent locale={locale} />
  <PartnerStrip locale="es" />
</BaseLayout>
