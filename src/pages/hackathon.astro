---
import BaseLayout from '../layouts/BaseLayout.astro';
import HackathonBanner from '../components/HackathonBanner.astro';
import hackathonData from '../data/hackathon.json';

const locale = 'es';
---

<BaseLayout locale={locale} currentPage="hackathon" title="Hackathon | AI Safety Colombia">
  <section class="hero-mini">
    <div class="container">
      <h1 class="section-title">Global South AI Safety Hackathon</h1>
      <p class="hero-desc">Junio 19-21, 2026 | Bogota, Colombia</p>
      <p class="hero-sub">Organizado por Apart Research y AI Safety Colombia</p>
      <a href={hackathonData.registrationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        Registrate ahora &rarr;
      </a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Premios</h2>
      <div class="card prize-card">
        <p class="prize-amount">USD 1.000</p>
        <p class="prize-desc">{hackathonData.prizes.regionalEs}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Agenda</h2>
      <div class="schedule">
        {hackathonData.schedule.map(day => (
          <div class="schedule-day">
            <h3 class="day-title">{day.day}</h3>
            <div class="day-events">
              {day.events.map(event => (
                <div class="event-row">
                  <span class="event-time">{event.time}</span>
                  <span class="event-title">{event.title}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Speakers</h2>
      <div class="grid-3">
        {hackathonData.speakers.map(speaker => (
          <div class="card">
            <h3>{speaker.name}</h3>
            <p>{speaker.role} - {speaker.org}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-mini {
    padding: 9rem 1.5rem 4rem;
    text-align: center;
  }

  .hero-desc {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .hero-sub {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    margin-bottom: 1.5rem;
  }

  .prize-card {
    text-align: center;
    padding: 2.5rem;
  }

  .prize-amount {
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--accent-green);
    margin-bottom: 0.5rem;
  }

  .prize-desc {
    color: var(--text-secondary);
  }

  .schedule {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .day-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--accent-green);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .day-events {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .event-row {
    display: flex;
    gap: 1.5rem;
    align-items: baseline;
  }

  .event-time {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-red);
    min-width: 3.5rem;
  }

  .event-title {
    color: var(--text-primary);
    font-size: 0.9375rem;
  }
</style>
