---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventsPage from '../components/EventsPage.astro';
import EventJsonLd from '../components/EventJsonLd.astro';
import eventsData from '../data/events.json';
import type { AisEvent } from '../types';

const locale = 'es';
const events = eventsData as AisEvent[];
---

<BaseLayout
  locale={locale}
  currentPage="events"
  title="Eventos de AI Safety en Bogotá | AI Safety Colombia"
  description="Charlas, paneles y talleres sobre seguridad y alineación de IA en Bogotá. Eventos públicos de AI Safety Colombia para investigadores, ingenieros y estudiantes en LATAM."
>
  <EventJsonLd slot="head" events={events} locale={locale} />
  <EventsPage locale={locale} />
</BaseLayout>
