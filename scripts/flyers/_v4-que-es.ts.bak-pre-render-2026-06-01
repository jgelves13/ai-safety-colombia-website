  const padB = isPort ? 103 : 82;
  const padX = isPort ? 104 : 88;
  const kickerSz = isPort ? 22 : 19;
  const lead = isPort ? 28 : 26;
  const headlineSz = isPort ? 96 : 80;
  const body1 = isPort ? 27 : 25;
  const midSz = isPort ? 58 : 48;
  const body23 = isPort ? 26 : 24;
  const urlSz = isPort ? 16 : 14;
  const hostsFs = 22;
  const accentW = isPort ? 6 : 5;

  const hostsLogos = await getHostsLogosHD(hostsFs, { aiscBlack: true });

