import { render, html, BRAND, hostsRow, getHostsLogosHD } from './lib';
import type { FlyerFormat } from './_v3-apart';

export default async function (format: FlyerFormat = 'portrait') {
  const isPort = format === 'portrait';
  const W = 1080;
  const H = isPort ? 1350 : 1080;

  const padT = isPort ? 113 : 90;
  const padB = isPort ? 103 : 82;
  const padX = isPort ? 104 : 88;
  const headerGap = isPort ? 22 : 18;
  const kickerSz = isPort ? 22 : 19;
  const headingSz = isPort ? 70 : 58;
  const rowsGap = isPort ? 18 : 10;
  const rowPadV = isPort ? 28 : 20;
  const rowPadL = isPort ? 28 : 24;
  const rowPadR = isPort ? 30 : 26;
  const borderL = isPort ? 7 : 6;
  const titleSz = isPort ? 34 : 30;
  const descSz = isPort ? 17 : 15.5;
  const subSz = isPort ? 16.5 : 15;
  const subDot = isPort ? 8 : 7;
  const urlSz = isPort ? 16 : 14;
  const hostsFs = 22;

  const hostsLogos = await getHostsLogosHD(hostsFs, { aiscBlack: true });
  const FOREST = BRAND.forest;

  const tracks = [
    { accent: BRAND.forest, tint: '#1F4D3211', title: 'Technical AI Safety',
      desc: 'Entender y verificar cómo se comportan los modelos por dentro: cómo evalúan, planean y actúan los sistemas agénticos, y cómo inspeccionar lo que aprenden.',
      subs: ['Evaluaciones para sistemas agénticos', 'Interpretabilidad mecanicista'] },
    { accent: BRAND.coral,  tint: '#E5604D14', title: 'AI Security',
      desc: 'Proteger los sistemas de IA frente a abuso y ataques: asegurar pipelines de despliegue, resistir inyección de prompts y jailbreaks, y mantener el control sobre modelos capaces.',
      subs: ['Seguridad de pipelines (API/Cloud)', 'Inyección de prompts y jailbreaks', 'Control de IA'] },
    { accent: BRAND.sage,   tint: '#4A846614', title: 'IA Responsable',
      desc: 'Reducir daños en el uso real: mitigar alucinaciones, auditar el comportamiento de los modelos en distintos idiomas y culturas, y evaluar su impacto social.',
      subs: ['Mitigación de alucinaciones', 'Auditoría de comportamiento (multilingüe, intercultural)', 'Evaluación de impacto social'] },
    { accent: BRAND.yellow, tint: '#F2B7051F', title: 'Gobernanza de IA',
      desc: 'Las reglas e instituciones que guían a la IA: análisis de política y regulación, auditoría y rendición de cuentas, monitoreo del ecosistema y armas autónomas letales.',
      subs: ['Análisis de política y regulación de IA', 'Auditoría y rendición de cuentas de sistemas', 'Monitoreo del ecosistema', 'Sistemas de armas autónomas letales'] },
  ];

  const row = (t: typeof tracks[number]) => `
    <div style="display:flex;background:${t.tint};padding:${rowPadV}px ${rowPadR}px ${rowPadV}px ${rowPadL}px;gap:32px;align-items:flex-start;border-left:${borderL}px solid ${t.accent}">
      <div style="display:flex;flex-direction:column;width:460px;gap:8px">
        <div style="display:flex;font-family:Bricolage Grotesque;font-weight:700;font-size:${titleSz}px;line-height:1.05;letter-spacing:-0.015em;color:${FOREST}">${t.title}</div>
        <div style="display:flex;font-family:Inter;font-weight:500;font-size:${descSz}px;line-height:1.4;color:${BRAND.ink}">${t.desc}</div>
      </div>
      <div style="display:flex;flex-direction:column;flex:1;gap:10px;padding-top:8px">
        ${t.subs.map(s => `<div style="display:flex;align-items:center;gap:12px"><div style="display:flex;width:${subDot}px;height:${subDot}px;border-radius:50%;background:${t.accent};flex-shrink:0"></div><div style="display:flex;font-family:Inter;font-weight:500;font-size:${subSz}px;line-height:1.3;color:${BRAND.ink}">${s}</div></div>`).join('')}
      </div>
    </div>`;

  const source = `
    <div style="display:flex;width:${W}px;height:${H}px;background:${BRAND.cream};font-family:Inter;position:relative;overflow:hidden">

      <div style="display:flex;flex-direction:column;width:${W}px;height:${H}px;padding:${padT}px ${padX}px ${padB}px ${padX}px;justify-content:space-between">

        <div style="display:flex;flex-direction:column;gap:${headerGap}px;max-width:920px">
          <div style="display:flex;font-family:JetBrains Mono;font-weight:500;font-size:${kickerSz}px;letter-spacing:0.2em;color:${FOREST};text-transform:uppercase">Tracks</div>
          <div style="display:flex;font-family:Bricolage Grotesque;font-weight:700;font-size:${headingSz}px;line-height:1.0;letter-spacing:-0.024em;color:${FOREST}">Cuatro frentes para cerrar la brecha.</div>
        </div>

        <div style="display:flex;flex-direction:column;gap:${rowsGap}px">
          ${tracks.map(row).join('')}
        </div>

        <div style="display:flex;align-items:center;justify-content:space-between">
          <div style="display:flex;font-family:JetBrains Mono;font-weight:500;font-size:${urlSz}px;letter-spacing:0.04em;color:${BRAND.ink2}">aisafetycolombia.org/hackathon</div>
          ${hostsRow({ color: BRAND.ink2, fontSize: hostsFs, ...hostsLogos })}
        </div>

      </div>

    </div>
  `;

  const png = await render(html(source), W, H);
  return { filename: `_v4-03-tracks-${format}.png`, png };
}
